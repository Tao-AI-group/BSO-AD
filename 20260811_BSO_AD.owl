        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010485</IRI>
        <Literal>Olfactory_Bulb</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
