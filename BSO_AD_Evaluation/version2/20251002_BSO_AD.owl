        <rdfs:label>Sp1_Transcription_Factor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sphingosine-1-phosphate_lyase_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sphingosine-1-phosphate_lyase_1">
