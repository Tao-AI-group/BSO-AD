    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Entopeduncular_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Entopeduncular_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamus"/>
        <untitled-ontology-107:Definition>A portion of the nucleus of ansa lenticularis located medial to the posterior limb of the internal capsule, along the course of the ansa lenticularis and the inferior thalamic peduncle or as a separate nucleus within the internal capsule adjacent to the medial GLOBUS PALLIDUS (NeuroNames, http://rprcsgi.rprc. washington.edu/neuronames/ (September 28, 1998)). In non-primates, the entopeduncular nucleus is analogous to both the medial globus pallidus and the entopeduncular nucleus of human.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020392</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entopeduncular_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Entorhinal_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Entorhinal_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parahippocampal_gyrus"/>
        <untitled-ontology-107:Definition>Cerebral cortex region on the medial aspect of the PARAHIPPOCAMPAL GYRUS, immediately caudal to the OLFACTORY CORTEX of the uncus. The entorhinal cortex is the origin of the major neural fiber system afferent to the HIPPOCAMPAL FORMATION, the so-called PERFORANT PATHWAY.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D018728</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entorhinal_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Ependyma -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Ependyma">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
        <untitled-ontology-107:Definition>A thin membrane that lines the CEREBRAL VENTRICLES and the central canal of the SPINAL CORD.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D004805</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ependyma</rdfs:label>
    </owl:Class>
    


