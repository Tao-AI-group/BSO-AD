<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Raphe_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pontine_tegmentum"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Collections of small neurons centrally scattered among many fibers from the level of the TROCHLEAR NUCLEUS in the midbrain to the hypoglossal area in the MEDULLA OBLONGATA.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D011903</unti:MeSH_Unique_ID>
