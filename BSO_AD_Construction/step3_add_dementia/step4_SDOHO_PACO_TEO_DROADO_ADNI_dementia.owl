  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolic_Brain_Diseases</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolic_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior of the three primitive cerebral vesicles of an embryonic brain. It consists of myelencephalon, metencephalon, and isthmus rhombencephali from which develop the major BRAIN STEM components, such as MEDULLA OBLONGATA from the myelencephalon, CEREBELLUM and PONS from the metencephalon, with the expanded cavity forming the FOURTH VENTRICLE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D012249</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rhombencephalon</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Methyl-cpg_binding_domain_protein_3">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methyl-cpg_Binding_Domain_Protein_3</rdfs:label>
</owl:Class>

