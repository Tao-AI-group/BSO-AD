        <rdfs:comment>Errors occurring when the participant connects two circles in the incorrect sequence</rdfs:comment>
        <rdfs:label>NB_Trail_Making_Test_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NB_TrailMakingTestBItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NB_TrailMakingTestBItem_2">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NeuropsychologicalBatteryItem"/>
        <rdfs:comment>Errors occurring because the participant failed to draw a connecting line to a given circle in the correct sequence</rdfs:comment>
        <rdfs:label>NB_Trail_Making_Test_Item_2</rdfs:label>
