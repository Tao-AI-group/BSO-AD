        <rdfs:label>Ret_Proto-oncogene</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Reticular_formation -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Reticular_formation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
        <untitled-ontology-107:Definition>A region extending from the PONS &amp; MEDULLA OBLONGATA through the MESENCEPHALON, characterized by a diversity of neurons of various sizes and shapes, arranged in different aggregations and enmeshed in a complicated fiber network.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D012154</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Reticular_Formation</rdfs:label>
