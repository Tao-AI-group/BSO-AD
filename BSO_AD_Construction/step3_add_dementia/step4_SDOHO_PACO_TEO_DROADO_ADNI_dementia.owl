</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000021">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">New_Year's_Day</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Celebrates beginning of the Gregorian calendar year. Festivities include counting down to midnight (12:00 AM) on the preceding night, New Year's Eve. Traditional end of holiday season.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000042">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The first day of a calendar week starting from Monday. Monday is after Sunday and before Tuesday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000095"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Week_Day</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The parent class of the 7 week days</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000043">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tuesday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The second day of a calendar week starting from Monday. Tuesday is after Monday and before Wednesday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000045">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wednesday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thrid day of a calendar week starting from Monday.  Wednesday is after Tuesday and before Thursday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000046">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thursday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fourth day of a calendar week starting from Monday. Thursday is after Wednesday and before Friday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000047">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Friday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fifth day of a calendar week starting from Monday. Friday is after Thursday and before Saturday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000048">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Saturday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sixth day of a calendar week starting from Monday. Saturday is after Friday and before Sunday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000049">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sunday</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The last day of a calendar week starting from Monday. Sunday is after Saturday and before the Monday next week.</core:definition>
</owl:Class>

