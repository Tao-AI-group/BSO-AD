        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
        <untitled-ontology-107:Definition>Cholinergic bundle of nerve fibers posterior to the anterior perforated substance. It interconnects the paraterminal gyrus in the septal area with the hippocampus and lateral olfactory area.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020667</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diagonal_Band_of_Broca</rdfs:label>
