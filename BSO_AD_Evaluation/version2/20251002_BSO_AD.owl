    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Platelet_activating_factor_acetylhydrolase_1b_catalytic_subunit_3">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Platelet_Activating_Factor_Acetylhydrolase_1b_Catalytic_Subunit_3</rdfs:label>
    </owl:Class>
    


