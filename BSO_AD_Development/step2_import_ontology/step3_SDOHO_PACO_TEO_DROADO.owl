        <untitled-ontology-107:MeSH_Unique_ID>D008125</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Locus_Coeruleus</rdfs:label>
