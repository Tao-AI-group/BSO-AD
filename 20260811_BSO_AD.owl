        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#06010595</IRI>
        <Literal>Alzheimer_Disease_Type_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#06010595</IRI>
        <Literal>Alzheimer&apos;s disease caused by mutation(s) in the APP gene, encoding amyloid-beta A4 protein. The onset of this condition typically occurs before age 65.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#06010595</IRI>
