        <untitled-ontology-107:Entry_Term>Early-onset familial form of Alzheimer disease; Alzheimer disease 1</untitled-ontology-107:Entry_Term>
        <untitled-ontology-107:MeSH_Unique_ID>C536594</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Alzheimer_Disease_Type_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
        <untitled-ontology-107:Entry_Term>Late onset familial Alzheimer disease; Alzheimer Disease 2, Late-Onset; Alzheimer Disease Associated With Apoe4; Alzheimer disease associated with APOE E4; Alzheimer Disease 2</untitled-ontology-107:Entry_Term>
        <untitled-ontology-107:MeSH_Unique_ID>C536595</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Alzheimer_Disease_Type_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_4 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_4">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
        <untitled-ontology-107:Entry_Term>Alzheimer Disease, Familial, 4; Alzheimer disease 4; Alzheimer disease, familial, type 4</untitled-ontology-107:Entry_Term>
        <untitled-ontology-107:MeSH_Unique_ID>C536596</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Alzheimer_Disease_Type_4</rdfs:label>
    </owl:Class>
    


