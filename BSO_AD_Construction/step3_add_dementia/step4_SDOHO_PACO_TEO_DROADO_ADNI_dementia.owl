  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An absence of excessive economic fluctuations which allows people the ability to access resources. (https://www.ruralhealthinfo.org/toolkits/sdoh/2/economic-stability/index#:~:text=Economic%20stability%20allows%20people%20the,provides%20a%20stable%2C%20living%20wage.&amp;text=Income%2Fpoverty%20and%20financial%20resources) (MSH)

 https://uts.nlm.nih.gov/uts/umls/concept/C0681033</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0681033</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantitative Concept</UMLS_Semantic_Type>
</owl:Class>

<owl:Class rdf:about="#00073">
  <rdfs:subClassOf rdf:resource="#00072"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cdn.loinc.org/wp-content/uploads/2017/11/Screen-Shot-2017-11-06-at-10.42.00-AM.png?iv=608</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://health.gov/healthypeople/objectives-and-data/social-determinants-health</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.healthypeople.gov/2020/topics-objectives/topic/social-determinants-of-health</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.kff.org/racial-equity-and-health-policy/issue-brief/beyond-health-care-the-role-of-social-determinants-in-promoting-health-and-health-equity/</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.ruralhealthinfo.org/toolkits/sdoh/1/definition</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Element_Relevant_to_Employment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The state of being engaged in an activity or service for wages or salary. (MSH)
 The state of being engaged in an activity or service for wages or salary; the occupation for which you are paid. (NCI)
 The state of being engaged in an activity or services for wages or salary. (NCI)
 Occupation that provides income. (OMS)

 https://uts.nlm.nih.gov/uts/umls/concept/C0014003</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0014003</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualitative Concept</UMLS_Semantic_Type>
</owl:Class>

<owl:Class rdf:about="#00074">
  <rdfs:subClassOf rdf:resource="#00073"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">67875-5</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Can't_Find_Wanted_Job
 Has_A_Job
 Unemployed_or_No_Regular_Income</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://loinc.org/LG41763-0/</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.questionpro.com/blog/demographic-survey-questions/</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://www.who.int/health-topics/social-determinants-of-health#tab=tab_1</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Employment_Status</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Terminology relevant to the state of being engaged in an activity or service for wages or salary. (NCI)
 Terminology associated with the employment status codelist of the Clinical Data Interchange Standards Consortium (CDISC) Study Data Tabulation Model (SDTM). (NCI)
 Condition of employment including full- or part-time, temporary or permanent, and unemployment. (PSY)

 https://uts.nlm.nih.gov/uts/umls/concept/C0242271</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0242271</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
</owl:Class>

<owl:Class rdf:about="#00075">
  <rdfs:subClassOf rdf:resource="#00074"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full_Time_Employment</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Employment involving the standard or customary working time. (NCI)
 Employed for a standard number of hours of working time, at least 50% or 20 hours per week. (NCI)
 Employed for a standard number of hours of working time, at least 50% or 20 h/wk. (NCI)
 Employment in which the employee is expected to work at least a standard work week (defined by the US Bureau of Labor Statistics as 35-44 hours per week)

 (HL7V3.0)

 https://uts.nlm.nih.gov/uts/umls/concept/C0682295</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0682295</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
</owl:Class>

<owl:Class rdf:about="#00076">
