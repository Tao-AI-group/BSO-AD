    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="unti:MeSH_Unique_ID"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010492</IRI>
        <Literal>D001099</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
