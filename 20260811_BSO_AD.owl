        <Literal>C0175219</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="unti:MeSH_Unique_ID"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010416</IRI>
        <Literal>D066276</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010416</IRI>
        <Literal>Corticomedial_Nuclear_Complex</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
