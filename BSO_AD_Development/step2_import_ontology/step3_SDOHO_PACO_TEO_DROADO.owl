        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sexual attraction or relationship between females. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0242659</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0242659</UMLS_CUI>
