<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Impaired_communication">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cognitive_dysfunction"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Trouble following or joining conversation; may stop in the middle of one and have no idea how to continue or repeat themselves; may struggle with vocabulary, finding the right word, and calling things by the wrong name</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Impaired_Communication</rdfs:label>
</owl:Class>

