    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hydrocephalus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hydrocephalus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathology"/>
        <untitled-ontology-107:Definition>Excessive accumulation of cerebrospinal fluid within the cranium which may be associated with dilation of cerebral ventricles, INTRACRANIAL HYPERTENSION; HEADACHE; lethargy; URINARY INCONTINENCE; and ATAXIA.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D006849</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hydrocephalus</rdfs:label>
    </owl:Class>
    


