<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intermediate_pituitary_gland">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The intermediate lobe of the pituitary gland. It shows considerable size variation among the species, small in humans, and large in amphibians and lower vertebrates. This lobe produces mainly MELANOCYTE-STIMULATING HORMONES and other peptides from post-translational processing of pro-opiomelanocortin (POMC).</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D052716</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pituitary gland, intermediate</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermediate_Pituitary_Gland</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Internal_capsule">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WHITE MATTER pathway, flanked by nuclear masses, consisting of both afferent and efferent fibers projecting between the WHITE MATTER and the BRAINSTEM. It consists of three distinct parts: an anterior limb, posterior limb, and genu.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020772</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internal_Capsule</rdfs:label>
</owl:Class>

