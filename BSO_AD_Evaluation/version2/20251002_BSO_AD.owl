                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have periods of tearfulness or sobbing that seem to indicate sadness?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_2 -->

