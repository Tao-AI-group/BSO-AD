    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mammillary_body -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mammillary_body">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Posterior_hypothalamus"/>
        <untitled-ontology-107:Definition>A pair of nuclei and associated GRAY MATTER in the interpeduncular space rostral to the posterior perforated substance in the POSTERIOR HYPOTHALAMUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008326</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Mammillary_Body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Matrix_metallopeptidase_17 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Matrix_metallopeptidase_17">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Matrix_Metallopeptidase_17</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Median_eminence -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Median_eminence">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamo-hypophyseal_system"/>
        <untitled-ontology-107:Definition>Raised area at the infundibular region of the HYPOTHALAMUS at the floor of the BRAIN, ventral to the THIRD VENTRICLE and adjacent to the ARCUATE NUCLEUS OF HYPOTHALAMUS. It contains the terminals of hypothalamic neurons and the capillary network of hypophyseal portal system, thus serving as a neuroendocrine link between the brain and the PITUITARY GLAND.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008473</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Median_Eminence</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mediodorsal_thalamic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mediodorsal_thalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
        <untitled-ontology-107:Definition>The largest of the medial nuclei of the thalamus. It makes extensive connections with most of the other thalamic nuclei.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020645</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Mediodorsal_Thalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Myelencephalon"/>
        <untitled-ontology-107:Definition>The lower portion of the BRAIN STEM. It is inferior to the PONS and anterior to the CEREBELLUM. Medulla oblongata serves as a relay station between the brain and the spinal cord, and contains centers for regulating respiratory, vasomotor, cardiac, and reflex activities.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008526</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Medulla_Oblongata</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Melanotroph -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Melanotroph">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intermediate_pituitary_gland"/>
        <untitled-ontology-107:Definition>Neuroendocrine cells in the INTERMEDIATE LOBE OF PITUITARY. They produce MELANOCYTE STIMULATING HORMONES and other peptides from the post-translational processing of pro-opiomelanocortin (POMC).</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052717</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Melanotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memantine -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memantine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amantadine"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#NMDA_receptor_antagonist"/>
        <untitled-ontology-107:BrandName>Namenda</untitled-ontology-107:BrandName>
        <untitled-ontology-107:Description>Memantine might provide some benefit for patients with moderate-to-severe dementia, either as monotherapy or in combination with a cholinesterase inhibitor.</untitled-ontology-107:Description>
        <rdfs:label>Memantine</rdfs:label>
    </owl:Class>
    


