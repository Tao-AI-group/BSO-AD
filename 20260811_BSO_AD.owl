        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010398</IRI>
        <Literal>Three nuclei located beneath the dorsal surface of the most rostral part of the thalamus. The group includes the anterodorsal nucleus, anteromedial nucleus, and anteroventral nucleus. All receive connections from the MAMILLARY BODY and BRAIN FORNIX, and project fibers to the CINGULATE BODY.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#UMLS_CUI"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010398</IRI>
        <Literal>C0175276</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="unti:MeSH_Unique_ID"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010399</IRI>
        <Literal>D005829</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010399</IRI>
        <Literal>Geniculate_Body</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010399</IRI>
        <Literal>Part of the DIENCEPHALON inferior to the caudal end of the dorsal THALAMUS. Includes the lateral geniculate body which relays visual impulses from the OPTIC TRACT to the calcarine cortex, and the medial geniculate body which relays auditory impulses from the lateral lemniscus to the AUDITORY CORTEX.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010399</IRI>
        <Literal>Geniculate body</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#UMLS_CUI"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010399</IRI>
        <Literal>C0017405</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
