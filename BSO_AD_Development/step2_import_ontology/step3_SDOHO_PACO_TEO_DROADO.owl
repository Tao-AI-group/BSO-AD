        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Septin_10</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Septin_11 -->

