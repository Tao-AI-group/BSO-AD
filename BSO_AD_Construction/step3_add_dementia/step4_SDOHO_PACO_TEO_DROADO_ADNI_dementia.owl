      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient describe hearing voices or act as if he/she hears voices?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_2">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient talk to people who are not there?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_3">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient describe seeing things not seen by others or behave as if he/she is seeing things not seen by others (people, animals, lights, etc.)?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_4">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient report smelling odors not smelled by others?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_5">
