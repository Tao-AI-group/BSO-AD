    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plectin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Plectin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pleiotrophin -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pleiotrophin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Pleiotrophin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plexin_A1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plexin_A1">
