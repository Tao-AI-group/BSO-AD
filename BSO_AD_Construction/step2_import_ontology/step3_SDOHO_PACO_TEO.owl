    <!-- http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Boogieboarding -->

    <owl:Class rdf:about="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Boogieboarding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Exercise_leisure_activity"/>
        <rdfs:subClassOf>
