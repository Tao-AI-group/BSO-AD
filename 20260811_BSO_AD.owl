        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010424</IRI>
        <Literal>The largest and most lateral of the BASAL GANGLIA lying between the lateral medullary lamina of the GLOBUS PALLIDUS and the EXTERNAL CAPSULE. It is part of the neostriatum and forms part of the LENTIFORM NUCLEUS along with the GLOBUS PALLIDUS.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
