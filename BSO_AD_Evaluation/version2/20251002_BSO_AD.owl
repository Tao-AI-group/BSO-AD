        <rdfs:label>Amblyopia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aminoadipate_aminotransferase -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aminoadipate_aminotransferase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Aminoadipate_Aminotransferase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
        <untitled-ontology-107:Definition>Almond-shaped group of basal nuclei anterior to the INFERIOR HORN OF THE LATERAL VENTRICLE of the TEMPORAL LOBE. The amygdala is part of the limbic system.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000679</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Amygdala</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_deposition -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_deposition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology"/>
        <untitled-ontology-107:Description>Aβ protein deposition within the CNS is the primary cause of AD and an early critical event that promotes downstream features of the disease, such as NFT formation and synaptic injury and loss, leading to progressive dementia. 

https://doi.org/10.1146/annurev-pathol-020712-163927</untitled-ontology-107:Description>
        <untitled-ontology-107:UMLS_CUI>C0011560</untitled-ontology-107:UMLS_CUI>
        <rdfs:label>Amyloid_Deposition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Microscopic_lesion"/>
        <rdfs:label>Amyloid_Pathology</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_plaque -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_plaque">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology"/>
        <untitled-ontology-107:Definition>Plaques consist of amyloid deposits surrounded by a web of astrocytic processes, swollen neurites, and neuron terminals; seen in the cerebral cortex in Alzheimer&apos;s disease.

From CSP</untitled-ontology-107:Definition>
        <untitled-ontology-107:Description>One study has shown that SPs vary in size among both AD patients and normal elderly individuals; larger size distributions correlated with an earlier age of disease onset. SPs did not, however, appear to increase significantly in size over the clinical course of the disease.

https://doi.org/10.1146/annurev-pathol-020712-163927</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D058225</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Senile plaque; neuritic plaque</untitled-ontology-107:Synonym>
        <untitled-ontology-107:UMLS_CUI>C0333463</untitled-ontology-107:UMLS_CUI>
        <rdfs:label>Amyloid_Plaque</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anatomical_part -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anatomical_part">
        <rdfs:label>Anatomical_Part</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Angiotensin_I_converting_enzyme -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Angiotensin_I_converting_enzyme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Angiotensin_I_Converting_Enzyme</rdfs:label>
    </owl:Class>
    


