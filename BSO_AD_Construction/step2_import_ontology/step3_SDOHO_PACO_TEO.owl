        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unemployment</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The state of not being engaged in a gainful occupation. (MSH)
 The state of not having a job. (NCI)
 Persons who currently have no employment, but are available for work and have made specific efforts to find employment.

 (HL7V3.0)
 Indication of unemployed status.

 (HL7V3.0)

 https://uts.nlm.nih.gov/uts/umls/concept/C0041674</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0041674</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
    </owl:Class>
    


