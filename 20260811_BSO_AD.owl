        <Literal>Set of nerve fibers that cross the midline of the TELENCEPHALON. They include the ANTERIOR COMMISSURE; the CORPUS CALLOSUM; and the HIPPOCAMPAL COMMISSURE of the fornix.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010486</IRI>
        <Literal>Telencephalic Commissure</Literal>
