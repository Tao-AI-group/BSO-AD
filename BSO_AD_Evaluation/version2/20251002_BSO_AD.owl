    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum"/>
        <untitled-ontology-107:Definition>Large subcortical nuclear masses derived from the telencephalon and located in the basal regions of the cerebral hemispheres.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001479</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Basal_Ganglia</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia_Diseases -->

