        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Job_Insecurity</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An individual&apos;s concern about the continued existence of their job in the future. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C5400931</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C5400931</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00149 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00149">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00144"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lack_of_Transportation_for_Daily_Living</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lack of Reliable Transportation Keeps from Appointments, Meetings, Work, or Daily Living</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A question about whether an individual was unable to get to medical appointments, meetings, work, or getting things needed for daily living due to lack of reliable transportation. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C5204661</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C5204661</UMLS_CUI>
