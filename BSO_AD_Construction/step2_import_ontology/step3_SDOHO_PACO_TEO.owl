    <!-- https://github.com/Tao-AI-group/BSO_AD#00084 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00084">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00073"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://gss.norc.org/documents/codebook/GSS_Codebook_AppendixF.pdf</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://loinc.org/LG41763-0/</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occupation</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occupations</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crafts, trades, professions, or other means of earning a living. (MSH)
 The principal activity that a person does to earn money. (NCI)
 A code specifying the job performed by the employee for the employer. For example, accountant, programmer analyst, patient care associate, staff nurse, etc. (NCI)
 Conceptually broad term referring to work specialties as defined by duties and required skills. Use a more specific term if possible. (PSY)
 Crafts, trades, professions, or other means of earning a living. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0028811</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0028811</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Occupation or Discipline</UMLS_Semantic_Type>
    </owl:Class>
    


