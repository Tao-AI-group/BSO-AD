<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Infections">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Central_Nervous_System_Infections</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_amygdaloid_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nucleus located in the caudal half of the amygdala. It is a primary region involved in controlling responses and receives many intrinsic GABAergic amygdaloid connections.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066274</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Central_Amygdaloid_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_Diseases">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellar_Diseases</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The superficial GRAY MATTER of the CEREBELLUM. It consists of two main layers, the stratum moleculare and the stratum granulosum.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002525</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellar_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The part of brain that lies behind the BRAIN STEM in the posterior base of skull (CRANIAL FOSSA, POSTERIOR). It is also known as the "little brain" with convolutions similar to those of CEREBRAL CORTEX, inner white matter, and deep cerebellar nuclei. Its function is to coordinate voluntary movements, maintain balance, and learn motor skills.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002531</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellum</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_nuclei">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Four clusters of neurons located deep within the WHITE MATTER of the CEREBELLUM, which are the nucleus dentatus, nucleus emboliformis, nucleus globosus, and nucleus fastigii.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002529</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellar_Nuclei</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_vermis">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Purkinje_cell"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A subregion of the CEREBELLAR CORTEX, located along the midsagittal plane of the CEREBELLUM.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065814</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellar_Vermis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Purkinje_cell">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The output neurons of the cerebellar cortex.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D011689</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Purkinje_Cell</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellopontine_angle">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Junction between the cerebellum and the pons.</unti:Definition>
  <unti:Location rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002530</unti:Location>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebellopontine_Angle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The anterior portion of the developing hindbrain. It gives rise to the CEREBELLUM and the PONS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020540</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metencephalon</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The front part of the hindbrain (RHOMBENCEPHALON) that lies between the MEDULLA and the midbrain (MESENCEPHALON) ventral to the cerebellum. It is composed of two parts, the dorsal and the ventral. The pons serves as a relay station for neural pathways between the CEREBELLUM to the CEREBRUM.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D011149</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pons</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thin layer of GRAY MATTER on the surface of the CEREBRAL HEMISPHERES that develops from the TELENCEPHALON and folds into gyri and sulchi. It reaches its highest development in humans and is responsible for intellectual faculties and higher mental functions.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002540</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_amyloid_angiopathy">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A heterogeneous group of sporadic or familial disorders characterized by AMYLOID deposits in the walls of small and medium sized blood vessels of CEREBRAL CORTEX and MENINGES. Clinical features include multiple, small lobar CEREBRAL HEMORRHAGE; cerebral ischemia (BRAIN ISCHEMIA); and CEREBRAL INFARCTION. Cerebral amyloid angiopathy is unrelated to generalized AMYLOIDOSIS. Amyloidogenic peptides in this condition are nearly always the same ones found in ALZHEIMER DISEASE. (from Kumar: Robbins and Cotran: Pathologic Basis of Disease, 7th ed., 2005)

From MSH</unti:Definition>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAA is less prominently featured (than SPs and NFTs) when considering AD neuropathologic lesions in part because it is variable in severity among AD patients, though when sought diligently it is identified in an estimated 85–95% of AD brains. CAA results from a process whereby the media of parenchymal arterioles, normally composed of smooth muscle cells (SMCs), undergoes progressive loss of these SMCs and simultaneous accumulation of an eosinophilic hyaline material that has the staining properties of amyloid, that is, positivity for thioflavin S or T and congophilia, with the characteristic yellow-green birefringence (of the congophilic material) when a brain section is viewed under polarized light.

https://doi.org/10.1146/annurev-pathol-020712-163927</unti:Description>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAA</unti:Synonym>
  <unti:UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0085220</unti:UMLS_CUI>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Amyloid_Angiopathy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_aqueduct">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Narrow channel in the MESENCEPHALON that connects the third and fourth CEREBRAL VENTRICLES.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002535</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Aqueduct</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Four CSF-filled (see CEREBROSPINAL FLUID) cavities within the cerebral hemispheres (LATERAL VENTRICLES), in the midline (THIRD VENTRICLE) and within the PONS and MEDULLA OBLONGATA (FOURTH VENTRICLE).</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002552</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Ventricle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of midbrain situated under the dorsal TECTUM MESENCEPHALI. The two ventrolateral cylindrical masses or peduncles are large nerve fiber bundles providing a tract of passage between the FOREBRAIN with the HINDBRAIN. Ventral MIDBRAIN also contains three colorful structures: the GRAY MATTER (PERIAQUEDUCTAL GRAY), the black substance (SUBSTANTIA NIGRA), and the RED NUCLEUS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013681</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tegmentum_Mesencephali</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_cortical_atrophy">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathology"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Atrophy of the cortex of the cerebrum.

From HPO</unti:Definition>
  <unti:UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C4551583</unti:UMLS_CUI>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Cortical_Atrophy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_crus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior portion of the cerebral peduncle which contains the motor tracts.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065843</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Crus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ventral portion of the mesencephalon including the MIDBRAIN TEGMENTUM; CRUS CEREBRI; and the PRETECTUM. It does not include tectum mesencephali and TROCHLEAR NERVE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065850</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Peduncle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_endothelial_cell_adhesion_molecule">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebral_Endothelial_Cell_Adhesion_Molecule</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The middle of the three primitive cerebral vesicles of the embryonic brain. Without further subdivision, midbrain develops into a short, constricted portion connecting the PONS and the DIENCEPHALON. Midbrain contains two major parts, the dorsal TECTUM MESENCEPHALI and the ventral TEGMENTUM MESENCEPHALI, housing components of auditory, visual, and other sensorimoter systems.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D008636</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mesencephalon</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrovascular_Disorders">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cerebrovascular_Disorders</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Prosencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The anterior subdivision of the embryonic PROSENCEPHALON or the corresponding part of the adult prosencephalon that includes the cerebrum and associated structures.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013687</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Telencephalon</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cervical_cord">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The segment of the spinal cord within the CERVICAL VERTEBRAE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066193</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cervical_Cord</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cylindrical column of tissue that lies within the vertebral canal. It is composed of WHITE MATTER and GRAY MATTER.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013116</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Cord</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Change_in_episodic_memory">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Short-term_memory_impairment"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amnestic syndrome: free and cued recall abilities impaired; remembering new information becomes difficult</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Change_in_Episodic_Memory</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Short-term_memory_impairment">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memory_impairment"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Forgetting recent conversations, names, events, and important dates; asking for the same information repeatedly; increased reliance on memory aids</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Short-term_Memory_Impairment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chaperonin_containing_TCP1_subunit_6B">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chaperonin_Containing_TCP1_Subunit_6B</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chloride_intracellular_channel_1">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chloride_Intracellular_Channel_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cholesteryl_ester_transfer_protein">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cholesteryl_Ester_Transfer_Protein</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cholinesterase_inhibitor">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neurotransmitter_based_drug"/>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acetylcholinesterase inhibitors</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cholinesterase_Inhibitor</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neurotransmitter_based_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neurotransmitter_Based_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chondroadherin_like">
