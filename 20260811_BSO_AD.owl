    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#07020980</IRI>
        <Literal>Social_Environment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
