        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Conflict</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00384 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00384">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00381"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Disorder</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00385 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00385">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00381"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Integration</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dynamic and principled process where all members participate in dialogue to achieve and maintain peaceful social relations. It does not include coerced assimilation or forced integration. (from https://www.un.org/esa/socdev/sib/peacedialogue/soc_integration.htm) (MSH)
 Process of uniting diverse groups (e.g., racial, ethnic, religious, or disabled) of a society or organization. (PSY)
 Incorporation as equals into society or an organization of individuals of different groups. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0597478</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0597478</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00386 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00386">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00381"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Justice</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An interactive process whereby members of a community are concerned for the equality and rights of all. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037422</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0037422</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualitative Concept</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00387 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00387">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00381"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Vulnerability</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The characteristics of a person or community that affect their capacity to anticipate, confront, repair, and recover from the effects of a natural or human-caused disaster.(https://www.ncbi.nlm.nih.gov/pmc/articles/PMC71 79070/) (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C4063051</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C4063051</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
    </owl:Class>
    


