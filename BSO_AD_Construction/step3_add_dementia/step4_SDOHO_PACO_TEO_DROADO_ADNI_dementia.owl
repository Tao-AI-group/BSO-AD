  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Epilepsy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Epithalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The dorsal posterior subdivision of the diencephalon. The epithalamus is generally considered to include the habenular nuclei (HABENULA) and associated fiber bundles, the PINEAL BODY, and the epithelial roof of the third ventricle. The anterior and posterior paraventricular nuclei of the thalamus are included with the THALAMIC NUCLEI although they develop from the same pronuclear mass as the epithalamic nuclei and are sometimes considered part of the epithalamus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D019261</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Epithalamus</rdfs:label>
</owl:Class>

