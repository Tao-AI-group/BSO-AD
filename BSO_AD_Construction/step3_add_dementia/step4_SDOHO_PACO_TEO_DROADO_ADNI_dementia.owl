  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Incontinence</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Inferior_colliculi">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tectum_mesencephali"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior pair of the quadrigeminal bodies which contain centers for auditory function.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007245</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferior_Colliculi</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tectum_mesencephali">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The dorsal portion or roof of the midbrain which is composed of two pairs of bumps, the INFERIOR COLLICULI and the SUPERIOR COLLICULI. These four colliculi are also called the quadrigeminal bodies (TECTUM MESENCEPHALI). They are centers for visual sensorimotor integration.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D003336</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tectum_Mesencephali</rdfs:label>
</owl:Class>

