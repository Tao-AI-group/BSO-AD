  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
  <unti:Entry_Term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Early-onset familial form of Alzheimer disease; Alzheimer disease 1</unti:Entry_Term>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C536594</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer_Disease_Type_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_2">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
  <unti:Entry_Term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Late onset familial Alzheimer disease; Alzheimer Disease 2, Late-Onset; Alzheimer Disease Associated With Apoe4; Alzheimer disease associated with APOE E4; Alzheimer Disease 2</unti:Entry_Term>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C536595</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer_Disease_Type_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Alzheimer_disease_type_4">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
  <unti:Entry_Term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer Disease, Familial, 4; Alzheimer disease 4; Alzheimer disease, familial, type 4</unti:Entry_Term>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C536596</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Alzheimer_Disease_Type_4</rdfs:label>
</owl:Class>

