<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Malate_dehydrogenase_1">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malate_Dehydrogenase_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Malate_dehydrogenase_2">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malate_Dehydrogenase_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mammillary_body">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Posterior_hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pair of nuclei and associated GRAY MATTER in the interpeduncular space rostral to the posterior perforated substance in the POSTERIOR HYPOTHALAMUS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D008326</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mammillary_Body</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Posterior_hypothalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The part of the hypothalamus posterior to the middle region consisting of several nuclei including the medial maxillary nucleus, lateral mammillary nucleus, and posterior hypothalamic nucleus (posterior hypothalamic area). The posterior hypothalamic area is concerned with control of sympathetic responses and is sensitive to conditions of decreasing temperature and controls the mechanisms for the conservation and increased production of heat.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007034</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothalamus, posterior</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Posterior_Hypothalamus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Matrix_metallopeptidase_17">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Matrix_Metallopeptidase_17</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Median_eminence">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamo-hypophyseal_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Raised area at the infundibular region of the HYPOTHALAMUS at the floor of the BRAIN, ventral to the THIRD VENTRICLE and adjacent to the ARCUATE NUCLEUS OF HYPOTHALAMUS. It contains the terminals of hypothalamic neurons and the capillary network of hypophyseal portal system, thus serving as a neuroendocrine link between the brain and the PITUITARY GLAND.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D008473</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Median_Eminence</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mediodorsal_thalamic_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The largest of the medial nuclei of the thalamus. It makes extensive connections with most of the other thalamic nuclei.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020645</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mediodorsal_Thalamic_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Myelencephalon">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most posterior portion of the hindbrain from which MEDULLA OBLONGATA is derived.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D054024</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Myelencephalon</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Melanotroph">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intermediate_pituitary_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuroendocrine cells in the INTERMEDIATE LOBE OF PITUITARY. They produce MELANOCYTE STIMULATING HORMONES and other peptides from the post-translational processing of pro-opiomelanocortin (POMC).</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D052717</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Melanotroph</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memantine">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amantadine"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#NMDA_receptor_antagonist"/>
  <unti:BrandName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Namenda</unti:BrandName>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memantine might provide some benefit for patients with moderate-to-severe dementia, either as monotherapy or in combination with a cholinesterase inhibitor.</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memantine</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#NMDA_receptor_antagonist">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neurotransmitter_based_drug"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NMDA_Receptor_Antagonist</rdfs:label>
</owl:Class>

