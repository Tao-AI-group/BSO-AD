        <rdfs:label>Perilipin_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Perirhinal_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Perirhinal_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe"/>
        <untitled-ontology-107:Definition>An area in the temporal lobe that is important for memory encoding and retrieval. It is bordered caudally by the parahippocampal cortex (see HIPPOCAMPUS) and ventrally and medially by the ENTORHINAL CORTEX.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000071039</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Perirhinal_Cortex</rdfs:label>
    </owl:Class>
    


