    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
        <untitled-ontology-107:Definition>The posterior of the three primitive cerebral vesicles of an embryonic brain. It consists of myelencephalon, metencephalon, and isthmus rhombencephali from which develop the major BRAIN STEM components, such as MEDULLA OBLONGATA from the myelencephalon, CEREBELLUM and PONS from the metencephalon, with the expanded cavity forming the FOURTH VENTRICLE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D012249</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Rhombencephalon</rdfs:label>
    </owl:Class>
    


