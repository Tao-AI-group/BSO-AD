    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Caudate_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Caudate_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neostriatum"/>
        <untitled-ontology-107:Definition>Elongated gray mass of the neostriatum located adjacent to the lateral ventricle of the brain.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002421</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Caudate_Nucleus</rdfs:label>
    </owl:Class>
    


