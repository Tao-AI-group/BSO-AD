  <unti:Location_UCSC_from_NCBI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7:148,200,000-159,345,973</unti:Location_UCSC_from_NCBI>
  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALZHEIMER DISEASE 10; ALZHEIMER DISEASE, FAMILIAL, 10; AD10</unti:OMIM_Gene_Title>
  <unti2:Locus_MIM_number rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">609636</unti2:Locus_MIM_number>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AD10</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD11">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
  <unti:Location rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9p22.1</unti:Location>
  <unti:Location_UCSC_from_NCBI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9:18,500,000-19,900,000</unti:Location_UCSC_from_NCBI>
  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALZHEIMER DISEASE 11; ALZHEIMER DISEASE, FAMILIAL, 11;  AD11</unti:OMIM_Gene_Title>
  <unti2:Locus_MIM_number rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">609790</unti2:Locus_MIM_number>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AD11</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD12">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
