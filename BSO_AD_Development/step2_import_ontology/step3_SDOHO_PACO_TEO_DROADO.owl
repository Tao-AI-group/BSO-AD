        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
        <untitled-ontology-107:Definition>The part of the cerebral hemisphere anterior to the central sulcus, and anterior and superior to the lateral sulcus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D005625</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frontal_Lobe</rdfs:label>
    </owl:Class>
    


