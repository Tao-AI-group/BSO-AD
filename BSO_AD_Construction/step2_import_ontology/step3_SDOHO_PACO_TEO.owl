    <!-- https://github.com/Tao-AI-group/BSO_AD#00063 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00063">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00062"/>
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00066"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MeSH</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cocaine_Smoking</rdfs:label>
