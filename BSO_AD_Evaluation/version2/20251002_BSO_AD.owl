    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cbl_proto-oncogene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Cbl_Proto-oncogene</rdfs:label>
    </owl:Class>
    


