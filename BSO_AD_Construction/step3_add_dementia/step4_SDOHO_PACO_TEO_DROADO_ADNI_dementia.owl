  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drug_Target</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD10">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
