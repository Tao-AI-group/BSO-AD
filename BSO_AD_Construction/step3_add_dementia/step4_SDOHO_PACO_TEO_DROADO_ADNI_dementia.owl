  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BROMODOMAIN PHD FINGER TRANSCRIPTION FACTOR; BPTF; FETAL ALZHEIMER ANTIGEN; FALZ; FAC1; NURF301, DROSOPHILA, HOMOLOG OF; NURF301; BROMODOMAIN AND PHD DOMAIN TRANSCRIPTION FACTOR"</unti:OMIM_Gene_Title>
  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NEURODEVELOPMENTAL DISORDER WITH DYSMORPHIC FACIES AND DISTAL LIMB ANOMALIES; NEDDFL</unti:OMIM_Gene_Title>
