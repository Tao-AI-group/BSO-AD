    <!-- http://www.modiag.it#NPI -->

    <owl:Class rdf:about="http://www.modiag.it#NPI">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#BehaviouralAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.modiag.it#hasAssessmentItem"/>
                <owl:allValuesFrom rdf:resource="http://www.modiag.it#NPIItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Neuropsychiatric_Inventory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI-Q -->

    <owl:Class rdf:about="http://www.modiag.it#NPI-Q">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#BehaviouralAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.modiag.it#hasAssessmentItem"/>
                <owl:allValuesFrom rdf:resource="http://www.modiag.it#NPIQItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Neuropsychiatric_Inventory–questionnaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#SAItemByTest"/>
        <rdfs:label>NPI_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#SAItemByTest"/>
        <rdfs:label>NPIQ_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfAberrantMotorBehaviorItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfAberrantMotorBehaviorItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient engage in repetitive activities, such as pacing around the house, handling buttons, wrapping strings, or doing other things repeatedly?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Aberrant_Motor_Behavior_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfAgitationAggressionItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfAgitationAggressionItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient stubborn and resistive to help from others?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Agitation_Aggression_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfAnxietyItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfAnxietyItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient become upset when separated from you? Does he/she have any other signs of nervousness, such as shortness of breath, sighing, being unable to relax, or feeling excessively tense?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Anxiety_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfApathyIndifferenceItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfApathyIndifferenceItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient seem less interested in his/her usual activities and in the activities and plans of others?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Apathy_Indifference_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfAppetiteDisordersItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfAppetiteDisordersItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has the patient lost or gained weight, or had a change in the food he/she likes?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Appetite_Disorders_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfDelusionsItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfDelusionsItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that others are stealing from him/her, or planning to harm him/her in some way?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Delusions_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfDepressionDysphoriaItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfDepressionDysphoriaItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient act as if he/she is sad or in low spirits? Does he/she cry?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Depression_Dysphoria_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfDishinibitionItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfDishinibitionItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient seem to act impulsively? For example, does the patient talk to strangers as if he/she knows them, or does the patient say things that may hurt people&apos;s feelings?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Dishinibition_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfElationEuphoriaItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfElationEuphoriaItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient appear to feel too good or act excessively happy?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Elation_Euphoria_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfHallucinationsItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfHallucinationsItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have hallucinations such as false visions or
voices? Does he or she seem to hear or see things that are
not present?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Hallucinations_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfIrritabilityLabilityItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfIrritabilityLabilityItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient impatient or cranky? Does he/she have difficulty coping with delays or waiting for planned activities?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Irritability_Lability_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_PresenceOfSleepDisordersItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_PresenceOfSleepDisordersItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIQItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient awaken you during the night, rise too early in the morning, or take excessive naps during the day?</rdfs:comment>
        <rdfs:label>NPIQ_Presence_of_Sleep_Disorders_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPIQ_SeverityOfSymptomItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPIQ_SeverityOfSymptomItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIQItem"/>
        <rdfs:comment>Rate the SEVERITY of the symptom (how it affects the patient)</rdfs:comment>
        <rdfs:label>NPIQ_Severity_of_Symptom_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_1 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_1">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient pace, do things over and over such as opening closets or drawers, or repeatedly pick at things or wind string or threads?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_10 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_10">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient do any other activities over and over?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_10</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient pace around the house without apparent purpose?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient rummage around opening and unpacking drawers or closets?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient repeatedly put on and take off clothing?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have repetitive activities or &quot;habits&quot; that he/she performs over and over?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient repeatedly put on and take off clothing?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have repetitive activities or &quot;habits&quot; that he/she performs over and over?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_8">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient engage in repetitive activities such as handling buttons, picking, wrapping string, etc?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_9 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AberrantMotorBehaviourQuestionItem_9">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient fidget excessively, seem unable to sit still, or bounce his/her feet or tap his/her fingers a lot?</rdfs:comment>
        <rdfs:label>NPI_Aberrant_Motor_Behaviour_Question_Item_9</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionCaregiverDistress -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionCaregiverDistress">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Distress experienced by Caregiver due to the symptom</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Caregiver_Distress</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionFrequency -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionFrequency">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Frequency of the symptom</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_1 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_1">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient get upset with those trying to care for him/her or resist activities such as bathing or changing clothes?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient stubborn, having to have things his/her way?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient uncooperative, resistive to help from others?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have any other behaviors that make him/her hard to handle?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient shout or curse angrily?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient slam doors, kick furniture, throw things?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient attempt to hurt or hit others?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionQuestionItem_8">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have any other aggressive or agitated behaviors?</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Question_Item_8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AgitationAggressionSeverity -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AgitationAggressionSeverity">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Frequency x Severity</rdfs:comment>
        <rdfs:label>NPI_Agitation_Aggression_Severity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyDistressItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyDistressItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Distress experienced by Caregiver due to the symptom</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Distress_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyFrequencyItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyFrequencyItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Frequency of the symptom</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Frequency_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_1 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_1">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say that he/she is worried about planned events?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have periods of feeling shaky, unable to relax, or feeling excessively tense?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient have periods of [or complain of] shortness of breath, gasping, or sighing for no apparent reason other than nervousness?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient complain of butterflies in his/her stomach, or of racing or pounding of the heart in association with nervousness? [Symptoms not explained by ill health]</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient avoid certain places or situations that make him/her more nervous
such as riding in the car, meeting with friends, or being in crowds?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient become nervous and upset when separated from you [or his/her caregiver]? Does he/she cling to you to keep from being separated?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietyQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietyQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient show any other signs of anxiety?</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_AnxietySeverityItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_AnxietySeverityItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Severity of the symptom</rdfs:comment>
        <rdfs:label>NPI_Anxiety_Severity_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_1 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_1">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient seem less spontaneous and less active than usual?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient less likely to initiate a conversation?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient less affectionate or lacking in emotions when compared to his/her usual self?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient contribute less to household chores?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient seem less interested in the activities and plans of others?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has the patient lost interest in friends and family members?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Is the patient less enthusiastic about his/her usual interests?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_ApathyIndifferenceQuestionItem_8">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient show any other signs that he/she doesn’t care about doing new things?</rdfs:comment>
        <rdfs:label>NPI_Apathy_Indifference_Question_Item_8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsCaregiverDistressItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsCaregiverDistressItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>DISTRESS experienced by Caregiver due to the symptom</rdfs:comment>
        <rdfs:label>NPI_Delusions_Caregiver_Distress_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsFrequencyItem -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsFrequencyItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
        <rdfs:comment>Frequency of the symptom</rdfs:comment>
        <rdfs:label>NPI_Delusions_Frequency_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_1 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_1">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that he/she is in danger - that others are planning to hurt him/her?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that others are stealing from him/her?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that his/her spouse is having an affair?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that unwelcome guests are living in his/her house?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that his/her spouse or others are not who they claim to be?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that his/her house is not his/her home?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that family members plan to abandon him/her?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_8">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe that television or magazine figures are actually present in the home?  [Does he/she try to talk to or interact with them?]</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DelusionsQuestionItem_9 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_9">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient believe any other unusual things that I haven&apos;t asked about?</rdfs:comment>
        <rdfs:label>NPI_Delusions_Question_Item_9</rdfs:label>
    </owl:Class>
    


