        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Visinin_Like_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Visual_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Visual_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Occipital_lobe"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
        <untitled-ontology-107:Definition>Area of the OCCIPITAL LOBE concerned with the processing of visual information relayed via VISUAL PATHWAYS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D014793</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Visual_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Visual_loss -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Visual_loss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Physical_difficulty"/>
        <untitled-ontology-107:Description>Progressive loss of sight; problems with identification of objects</untitled-ontology-107:Description>
