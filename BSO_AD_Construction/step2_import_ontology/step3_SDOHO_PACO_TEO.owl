    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000042 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000042">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monday</rdfs:label>
        <skos:definition>The first day of a calendar week starting from Monday. Monday is after Sunday and before Tuesday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000043 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000043">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tuesday</rdfs:label>
        <skos:definition>The second day of a calendar week starting from Monday. Tuesday is after Monday and before Wednesday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000045 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000045">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wednesday</rdfs:label>
        <skos:definition>The thrid day of a calendar week starting from Monday.  Wednesday is after Tuesday and before Thursday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000046 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000046">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thursday</rdfs:label>
        <skos:definition>The fourth day of a calendar week starting from Monday. Thursday is after Wednesday and before Friday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000047 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000047">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Friday</rdfs:label>
        <skos:definition>The fifth day of a calendar week starting from Monday. Friday is after Thursday and before Saturday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000048 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000048">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Saturday</rdfs:label>
        <skos:definition>The sixth day of a calendar week starting from Monday. Saturday is after Friday and before Sunday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000049 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000049">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sunday</rdfs:label>
        <skos:definition>The last day of a calendar week starting from Monday. Sunday is after Saturday and before the Monday next week.</skos:definition>
    </owl:Class>
    


