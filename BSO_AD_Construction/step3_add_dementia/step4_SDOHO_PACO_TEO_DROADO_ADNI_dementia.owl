  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The part of the cerebral hemisphere anterior to the central sulcus, and anterior and superior to the lateral sulcus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005625</unti:MeSH_Unique_ID>
