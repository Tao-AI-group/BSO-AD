        <untitled-ontology-107:Definition>Anterior pituitary cells that produce PROLACTIN.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052682</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lactotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_hypothalamic_area -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_hypothalamic_area">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
        <untitled-ontology-107:Definition>Area in the hypothalamus bounded medially by the mammillothalamic tract and the anterior column of the FORNIX (BRAIN). The medial edge of the INTERNAL CAPSULE and the subthalamic region form its lateral boundary. It contains the lateral hypothalamic nucleus, tuberomammillary nucleus, lateral tuberal nuclei, and fibers of the MEDIAL FOREBRAIN BUNDLE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D007026</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Hypothalamic area, lateral</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lateral_Hypothalamic_Area</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_thalamic_nuclei -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_thalamic_nuclei">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
        <untitled-ontology-107:Definition>A narrow strip of cell groups on the dorsomedial surface of the thalamus. It includes the lateral dorsal nucleus, lateral posterior nucleus, and the PULVINAR.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020647</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lateral_Thalamic_Nuclei</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_ventricle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_ventricle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
        <untitled-ontology-107:Definition>Cavity in each of the CEREBRAL HEMISPHERES derived from the cavity of the embryonic NEURAL TUBE. They are separated from each other by the SEPTUM PELLUCIDUM, and each communicates with the THIRD VENTRICLE by the foramen of Monro, through which also the choroid plexuses (CHOROID PLEXUS) of the lateral ventricles become continuous with that of the third ventricle.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020547</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lateral_Ventricle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_vestibular_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Lateral_vestibular_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Vestibular_nuclei"/>
        <untitled-ontology-107:Definition>Vestibular nucleus lying immediately superior to the inferior vestibular nucleus and composed of large multipolar nerve cells. Its upper end becomes continuous with the superior vestibular nucleus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D003689</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Vestibular nucleus, lateral</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lateral_Vestibular_Nucleus</rdfs:label>
    </owl:Class>
    


