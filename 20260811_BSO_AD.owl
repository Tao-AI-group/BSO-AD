        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010449</IRI>
        <Literal>C0030560</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="unti:MeSH_Unique_ID"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010452</IRI>
        <Literal>D066191</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010452</IRI>
        <Literal>Sensorimotor_Cortex</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
