        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Saturday</rdfs:label>
        <skos:definition>The sixth day of a calendar week starting from Monday. Saturday is after Friday and before Sunday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000049 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000049">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sunday</rdfs:label>
        <skos:definition>The last day of a calendar week starting from Monday. Sunday is after Saturday and before the Monday next week.</skos:definition>
    </owl:Class>
    


