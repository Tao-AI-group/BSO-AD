        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plectin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pleiotrophin -->

