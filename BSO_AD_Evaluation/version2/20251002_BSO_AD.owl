    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Respiratory_burst -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Respiratory_burst">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process"/>
        <rdfs:label>Respiratory_Burst</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Respiratory_center -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Respiratory_center">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Reticular_formation"/>
        <untitled-ontology-107:Definition>Part of the brain located in the MEDULLA OBLONGATA and PONS. It receives neural, chemical and hormonal signals, and controls the rate and depth of respiratory movements of the DIAPHRAGM and other respiratory muscles.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D012125</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Respiratory_Center</rdfs:label>
    </owl:Class>
    


