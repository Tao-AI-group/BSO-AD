<?xml version="1.0"?>
<rdf:RDF xmlns="https://sbmi.uth.edu/ontology/TEO.owl#"
     xml:base="https://sbmi.uth.edu/ontology/TEO.owl"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:TEO="https://sbmi.uth.edu/ontology/TEO.owl#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="https://sbmi.uth.edu/ontology/TEO.owl">
        <dc:contributor>Du, Jingcheng</dc:contributor>
        <dc:contributor>Henry, Chen</dc:contributor>
        <dc:contributor>Li, Fang</dc:contributor>
        <dc:contributor>Luo, Yi</dc:contributor>
        <dc:contributor>Song, Hsing-Yi</dc:contributor>
        <dc:creator>He, Oliver</dc:creator>
        <dc:creator>Tao, Cui</dc:creator>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <RDOC_0000000000 xml:lang="en">cui.tao@uth.tmc.edu</RDOC_0000000000>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#isDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#RDOC_0000000000 -->

    <owl:AnnotationProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#RDOC_0000000000">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contactInfo</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000172 -->

    <owl:AnnotationProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000172">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
        <skos:definition>Used to desribe different units of measures to represent different levels of granularity.</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:range rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000162"/>
    </owl:AnnotationProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000173 -->

    <owl:AnnotationProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000173">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasApproximation</rdfs:label>
        <skos:definition>covering expressions of how the triple might be and should be. This includes expressions of necessity, permissibility and probability, and negations of these</skos:definition>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000176 -->

    <owl:AnnotationProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000176">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasTimeOffset</rdfs:label>
        <skos:definition>Defines the relative timing of a pair of events</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000002 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000002">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000154"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000016"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">before</rdfs:label>
        <skos:altLabel>&quot;prior to&quot;</skos:altLabel>
        <skos:definition>Interval relation. The source event ended before the start of the target event. It is the same as the point relation &quot;endBeforeStart&quot;.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000003 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000003">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000010"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">during</rdfs:label>
        <skos:definition>Interval relation. The source event started after and ended before the target event</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000006 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000006">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInstant"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasEndTime</rdfs:label>
        <skos:definition>Describes the end time of an interval. The domain is a time interval. The range is a time instant.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000007 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000007">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasValidTime</rdfs:label>
        <skos:definition>To link an event with its specific timestamps</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000010 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000010">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contain</rdfs:label>
        <skos:definition>Interval relation. The source event happened before and ended after the target event</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000014 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000014">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000147"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">start</rdfs:label>
        <skos:definition>Interval relation. Two events started at the same time and the source event ended before the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000016 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000016">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000153"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">after</rdfs:label>
        <skos:altLabel>&quot;post to&quot;</skos:altLabel>
        <skos:definition>Interval relation. The source event happened after target event. It is the same as the point relation &quot;startAfterEnd&quot;. </skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000018 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000018">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">equal</rdfs:label>
        <skos:definition>Interval relation. Two events happened at the same time. It is true when both events are associated with either timeinstants or timeintervals. When both events are associated with time intervals, they must start at the same time and end at the same time.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000020 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000020">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146"/>
        <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000038"/>
        <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">meet</rdfs:label>
        <skos:definition>Interval relation. The source event ended at (the same time as) the start of the target event. It is the same as the point relation &quot;endEqualStart&quot;.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000022 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000022">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDuration</rdfs:label>
        <skos:definition>Describes the duration of a time interval</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000028 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000028">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
        <rdfs:range rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInstant"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasStartTime</rdfs:label>
        <skos:definition>Describes the start time of a time interval. The domain is a time interval and the range is a time instant.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000037 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000037">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000148"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">finish</rdfs:label>
        <skos:definition>Interval relation. Two events ended at the same time and the source event started after the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000038 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000038">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145"/>
        <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overlap</rdfs:label>
        <skos:definition>Interval relation. Two events have overlap on the timeline. The source event starts before and  ends before the end of the target event and the source event ends after the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporalRelation</rdfs:label>
        <skos:definition>The super set of the temporal relations defined in the ontology. Akin to Allen&apos;s temporal operators, but are defined between events instead of time intervals</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overlappedBy</rdfs:label>
        <skos:definition>Interval relation. Two events have overlap on the timeline. The source event starts after and ends after the start of the target event and the source event starts before the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metBy</rdfs:label>
        <skos:definition>Interval relation. The source event started at (the same time as) the end of the target event. It is the same as the point relation &quot;startEqualEnd&quot;.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000147 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000147">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startedBy</rdfs:label>
        <skos:definition>Interval relation. Two events started at the same time and the source event ended after the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000148 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000148">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">finishedBy</rdfs:label>
        <skos:definition>Interval relation. Two events ended at the same time and the source event started before the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startEqualStart</rdfs:label>
        <skos:definition>Point relation. The source event started at (the same time as) the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startBeforeStart</rdfs:label>
        <skos:definition>Point relation. The source event started before the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startBeforeEnd</rdfs:label>
        <skos:definition>Point relation. The source event started before the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startAfterStart</rdfs:label>
        <skos:definition>Point relation. The source event started after the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000153 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000153">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000154"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startAfterEnd</rdfs:label>
        <skos:definition>Point relation. The source event starts after the end of the target event. It is the same as &quot;after&quot; in Allen&apos;s Interval Algebra.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000154 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000154">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endBeforeStart</rdfs:label>
        <skos:definition>Point relation. The source event ended beofre the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endBeforeEnd</rdfs:label>
        <skos:definition>Point relation. The source event ended before the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterStart</rdfs:label>
        <skos:definition>Point relation. The source event ended after the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterEnd</rdfs:label>
        <skos:definition>Point relation. The source event ends after the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startEqualEnd</rdfs:label>
        <skos:definition>Point relation. the source event started at (the same time as) the end of the target event. It is the same as the interval relation &quot;metBy&quot;.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualStart</rdfs:label>
        <skos:definition>Point relation. The source event ended at (the same time as) the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualEnd</rdfs:label>
        <skos:definition>Point relation. The source event ended at (the same time as) the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171">
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171"/>
                <owl:someValuesFrom rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000162"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
        <skos:definition>Describes the granularity of a temporal element</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000180 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000180">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasPeriod</rdfs:label>
        <skos:definition>Describes the interval between the start time of two units in a TimePhase</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000182 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000182">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatUnit</rdfs:label>
        <skos:definition>Describes the uint that ocurrs periodically in a TimePhase</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000183 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000183">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatUnitInterval</rdfs:label>
        <skos:definition>Describes the interval between two repeat units of a TimePhase</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]*+[:]+[0-9]*+[:]+[0-9]*</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasNormalizedTime</rdfs:label>
        <skos:definition>use to represent the normalized view of the time expression of the given instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasOrigTime</rdfs:label>
        <skos:definition>use to represent the original  time expression of the instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:comment>describe the granularity of a temporal element</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:comment>describe the unit of a duration</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationUnit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationValue</rdfs:label>
        <skos:definition>capture the value of a duration, e.g., in &quot;2 hours&quot;, 2 is the duation value and hour is the duation unit</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>([0-9]*+(\.[0-9]*)?+[Y])?([0-9]*+(\.[0-9]*)?+[M])?([0-9]*+(\.[0-9]*)?+[W])?([0-9]*+(\.[0-9]*)?+[D])?([0-9]*+(\.[0-9]*)?+[H])?([0-9]*+(\.[0-9]*)?+[m])?([0-9]*+(\.[0-9]*)?+[s])?</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationPattern</rdfs:label>
        <skos:definition>In the form of &quot;4Y5M3W0D0H0m0s&quot;.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasApproximation</rdfs:label>
        <skos:definition>covering expressions of how the world might be and should be. This includes expressions of necessity, permissibility and probability, and negations of these</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177">
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationOriginForm</rdfs:label>
        <skos:definition>capture the orign form of the duration string</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatTimes</rdfs:label>
        <skos:definition>Describe the number of units that re-occur in a TimePhase</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSeverity</rdfs:label>
        <skos:definition>to declare the severity of a lab test or symptom</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDescription</rdfs:label>
        <skos:definition>add the detailed description to the event</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasAgeValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ifomis.org/bfo/1.1/span#TimeInstant -->

    <owl:Class rdf:about="http://www.ifomis.org/bfo/1.1/span#TimeInstant">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#Time"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time_Instant</rdfs:label>
        <skos:altLabel>Time Instant</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.ifomis.org/bfo/1.1/span#TimeInterval -->

    <owl:Class rdf:about="http://www.ifomis.org/bfo/1.1/span#TimeInterval">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#Time"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time_Interval</rdfs:label>
        <skos:altLabel>Time Interval</skos:altLabel>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/PeriodicTimeInterval -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/PeriodicTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Periodic_Time_Interval</rdfs:label>
        <skos:definition>A prototype of the repeating interval, specifying the duration of each occurrence and anchors the PeriodicTimeInterval sequence at a certain point in time.</skos:definition>
        <skos:example>In &quot;Every eight hours for two minutes &quot;, 2 minutes can be represented using timephase</skos:example>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Afternoon -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Afternoon">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000190"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Afternoon</rdfs:label>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Clinical_Intervention -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Clinical_Intervention">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical_Intervention</rdfs:label>
        <skos:definition>Any clinical intervention done on a patient, including medication administration, surgeries, behavioral interventions, clinical trial process, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Diagnosis -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Diagnosis">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diagnosis</rdfs:label>
        <skos:definition>Diseases that have been diagnosed</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Documentation -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Documentation">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Documentation</rdfs:label>
        <skos:definition>All documentation and non-clinical actions, like check-in, discharge, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Observation -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Observation">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation</rdfs:label>
        <skos:definition>Symptoms</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Other_Event -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Other_Event">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other_Event</rdfs:label>
        <skos:definition>All other events</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#Patient_Accident -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#Patient_Accident">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient_Accident</rdfs:label>
        <skos:definition>All non-clinical actions done on/by the patient, like blunt force, injuries, falls, etc.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000011 -->

