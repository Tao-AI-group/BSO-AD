  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus located in the pontine tegmentum with motor neurons that innervate the muscles of the JAW through the motor portion of the TRIGEMINAL NERVE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066266</unti:MeSH_Unique_ID>
