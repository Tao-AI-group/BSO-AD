                    <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Frequency x Severity</rdfs:comment>
        <rdfs:label>NPI_Sleep_Total_Item</rdfs:label>
    </owl:Class>
    


