        <Literal>Area of the OCCIPITAL LOBE concerned with the processing of visual information relayed via VISUAL PATHWAYS.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010454</IRI>
        <Literal>Visual Cortex</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
