        <rdfs:label>Triggering_Receptor_Expressed_on_Myeloid_Cells_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tuber_cinereum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tuber_cinereum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus"/>
        <untitled-ontology-107:Definition>Layer of GRAY MATTER in the HYPOTHALAMUS that also forms part of the floor of the THIRD VENTRICLE and merges anteriorly into the infundibulum (see PITUITARY GLAND, POSTERIOR).</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D014371</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Tuber_Cinereum</rdfs:label>
    </owl:Class>
    


