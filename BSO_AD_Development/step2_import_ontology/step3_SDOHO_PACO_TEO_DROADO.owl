        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland"/>
        <untitled-ontology-107:Definition>Anterior pituitary cells that produce ADRENOCORTICOTROPHIC HORMONE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052680</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corticotroph</rdfs:label>
    </owl:Class>
    


