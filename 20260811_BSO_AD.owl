        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010497</IRI>
        <Literal>The innermost layer of the three meninges covering the brain and spinal cord. It is the fine vascular membrane that lies under the ARACHNOID and the DURA MATER.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010497</IRI>
        <Literal>Pia Mater</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
