    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010372</IRI>
        <Literal>A nucleus located in the middle hypothalamus in the most ventral part of the THIRD VENTRICLE near the entrance of the infundibular recess. Its small cells are in close contact with the EPENDYMA.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
