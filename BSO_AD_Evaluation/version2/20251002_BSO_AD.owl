    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
        <untitled-ontology-107:Definition>A composite area of the cerebral cortex concerned with motor control and sensory perception comprising the motor cortex areas, the somatosensory areas, the gustatory cortex, the olfactory areas, the auditory cortex, and the visual cortex.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066191</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Sensorimotor_Cortex</rdfs:label>
    </owl:Class>
    


