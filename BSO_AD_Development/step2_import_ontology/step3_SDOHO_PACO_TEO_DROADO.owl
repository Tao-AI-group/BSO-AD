    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#RCAN1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#RCAN1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
        <untitled-ontology-107:Location>21q22.12 </untitled-ontology-107:Location>
        <untitled-ontology-107:Location_UCSC_from_NCBI>21:34,516,441-34,615,122</untitled-ontology-107:Location_UCSC_from_NCBI>
