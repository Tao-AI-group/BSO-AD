        <Literal>D017072</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010421</IRI>
        <Literal>Neostriatum</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010421</IRI>
        <Literal>The phylogenetically newer part of the CORPUS STRIATUM consisting of the CAUDATE NUCLEUS and PUTAMEN. It is often called simply the striatum.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
