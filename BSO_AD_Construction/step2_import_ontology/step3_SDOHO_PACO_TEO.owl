        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endBeforeStart</rdfs:label>
        <skos:definition>Point relation. The source event ended beofre the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155">
