</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cisterna_magna">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subarachnoid_space"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of three principal openings in the SUBARACHNOID SPACE. They are also known as cerebellomedullary cistern, and collectively as cisterns.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002946</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cisterna_Magna</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subarachnoid_space">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arachnoid"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The space between the arachnoid membrane and PIA MATER, filled with CEREBROSPINAL FLUID. It contains large blood vessels that supply the BRAIN and SPINAL CORD.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013346</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subarachnoid_Space</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Citalopram">
