        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010392</IRI>
        <Literal>A transition zone in the anterior part of the diencephalon interposed between the thalamus, hypothalamus, and tegmentum of the mesencephalon. Components of the subthalamus include the SUBTHALAMIC NUCLEUS, zona incerta, nucleus of field H, and the nucleus of ansa lenticularis. The latter contains the ENTOPEDUNCULAR NUCLEUS.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010392</IRI>
        <Literal>subthalamus</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#UMLS_CUI"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010392</IRI>
        <Literal>C0152349</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="unti:MeSH_Unique_ID"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010393</IRI>
        <Literal>D020392</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010393</IRI>
        <Literal>Entopeduncular_Nucleus</Literal>
