        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
        <untitled-ontology-107:Definition>The midbrain portion of the reticular formation located in the MIDBRAIN TEGMENTUM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066265</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midbrain_Reticular_Formation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_cerebellar_peduncle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_cerebellar_peduncle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
        <untitled-ontology-107:Definition>WHITE MATTER consisting of a large bundle of paired fibers originating in the pontine nuclei in the pre pontis and the nucleus reticularis tegmenti pontis projecting to the contralateral cerebral cortex.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065837</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle_Cerebellar_Peduncle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
        <untitled-ontology-107:Definition>Middle portion of the hypothalamus containing the arcuate, dorsomedial, ventromedial nuclei, the TUBER CINEREUM and the PITUITARY GLAND.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D007033</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Hypothalamus, middle</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle_Hypothalamus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midkine -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midkine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midkine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midline_thalamic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midline_thalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
        <untitled-ontology-107:Definition>Small, nonspecific nerve cells scattered in the periventricular GRAY MATTER, separating the medial part of the thalamus from the EPENDYMA of the THIRD VENTRICLE. The group includes the paraventricular nucleus, paratenial nucleus, reuniens nucleus, rhomboidal nucleus, and subfascular nucleus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020644</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midline_Thalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_cognitive_impairment_due_to_AD -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_cognitive_impairment_due_to_AD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Stage"/>
        <untitled-ontology-107:Definition>National Institute on Aging - Alzheimer Association (NIA-AA) criteria: requires evidence of intra-individual decline, manifested by  a change in cognition from previously attained levels, impaired cognition in at least one domain (but not necessarily episodic memory), preserved independence in functional abilities, and no dementia</untitled-ontology-107:Definition>
        <untitled-ontology-107:Description>Characterized by mild cognitive impairment; patients have objective cognitive decline in one or more domains; capable of independent living</untitled-ontology-107:Description>
        <untitled-ontology-107:Synonym>Predementia phase; Prodromal AD 

International Working Group (IWG) criteria: Predementia AD is represented by prodromal AD, with episodic memory impairment that is insufficient to disrupt the performance of accustomed instrumental activities of daily living (IADL).</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild_Cognitive_Impairment_Due_to_AD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_stage_of_dementia_due_to_AD -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_stage_of_dementia_due_to_AD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dementia_due_to_AD"/>
        <untitled-ontology-107:Synonym>Mild Alzheimer&apos;s disease; early stage of Alzheimer&apos;s disease</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild_Stage_of_Dementia_Due_to_AD</rdfs:label>
    </owl:Class>
    


