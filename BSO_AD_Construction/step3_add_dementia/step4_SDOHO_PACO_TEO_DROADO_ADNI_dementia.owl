</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000016">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000153"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">after</rdfs:label>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"post to"</core:altLabel>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event happened after target event. It is the same as the point relation "startAfterEnd". </core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000003">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000010"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">during</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event started after and ended before the target event</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startAfterStart</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event started after the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterStart</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event ended after the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000010">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contain</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event happened before and ended after the target event</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000006">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
  <rdfs:range rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInstant"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasEndTime</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the end time of an interval. The domain is a time interval. The range is a time instant.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000007">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000025"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasValidTime</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To link an event with its specific timestamps</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterEnd</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event ends after the end of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000014">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000147"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">start</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events started at the same time and the source event ended before the end of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startEqualStart</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event started at (the same time as) the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000147">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startedBy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events started at the same time and the source event ended after the end of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000153">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000154"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startAfterEnd</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event starts after the end of the target event. It is the same as "after" in Allen's Interval Algebra.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000018">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000149"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">equal</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events happened at the same time. It is true when both events are associated with either timeinstants or timeintervals. When both events are associated with time intervals, they must start at the same time and end at the same time.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualEnd</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event ended at (the same time as) the end of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000020">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146"/>
  <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000038"/>
  <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">meet</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event ended at (the same time as) the start of the target event. It is the same as the point relation "endEqualStart".</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualStart</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event ended at (the same time as) the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metBy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event started at (the same time as) the end of the target event. It is the same as the point relation "startEqualEnd".</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000038">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145"/>
  <owl:propertyDisjointWith rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000146"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overlap</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events have overlap on the timeline. The source event starts before and  ends before the end of the target event and the source event ends after the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000145">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overlappedBy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events have overlap on the timeline. The source event starts after and ends after the start of the target event and the source event starts before the end of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000022">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:range rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDuration</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the duration of a time interval</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000028">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:domain rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
  <rdfs:range rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInstant"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasStartTime</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the start time of a time interval. The domain is a time interval and the range is a time instant.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000037">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000148"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">finish</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events ended at the same time and the source event started after the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000148">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">finishedBy</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. Two events ended at the same time and the source event started before the start of the target event.</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporalRelation</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The super set of the temporal relations defined in the ontology. Akin to Allen's temporal operators, but are defined between events instead of time intervals</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158">
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
  <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startEqualEnd</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. the source event started at (the same time as) the end of the target event. It is the same as the interval relation "metBy".</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171">
  <rdfs:range>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171"/>
      <owl:someValuesFrom rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000162"/>
    </owl:Restriction>
  </rdfs:range>
  <rdfs:range>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the granularity of a temporal element</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000180">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasPeriod</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the interval between the start time of two units in a TimePhase</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000182">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatUnit</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the uint that ocurrs periodically in a TimePhase</core:definition>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000183">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatUnitInterval</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describes the interval between two repeat units of a TimePhase</core:definition>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the granularity of a temporal element</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#assessmentInfo"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#assessmentSource">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
  <rdfs:comment xml:lang="en">V = Participant visit; C = Telephone call</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#dayOfBirth"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#education">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It is not clear what information the field carries</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#eventDate"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#gender">
  <www.:valuesMeaning xml:lang="en">1=Male; 2=Female</www.:valuesMeaning>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#handedness">
  <www.:valuesMeaning xml:lang="en">1=Right;2=Left</www.:valuesMeaning>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#homeType">
  <www.:valuesMeaning xml:lang="en">1=House;2=Condo/Co-op (owned);3=Apartment (rented);4=Mobile Home;5=Retirement Community;6=Assisted Living;7=Skilled Nursing Facility;8=Other (specify)</www.:valuesMeaning>
  <rdfs:comment xml:lang="en">Type of Participant residence</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#itemAnswer">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#itemScore">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#maritalStatus">
  <www.:valuesMeaning xml:lang="en">1=Married; 2=Widowed; 3=Divorced; 4=Never married; 5=Unknown</www.:valuesMeaning>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#mmse_attentionAndCalculation">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#summedScore"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#summedScore">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
  <rdfs:comment xml:lang="en">A score that is the sum of single items scores</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#monthOfBirth"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#neurologicalFinding"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#primaryOccupation">
  <rdfs:comment xml:lang="en">Primary occupation during most of adult life</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#recallItemList">
  <www.:valuesMeaning xml:lang="en">"1" stands for the list (Ball; Flag; Tree);
"2" stands for the list (Apple; Penny; Table).</www.:valuesMeaning>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#recentOccupation">
  <rdfs:comment xml:lang="en">Most recent occupation</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#retired">
  <www.:valuesMeaning xml:lang="en">1=Yes;0=No;2=Not Applicable</www.:valuesMeaning>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#retirementDate"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#significantAuditoryImpairment">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#neurologicalFinding"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#significantVisualImpairment">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#neurologicalFinding"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#totalScore">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#summedScore"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#unableToCompleteWhy">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
  <rdfs:comment xml:lang="en">Why the participant is unable to complete the test based on the clinician's best judgement. </rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#verbatimAnswer">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemAnswer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#yearOfBirth"/>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#yesNoAnswer">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemAnswer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#0_05_1_2_3_CDR_score">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment xml:lang="en">0 = None; 0.5 = Questionable; 1 = Mild; 2 = Moderate; 3 = Severe</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_4_5_NPI_score">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0 :Not distressing at all;  1: Minimal; 2:Mild; 3 : Moderate; 4 : Severe 5 :Extreme or Very Severe</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_NPIQ_score">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0 = None (not present) 1 = Mild (noticeable, but not a significant change) 2 = Moderate (significant, but not a dramatic change) 3 = Severe (very marked or prominent, a dramatic change)</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_score">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_score">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment xml:lang="en">0 = Wrong; 1 = Right</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#1_2_3_4_NPI_score_3">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1: Occasionally; 2: Often; 3: Frequently; 4: Very frequently</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.modiag.it#1_2_3_NPI_score_2">
  <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1: Mild; 2: Moderate; 3: Marked</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#hasTotalAmountMin">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Activity"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:pattern rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[0-9]*+[:]+[0-9]*+[:]+[0-9]*</xsd:pattern>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasNormalizedTime</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use to represent the normalized view of the time expression of the given instant</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:domain>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasOrigTime</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">use to represent the original  time expression of the instant</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">describe the unit of a duration</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationUnit</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationValue</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capture the value of a duration, e.g., in "2 hours", 2 is the duation value and hour is the duation unit</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144">
  <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
  <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:withRestrictions>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <xsd:pattern rdf:datatype="http://www.w3.org/2001/XMLSchema#string">([0-9]*+(\.[0-9]*)?+[Y])?([0-9]*+(\.[0-9]*)?+[M])?([0-9]*+(\.[0-9]*)?+[W])?([0-9]*+(\.[0-9]*)?+[D])?([0-9]*+(\.[0-9]*)?+[H])?([0-9]*+(\.[0-9]*)?+[m])?([0-9]*+(\.[0-9]*)?+[s])?</xsd:pattern>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationPattern</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the form of "4Y5M3W0D0H0m0s".</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasApproximation</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">covering expressions of how the world might be and should be. This includes expressions of necessity, permissibility and probability, and negations of these</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177">
  <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationOriginForm</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capture the orign form of the duration string</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatTimes</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Describe the number of units that re-occur in a TimePhase</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSeverity</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">to declare the severity of a lab test or symptom</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206">
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDescription</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">add the detailed description to the event</core:definition>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasAgeValue</rdfs:label>
</owl:DatatypeProperty>

