        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extreme_Poverty</rdfs:label>
        <ICD10CM_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Z59.5</ICD10CM_ID>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00144 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00144">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00072"/>
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00353"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial_Stress</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Financial_Distressing</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stress arising from personal financial concerns. (https://www.cancer.gov/publications/dictionaries/cancer-terms/def/financial-stress). (MSH)
 Refers to the costs required to deal with a specific situation (e.g., disease burden). (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C5392146</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C5392146</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mental Process</UMLS_Semantic_Type>
    </owl:Class>
    


