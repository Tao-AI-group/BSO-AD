    <!-- https://github.com/Tao-AI-group/BSO_AD#00176 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00176">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00172"/>
