            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#hasActivityEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Stretch_muscle"/>
            </owl:Restriction>
