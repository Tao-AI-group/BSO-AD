        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#downregulates"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhes"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Lonafarnib</rdfs:label>
    </owl:Class>
    


