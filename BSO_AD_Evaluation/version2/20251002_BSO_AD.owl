        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
        <untitled-ontology-107:Definition>The dorsal posterior subdivision of the diencephalon. The epithalamus is generally considered to include the habenular nuclei (HABENULA) and associated fiber bundles, the PINEAL BODY, and the epithelial roof of the third ventricle. The anterior and posterior paraventricular nuclei of the thalamus are included with the THALAMIC NUCLEI although they develop from the same pronuclear mass as the epithalamic nuclei and are sometimes considered part of the epithalamus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D019261</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Epithalamus</rdfs:label>
    </owl:Class>
    


