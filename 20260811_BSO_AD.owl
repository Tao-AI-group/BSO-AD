        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010370</IRI>
        <Literal>Area in the hypothalamus bounded medially by the mammillothalamic tract and the anterior column of the FORNIX (BRAIN). The medial edge of the INTERNAL CAPSULE and the subthalamic region form its lateral boundary. It contains the lateral hypothalamic nucleus, tuberomammillary nucleus, lateral tuberal nuclei, and fibers of the MEDIAL FOREBRAIN BUNDLE.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010370</IRI>
