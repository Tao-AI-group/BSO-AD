        <untitled-ontology-107:Definition>A region in the substantia nigra located ventral and lateral to the PARS COMPACTA.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065841</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Pars_Reticulata</rdfs:label>
