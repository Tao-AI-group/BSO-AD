        <Literal>GDS_Helplessness_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:question"/>
        <IRI>http://www.modiag.it#08021588</IRI>
        <Literal xml:lang="en">Do you prefer to stay at home, rather than going out and doing new things?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021588</IRI>
        <Literal>GDS_Home_Staying_Item</Literal>
