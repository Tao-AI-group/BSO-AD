<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Habenula">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Epithalamus"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pineal_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small protuberance at the dorsal, posterior corner of the wall of the THIRD VENTRICLE, adjacent to the dorsal THALAMUS and PINEAL BODY. It contains the habenular nuclei and is a major part of the epithalamus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D019262</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Habenula</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pineal_gland">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Epithalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A light-sensitive neuroendocrine organ attached to the roof of the THIRD VENTRICLE of the brain. The pineal gland secretes MELATONIN, other BIOGENIC AMINES and NEUROPEPTIDES.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010870</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pineal_Gland</rdfs:label>
</owl:Class>

