  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The differential social worth which is ascribed to jobs or occupations. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C0237796</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0237796</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualitative Concept</UMLS_Semantic_Type>
</owl:Class>

