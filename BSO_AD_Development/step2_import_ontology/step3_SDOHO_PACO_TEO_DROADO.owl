        <untitled-ontology-107:Definition>Region of midbrain tectum located posterior to the THALAMUS and anterior to the SUPERIOR COLLICULUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066250</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pretectal_Region</rdfs:label>
    </owl:Class>
    


