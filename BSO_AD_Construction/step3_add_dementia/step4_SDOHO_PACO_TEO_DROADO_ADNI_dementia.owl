<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000030">
  <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Week</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defines a particular week, where the sequence of the weekdays can be defined using TimeSequence. For example, one can define a week from Monday to Sunday, from Sunday to Sat, or from Tue to Mon.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000031">
