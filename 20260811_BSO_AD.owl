        <Literal>One of three principal openings in the SUBARACHNOID SPACE. They are also known as cerebellomedullary cistern, and collectively as cisterns.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010494</IRI>
        <Literal>cisterna magna</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
