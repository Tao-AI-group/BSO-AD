<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dentate_gyrus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GRAY MATTER situated above the GYRUS HIPPOCAMPI. It is composed of three layers. The molecular layer is continuous with the HIPPOCAMPUS in the hippocampal fissure. The granular layer consists of closely arranged spherical or oval neurons, called GRANULE CELLS, whose AXONS pass through the polymorphic layer ending on the DENDRITES of PYRAMIDAL CELLS in the hippocampus.</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D018891</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dentate_Gyrus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Depressive_symptom">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depressive_Symptom</rdfs:label>
</owl:Class>

