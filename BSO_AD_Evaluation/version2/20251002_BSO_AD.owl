    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain"/>
        <untitled-ontology-107:Definition>The part of the brain that connects the CEREBRAL HEMISPHERES with the SPINAL CORD. It consists of the MESENCEPHALON; PONS; and MEDULLA OBLONGATA.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001933</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Brain_Stem</rdfs:label>
    </owl:Class>
    


