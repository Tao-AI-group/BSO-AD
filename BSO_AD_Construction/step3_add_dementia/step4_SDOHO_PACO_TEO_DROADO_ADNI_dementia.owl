  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Delusions_Frequency_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_1">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient believe that he/she is in danger - that others are planning to hurt him/her?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Delusions_Question_Item_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_2">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient believe that others are stealing from him/her?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Delusions_Question_Item_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_3">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient believe that his/her spouse is having an affair?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Delusions_Question_Item_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_4">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient believe that unwelcome guests are living in his/her house?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Delusions_Question_Item_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_DelusionsQuestionItem_5">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
