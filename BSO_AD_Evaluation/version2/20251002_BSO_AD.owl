        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Prosencephalon"/>
        <untitled-ontology-107:Definition>The paired caudal parts of the PROSENCEPHALON from which the THALAMUS; HYPOTHALAMUS; EPITHALAMUS; and SUBTHALAMUS are derived.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D004027</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Diencephalon</rdfs:label>
    </owl:Class>
    


