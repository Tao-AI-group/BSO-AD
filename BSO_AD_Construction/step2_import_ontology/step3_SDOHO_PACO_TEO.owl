    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000183 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000183">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatUnitInterval</rdfs:label>
        <skos:definition>Describes the interval between two repeat units of a TimePhase</skos:definition>
    </owl:ObjectProperty>
    


