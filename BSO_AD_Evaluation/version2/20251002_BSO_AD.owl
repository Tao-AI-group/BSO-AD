 https://uts.nlm.nih.gov/uts/umls/concept/C0037422</skos:definition>
        <UMLS_CUI>C0037422</UMLS_CUI>
        <UMLS_Semantic_Type>Qualitative Concept</UMLS_Semantic_Type>
    </owl:Class>
    


