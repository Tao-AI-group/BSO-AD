 https://uts.nlm.nih.gov/uts/umls/concept/C4724250</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C4724250</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional Concept</UMLS_Semantic_Type>
