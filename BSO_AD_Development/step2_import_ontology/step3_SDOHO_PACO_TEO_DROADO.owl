    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pedunculopontine_tegmental_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midbrain_reticular_formation"/>
        <untitled-ontology-107:Definition>Dense collection of cells in the caudal pontomesencephalic tegmentum known to play a role in the functional organization of the BASAL GANGLIA and in the modulation of the thalamocortical neuronal system.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D045042</untitled-ontology-107:MeSH_Unique_ID>
