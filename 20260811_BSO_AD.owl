        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010400</IRI>
        <Literal>Cell groups within the internal medullary lamina of the THALAMUS. They include a rostral division comprising the paracentral, central lateral, central dorsal, and central medial nuclei, and a caudal division composed of the centromedian and parafascicular nuclei.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010400</IRI>
        <Literal>Intralaminar Thalamic Nuclei</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
