        <Literal>Potential cavity which separates the ARACHNOID MATER from the DURA MATER.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010496</IRI>
        <Literal>Subdural space</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
