    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021594</IRI>
        <Literal>NPI_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021595</IRI>
        <Literal>Does the patient pace, do things over and over such as opening closets or drawers, or repeatedly pick at things or wind string or threads?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021595</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021596</IRI>
        <Literal>Does the patient do any other activities over and over?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021596</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_10</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021597</IRI>
        <Literal>Does the patient pace around the house without apparent purpose?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021597</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021598</IRI>
        <Literal>Does the patient rummage around opening and unpacking drawers or closets?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021598</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021599</IRI>
        <Literal>Does the patient repeatedly put on and take off clothing?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021599</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021600</IRI>
        <Literal>Does the patient have repetitive activities or &quot;habits&quot; that he/she performs over and over?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021600</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021601</IRI>
        <Literal>Does the patient repeatedly put on and take off clothing?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021601</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021602</IRI>
        <Literal>Does the patient have repetitive activities or &quot;habits&quot; that he/she performs over and over?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021602</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021603</IRI>
        <Literal>Does the patient engage in repetitive activities such as handling buttons, picking, wrapping string, etc?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021603</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021604</IRI>
        <Literal>Does the patient fidget excessively, seem unable to sit still, or bounce his/her feet or tap his/her fingers a lot?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021604</IRI>
        <Literal>NPI_Aberrant_Motor_Behaviour_Question_Item_9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021605</IRI>
        <Literal>Does the patient say things to people that are insensitive or hurt their feelings?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021605</IRI>
        <Literal>NPI_Disinhibition_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021606</IRI>
        <Literal>Does the patient say crude things or make sexual remarks that he/she would not usually have said?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021606</IRI>
        <Literal>NPI_Disinhibition_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021607</IRI>
        <Literal>Does the patient talk openly about very personal or private matters not usually discussed in public?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021607</IRI>
        <Literal>NPI_Disinhibition_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021608</IRI>
        <Literal>Does the patient take liberties or touch or hug others in way that is out of character for him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021608</IRI>
        <Literal>NPI_Disinhibition_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021609</IRI>
        <Literal>Does the patient show any other signs of loss of control of his/her impulses?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021609</IRI>
        <Literal>NPI_Disinhibition_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021610</IRI>
        <Literal>Does the patient describe any other unusual sensory experiences?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021610</IRI>
        <Literal>NPI_Hallucinations_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021611</IRI>
        <Literal>Does the patient appear to feel too good or to be too happy, different from his/her usual self?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021611</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021612</IRI>
        <Literal>Does the patient find humor and laugh at things that others do not find funny?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021612</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021613</IRI>
        <Literal>Does the patient seem to have a childish sense of humor with a tendency to giggle or laugh inappropriately (such as when something unfortunate happens to others)?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021613</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021614</IRI>
        <Literal>Does the patient tell jokes or make remarks that have little humor for others but seem funny to him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021614</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021615</IRI>
        <Literal>Does he/she play childish pranks such as pinching or playing “keep away” for the fun of it?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021615</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021616</IRI>
        <Literal>Does the patient “talk big” or claim to have more abilities or wealth than is true?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021616</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021617</IRI>
        <Literal>Does the patient show any other signs of feeling too good or being too happy?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021617</IRI>
        <Literal>NPI_Elation_Euphoria_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021618</IRI>
        <Literal>Does the patient describe hearing voices or act as if he/she hears voices?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021618</IRI>
        <Literal>NPI_Hallucinations_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021619</IRI>
        <Literal>Does the patient talk to people who are not there?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021619</IRI>
        <Literal>NPI_Hallucinations_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021620</IRI>
        <Literal>Does the patient describe seeing things not seen by others or behave as if he/she is seeing things not seen by others (people, animals, lights, etc.)?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021620</IRI>
        <Literal>NPI_Hallucinations_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021621</IRI>
        <Literal>Does the patient report smelling odors not smelled by others?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021621</IRI>
        <Literal>NPI_Hallucinations_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021622</IRI>
        <Literal>Does the patient describe feeling things on his/her skin or otherwise appear to be feeling things crawling or touching him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021622</IRI>
        <Literal>NPI_Hallucinations_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021623</IRI>
        <Literal>Does the patient describe tastes that are without any known cause?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021623</IRI>
        <Literal>NPI_Hallucinations_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021624</IRI>
        <Literal>Does the patient have a bad temper, flying “off the handle” easily over little things?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021624</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021625</IRI>
        <Literal>Does the patient rapidly change moods from one to another, being fine one minute and angry the next?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021625</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021626</IRI>
        <Literal>Does the patient have sudden flashes of anger?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021626</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021627</IRI>
        <Literal>Is the patient impatient, having trouble coping with delays or waiting for planned activities?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021627</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021628</IRI>
        <Literal>Is the patient cranky and irritable?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021628</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021629</IRI>
        <Literal>Is the patient argumentative and difficult to get along with?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021629</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021630</IRI>
        <Literal>Does the patient show any other signs of irritability?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021630</IRI>
        <Literal>NPI_Irritability_Lability_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021631</IRI>
        <Literal>Does the patient have difficulty sleeping (do not count as present if the patient simply gets up once or twice per night only to go to the bathroom and falls back asleep immediately)? Is he/she up at night? Does he/she wander at night, get dressed, or disturb your sleep?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021631</IRI>
        <Literal>NPI_Presence_of_Aberrant_Motor_Behaviour_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021632</IRI>
        <Literal>Does the patient have periods when he/she refuses to cooperate or won’t let people help him/her? Is he/she hard to handle?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021632</IRI>
        <Literal>NPI_Presence_of_Agitation_Aggression</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021633</IRI>
        <Literal>Is the patient very nervous, worried, or frightened for no apparent reason? Does he/she seem very tense or fidgety? Is the patient afraid to be apart from you?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021633</IRI>
        <Literal>NPI_Presence_of_Anxiety_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021634</IRI>
        <Literal>Does the patient seem sad or depressed? Does he/she say that he/she feels sad or depressed?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021634</IRI>
        <Literal>NPI_Presence_of_Depression_or_Dysphoria_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021635</IRI>
        <Literal>Does the patient seem to act impulsively without thinking? Does he/she do or say things that are not usually done or said in public? Does he/she do things that are embarrassing to you or others?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021635</IRI>
        <Literal>NPI_Presence_of_Disinhibition_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021636</IRI>
        <Literal>Does the patient get upset with those trying to care for him/her or resist activities such as bathing or changing clothes?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021636</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021637</IRI>
        <Literal>Is the patient stubborn, having to have things his/her way?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021637</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021638</IRI>
        <Literal>Is the patient uncooperative, resistive to help from others?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021638</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021639</IRI>
        <Literal>Does the patient have any other behaviors that make him/her hard to handle?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021639</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021640</IRI>
        <Literal>Does the patient shout or curse angrily?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021640</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021641</IRI>
        <Literal>Does the patient slam doors, kick furniture, throw things?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021641</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021642</IRI>
        <Literal>Does the patient attempt to hurt or hit others?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021642</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021643</IRI>
        <Literal>Does the patient have any other aggressive or agitated behaviors?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021643</IRI>
        <Literal>NPI_Agitation_Aggression_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021644</IRI>
        <Literal>Does the patient say that he/she is worried about planned events?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021644</IRI>
        <Literal>NPI_Anxiety_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021645</IRI>
        <Literal>Does the patient have periods of feeling shaky, unable to relax, or feeling excessively tense?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021645</IRI>
        <Literal>NPI_Anxiety_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021646</IRI>
        <Literal>Does the patient have periods of [or complain of] shortness of breath, gasping, or sighing for no apparent reason other than nervousness?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021646</IRI>
        <Literal>NPI_Anxiety_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021647</IRI>
        <Literal>Does the patient complain of butterflies in his/her stomach, or of racing or pounding of the heart in association with nervousness? [Symptoms not explained by ill health]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021647</IRI>
        <Literal>NPI_Anxiety_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021648</IRI>
        <Literal>Does the patient avoid certain places or situations that make him/her more nervous
such as riding in the car, meeting with friends, or being in crowds?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021648</IRI>
        <Literal>NPI_Anxiety_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021649</IRI>
        <Literal>Does the patient become nervous and upset when separated from you [or his/her caregiver]? Does he/she cling to you to keep from being separated?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021649</IRI>
        <Literal>NPI_Anxiety_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021650</IRI>
        <Literal>Does the patient show any other signs of anxiety?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021650</IRI>
        <Literal>NPI_Anxiety_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021651</IRI>
        <Literal>Does the patient seem less spontaneous and less active than usual?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021651</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021652</IRI>
        <Literal>Is the patient less likely to initiate a conversation?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021652</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021653</IRI>
        <Literal>Is the patient less affectionate or lacking in emotions when compared to his/her usual self?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021653</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021654</IRI>
        <Literal>Does the patient contribute less to household chores?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021654</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021655</IRI>
        <Literal>Does the patient seem less interested in the activities and plans of others?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021655</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021656</IRI>
        <Literal>Has the patient lost interest in friends and family members?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021656</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021657</IRI>
        <Literal>Is the patient less enthusiastic about his/her usual interests?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021657</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021658</IRI>
        <Literal>Does the patient show any other signs that he/she doesn’t care about doing new things?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021658</IRI>
        <Literal>NPI_Apathy_Indifference_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021659</IRI>
        <Literal>Does the patient believe that he/she is in danger - that others are planning to hurt him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021659</IRI>
        <Literal>NPI_Delusions_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021660</IRI>
        <Literal>Does the patient believe that others are stealing from him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021660</IRI>
        <Literal>NPI_Delusions_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021661</IRI>
        <Literal>Does the patient believe that his/her spouse is having an affair?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021661</IRI>
        <Literal>NPI_Delusions_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021662</IRI>
        <Literal>Does the patient believe that unwelcome guests are living in his/her house?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021662</IRI>
        <Literal>NPI_Delusions_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021663</IRI>
        <Literal>Does the patient believe that his/her spouse or others are not who they claim to be?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021663</IRI>
        <Literal>NPI_Delusions_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021664</IRI>
        <Literal>Does the patient believe that his/her house is not his/her home?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021664</IRI>
        <Literal>NPI_Delusions_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021665</IRI>
        <Literal>Does the patient believe that family members plan to abandon him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021665</IRI>
        <Literal>NPI_Delusions_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021666</IRI>
        <Literal>Does the patient believe that television or magazine figures are actually present in the home?  [Does he/she try to talk to or interact with them?]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021666</IRI>
        <Literal>NPI_Delusions_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021667</IRI>
        <Literal>Does the patient believe any other unusual things that I haven&apos;t asked about?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021667</IRI>
        <Literal>NPI_Delusions_Question_Item_9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021668</IRI>
        <Literal>Does the patient have periods of tearfulness or sobbing that seem to indicate sadness?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021668</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021669</IRI>
        <Literal>Does the patient say or act as if he/she is sad or in low spirits?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021669</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021670</IRI>
        <Literal>Does the patient put him/herself down or say that he/she feels like a failure?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021670</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021671</IRI>
        <Literal>Does the patient say that he/she is a bad person or deserves to be punished?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021671</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021672</IRI>
        <Literal>Does the patient seem very discouraged or say that he/she has no future?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021672</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021673</IRI>
        <Literal>Does the patient say he/she is a burden to the family or that the family would be better off without him/her?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021673</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021674</IRI>
        <Literal>Does the patient express a wish for death or talk about killing him/herself?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021674</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021675</IRI>
        <Literal>Does the patient show any other signs of depression or sadness?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021675</IRI>
        <Literal>NPI_Depression_Dysphoria_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021676</IRI>
        <Literal>Does the patient act impulsively without appearing to consider the consequences?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021676</IRI>
        <Literal>NPI_Disinhibition_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021677</IRI>
        <Literal>Does the patient talk to total strangers as if he/she knew them?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021677</IRI>
        <Literal>NPI_Disinhibition_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021678</IRI>
        <Literal>Has he/she had a loss of appetite?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021678</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021679</IRI>
        <Literal>Has he/she had an increase in appetite?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021679</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021680</IRI>
        <Literal>Has he/she had a loss of weight?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021680</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021681</IRI>
        <Literal>Has he/she gained weight?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021681</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021682</IRI>
        <Literal>Has he/she had a change in eating behavior such as putting too much food in his/her mouth at once?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021682</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021683</IRI>
        <Literal>Has he/she had a change in the kind of food he/she likes such as eating too many sweets or other specific types of food?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021683</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021684</IRI>
        <Literal>Has he/she developed eating behaviors such as eating exactly the same types of food each day or eating the food in exactly the same order?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021684</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021685</IRI>
        <Literal>Have there been any other changes in appetite or eating that I haven’t asked about?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021685</IRI>
        <Literal>NPI_Eating_Disorders_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021686</IRI>
        <Literal>Has he/she had any change in appetite, weight, or eating habits (count as NA if the patient is incapacitated and has to be fed)? Has there been any change in type of food he/she prefers?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021686</IRI>
        <Literal>NPI_Presence_of_Eating_Disorders_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021687</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021687</IRI>
        <Literal>NPI_Eating_Disorders_Distress_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021688</IRI>
        <Literal>Frequency of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021688</IRI>
        <Literal>NPI_Eating_Disorders_Frequency_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021689</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021689</IRI>
        <Literal>NPI_Eating_Disorders_Severity_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021690</IRI>
        <Literal>Does the patient have difficulty falling asleep?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021690</IRI>
        <Literal>NPI_Sleep_Question_Item_1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021691</IRI>
        <Literal>Does the patient get up during the night (do not count if the patient gets up once or twice per night only to go to the bathroom and falls back asleep immediately)?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021691</IRI>
        <Literal>NPI_Sleep_Question_Item_2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021692</IRI>
        <Literal>Does the patient wander, pace, or get involved in inappropriate activities at night?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021692</IRI>
        <Literal>NPI_Sleep_Question_Item_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021693</IRI>
        <Literal>Does the patient awaken you during the night?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021693</IRI>
        <Literal>NPI_Sleep_Question_Item_4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021694</IRI>
        <Literal>Does the patient awaken at night, dress, and plan to go out thinking that it is morning and time to start the day?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021694</IRI>
        <Literal>NPI_Sleep_Question_Item_5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021695</IRI>
        <Literal>Does the patient awaken too early in the morning (earlier that was his/her habit)?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021695</IRI>
        <Literal>NPI_Sleep_Question_Item_6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021696</IRI>
        <Literal>Does the patient sleep excessively during the day?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021696</IRI>
        <Literal>NPI_Sleep_Question_Item_7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021697</IRI>
        <Literal>Does the patient have any other nighttime behaviors that bother you that we haven&apos;t talked about?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021697</IRI>
        <Literal>NPI_Sleep_Question_Item_8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021698</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021698</IRI>
        <Literal>NPI_Sleep_Distress_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021699</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021699</IRI>
        <Literal>NPI_Sleep_Severity_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021700</IRI>
        <Literal>Frequency x Severity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021700</IRI>
        <Literal>NPI_Sleep_Total_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021701</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021701</IRI>
        <Literal>NPI_Disinhibition_Severity_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021702</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021702</IRI>
        <Literal>NPI_Elation_Euphoria_Distress_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021703</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021703</IRI>
        <Literal>NPI_Hallucinations_Severity_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021704</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021704</IRI>
        <Literal>NPI_Hallucinations_Caregiver_Distress_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021705</IRI>
        <Literal>Frequency of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021705</IRI>
        <Literal>NPI_Hallucinations_Frequency_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021706</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021706</IRI>
        <Literal>NPI_Irritability_Lability_Distress</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021707</IRI>
        <Literal>Frequency of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021707</IRI>
        <Literal>NPI_Irritability_Lability_Frequency</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021708</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021708</IRI>
        <Literal>NPI_Agitation_Aggression_Caregiver_Distress</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021709</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021709</IRI>
        <Literal>NPI_Irritability_Lability_Severity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021710</IRI>
        <Literal>Does the patient have beliefs that you know are not true (for example, insisting that people are trying to harm him/her or steal from him/her)? Has he/she said that family members are not who they say they are or that the house is not their home? I’m not asking about mere suspiciousness; I am interested if the patient is convinced that these things are happening to him/her.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021710</IRI>
        <Literal>NPI_Presence_of_Delusions_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021711</IRI>
        <Literal>Does the patient seem too cheerful or too happy for no reason? I don’t mean the normal happiness that comes from seeing friends, receiving presents, or spending time with family members. I am asking if the patient has a persistent and abnormally good mood or finds humor where others do not.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021711</IRI>
        <Literal>NPI_Presence_of_Elation_Euphoria_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021712</IRI>
        <Literal>Frequency of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021712</IRI>
        <Literal>NPI_Agitation_Aggression_Frequency</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021713</IRI>
        <Literal>Does the patient have hallucinations such as seeing false visions or hearing imaginary voices? Does he/she seem to see, hear or experience things that are not present? By this question we do not mean just mistaken beliefs such as stating that someone who has died is still alive; rather we are asking if the patient actually has abnormal experiences of sounds or visions.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021713</IRI>
        <Literal>NPI_Presence_of_Hallucinations_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021714</IRI>
        <Literal>Does the patient get irritated and easily disturbed? Are his/her moods very changeable? Is he/she abnormally impatient? We do not mean frustration over memory loss or inability to perform usual tasks; we are interested to know if the patient has abnormal irritability, impatience, or rapid emotional changes different from his/her usual self.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021714</IRI>
        <Literal>NPI_Presence_of_Irritability_Lability_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021715</IRI>
        <Literal>Frequency x Severity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021715</IRI>
        <Literal>NPI_Agitation_Aggression_Severity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021716</IRI>
        <Literal>Distress experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021716</IRI>
        <Literal>NPI_Anxiety_Distress_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021717</IRI>
        <Literal>Frequency of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021717</IRI>
        <Literal>NPI_Anxiety_Frequency_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021718</IRI>
        <Literal>Severity of the symptom</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021718</IRI>
        <Literal>NPI_Anxiety_Severity_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021719</IRI>
        <Literal>DISTRESS experienced by Caregiver due to the symptom</Literal>
    </AnnotationAssertion>
