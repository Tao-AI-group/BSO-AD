<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000065">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Birthday_of_Martin_Luther_King,_Jr.</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Honors Martin Luther King, Jr., Civil Rights leader, who was actually born on January 15, 1929; combined with other holidays in several states. First occured 1986.</core:definition>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Third Monday in January</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000066">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inauguration_Day</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First January 20th following a Presidential election</core:definition>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observed only by federal government employees in Washington, D.C., and the border counties of Maryland and Virginia, in order to relieve congestion that occurs with this major event. Swearing-in of President of the United States and Vice President of the United States. Celebrated every fourth year. Note: Takes place on January 21 if the 20th is a Sunday (although the President is still privately inaugurated on the 20th). If Inauguration Day falls on a Saturday, the preceding Friday is not a federal holiday.</core:definition>
</owl:Class>

<owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000067">
  <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
