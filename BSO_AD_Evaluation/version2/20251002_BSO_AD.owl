    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Diseases">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases"/>
        <rdfs:label>Central_Nervous_System_Diseases</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Infections -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Infections">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Diseases"/>
        <rdfs:label>Central_Nervous_System_Infections</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_amygdaloid_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_amygdaloid_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala"/>
        <untitled-ontology-107:Definition>A nucleus located in the caudal half of the amygdala. It is a primary region involved in controlling responses and receives many intrinsic GABAergic amygdaloid connections.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066274</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Central_Amygdaloid_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anatomical_part"/>
        <untitled-ontology-107:Definition>The main information-processing organs of the nervous system, consisting of the brain, spinal cord, and meninges.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002490</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Central_Nervous_System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_Diseases -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_Diseases">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:label>Cerebellar_Diseases</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
        <untitled-ontology-107:Definition>The superficial GRAY MATTER of the CEREBELLUM. It consists of two main layers, the stratum moleculare and the stratum granulosum.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002525</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebellar_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_nuclei -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_nuclei">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
        <untitled-ontology-107:Definition>Four clusters of neurons located deep within the WHITE MATTER of the CEREBELLUM, which are the nucleus dentatus, nucleus emboliformis, nucleus globosus, and nucleus fastigii.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002529</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebellar_Nuclei</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_vermis -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_vermis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellar_cortex"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Purkinje_cell"/>
        <untitled-ontology-107:Definition>A subregion of the CEREBELLAR CORTEX, located along the midsagittal plane of the CEREBELLUM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065814</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebellar_Vermis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellopontine_angle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellopontine_angle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum"/>
        <untitled-ontology-107:Definition>Junction between the cerebellum and the pons.</untitled-ontology-107:Definition>
        <untitled-ontology-107:Location>D002530</untitled-ontology-107:Location>
        <rdfs:label>Cerebellopontine_Angle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebellum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
        <untitled-ontology-107:Definition>The part of brain that lies behind the BRAIN STEM in the posterior base of skull (CRANIAL FOSSA, POSTERIOR). It is also known as the &quot;little brain&quot; with convolutions similar to those of CEREBRAL CORTEX, inner white matter, and deep cerebellar nuclei. Its function is to coordinate voluntary movements, maintain balance, and learn motor skills.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002531</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebellum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum"/>
        <untitled-ontology-107:Definition>The thin layer of GRAY MATTER on the surface of the CEREBRAL HEMISPHERES that develops from the TELENCEPHALON and folds into gyri and sulchi. It reaches its highest development in humans and is responsible for intellectual faculties and higher mental functions.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002540</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebral_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_amyloid_angiopathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_amyloid_angiopathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amyloid_pathology"/>
        <untitled-ontology-107:Definition>A heterogeneous group of sporadic or familial disorders characterized by AMYLOID deposits in the walls of small and medium sized blood vessels of CEREBRAL CORTEX and MENINGES. Clinical features include multiple, small lobar CEREBRAL HEMORRHAGE; cerebral ischemia (BRAIN ISCHEMIA); and CEREBRAL INFARCTION. Cerebral amyloid angiopathy is unrelated to generalized AMYLOIDOSIS. Amyloidogenic peptides in this condition are nearly always the same ones found in ALZHEIMER DISEASE. (from Kumar: Robbins and Cotran: Pathologic Basis of Disease, 7th ed., 2005)

From MSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:Description>CAA is less prominently featured (than SPs and NFTs) when considering AD neuropathologic lesions in part because it is variable in severity among AD patients, though when sought diligently it is identified in an estimated 85–95% of AD brains. CAA results from a process whereby the media of parenchymal arterioles, normally composed of smooth muscle cells (SMCs), undergoes progressive loss of these SMCs and simultaneous accumulation of an eosinophilic hyaline material that has the staining properties of amyloid, that is, positivity for thioflavin S or T and congophilia, with the characteristic yellow-green birefringence (of the congophilic material) when a brain section is viewed under polarized light.

https://doi.org/10.1146/annurev-pathol-020712-163927</untitled-ontology-107:Description>
        <untitled-ontology-107:Synonym>CAA</untitled-ontology-107:Synonym>
        <untitled-ontology-107:UMLS_CUI>C0085220</untitled-ontology-107:UMLS_CUI>
        <rdfs:label>Cerebral_Amyloid_Angiopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_aqueduct -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_aqueduct">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
        <untitled-ontology-107:Definition>Narrow channel in the MESENCEPHALON that connects the third and fourth CEREBRAL VENTRICLES.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002535</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebral_Aqueduct</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_cortical_atrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_cortical_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathology"/>
        <untitled-ontology-107:Definition>Atrophy of the cortex of the cerebrum.

From HPO</untitled-ontology-107:Definition>
        <untitled-ontology-107:UMLS_CUI>C4551583</untitled-ontology-107:UMLS_CUI>
        <rdfs:label>Cerebral_Cortical_Atrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_crus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_crus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle"/>
        <untitled-ontology-107:Definition>Anterior portion of the cerebral peduncle which contains the motor tracts.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065843</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebral_Crus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_endothelial_cell_adhesion_molecule -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_endothelial_cell_adhesion_molecule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Cerebral_Endothelial_Cell_Adhesion_Molecule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon"/>
        <untitled-ontology-107:Definition>Ventral portion of the mesencephalon including the MIDBRAIN TEGMENTUM; CRUS CEREBRI; and the PRETECTUM. It does not include tectum mesencephali and TROCHLEAR NERVE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065850</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebral_Peduncle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain"/>
        <untitled-ontology-107:Definition>Four CSF-filled (see CEREBROSPINAL FLUID) cavities within the cerebral hemispheres (LATERAL VENTRICLES), in the midline (THIRD VENTRICLE) and within the PONS and MEDULLA OBLONGATA (FOURTH VENTRICLE).</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002552</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebral_Ventricle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrovascular_Disorders -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrovascular_Disorders">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:label>Cerebrovascular_Disorders</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
        <untitled-ontology-107:Definition>Derived from TELENCEPHALON, cerebrum is composed of a right and a left hemisphere. Each contains an outer cerebral cortex and a subcortical basal ganglia. The cerebrum includes all parts within the skull except the MEDULLA OBLONGATA, the PONS, and the CEREBELLUM. Cerebral functions include sensorimotor, emotional, and intellectual activities.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D054022</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cerebrum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cervical_cord -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cervical_cord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>The segment of the spinal cord within the CERVICAL VERTEBRAE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066193</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cervical_Cord</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Change_in_episodic_memory -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Change_in_episodic_memory">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Short-term_memory_impairment"/>
        <untitled-ontology-107:Description>Amnestic syndrome: free and cued recall abilities impaired; remembering new information becomes difficult</untitled-ontology-107:Description>
        <rdfs:label>Change_in_Episodic_Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chaperonin_containing_TCP1_subunit_6B -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chaperonin_containing_TCP1_subunit_6B">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Chaperonin_Containing_TCP1_Subunit_6B</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chloride_intracellular_channel_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Chloride_intracellular_channel_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label>Chloride_Intracellular_Channel_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cholesterol_metabolism -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cholesterol_metabolism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathway"/>
