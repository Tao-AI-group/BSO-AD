    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Auditory_Diseases -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Auditory_Diseases">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:label>Central_Auditory_Diseases</rdfs:label>
    </owl:Class>
    


