        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010406</IRI>
        <Literal>A large group of nuclei lying between the internal medullary lamina and the INTERNAL CAPSULE. It includes the ventral anterior, ventral lateral, and ventral posterior nuclei.</Literal>
    </AnnotationAssertion>
