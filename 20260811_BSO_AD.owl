        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010371</IRI>
        <Literal>Middle portion of the hypothalamus containing the arcuate, dorsomedial, ventromedial nuclei, the TUBER CINEREUM and the PITUITARY GLAND.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010371</IRI>
