        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010498</IRI>
        <Literal>D013116</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010498</IRI>
        <Literal>Spinal_Cord</Literal>
