        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010499</IRI>
        <Literal>Region of CENTRAL NERVOUS SYSTEM that appears darker in color than the other type, WHITE MATTER. It is composed of neuronal CELL BODIES; NEUROPIL; GLIAL CELLS and CAPILLARIES but few MYELINATED NERVE FIBERS.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010499</IRI>
        <Literal>Gray Matter</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#UMLS_CUI"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010499</IRI>
        <Literal>C0018220</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
