    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cochlear_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cochlear_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
        <untitled-ontology-107:Definition>The brain stem nucleus that receives the central input from the cochlear nerve. The cochlear nucleus is located lateral and dorsolateral to the inferior cerebellar peduncles and is functionally divided into dorsal and ventral parts. It is tonotopically organized, performs the first stage of central auditory processing, and projects (directly or indirectly) to higher auditory areas including the superior olivary nuclei, the medial geniculi, the inferior colliculi, and the auditory cortex.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D017626</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cochlear_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cognitive_dysfunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cognitive_dysfunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
        <untitled-ontology-107:Definition>Diminished or impaired mental and/or intellectual function.</untitled-ontology-107:Definition>
        <untitled-ontology-107:Synonym>Cognitive decline</untitled-ontology-107:Synonym>
        <Gene:Locus_MIM_number>D060825</Gene:Locus_MIM_number>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cognitive_Dysfunction</rdfs:label>
    </owl:Class>
    


