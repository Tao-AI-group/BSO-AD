        <rdfs:comment>Errors occurring because the participant failed to draw a connecting line to a given circle in the correct sequence</rdfs:comment>
        <rdfs:label>NB_Trail_Making_Test_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NB_TrailMakingTestAItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NB_TrailMakingTestAItem_3">
