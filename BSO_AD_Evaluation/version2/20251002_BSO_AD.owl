                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient act impulsively without appearing to consider the consequences?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_2 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_2">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient talk to total strangers as if he/she knew them?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say things to people that are insensitive or hurt their feelings?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say crude things or make sexual remarks that he/she would not usually have said?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient talk openly about very personal or private matters not usually discussed in public?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient take liberties or touch or hug others in way that is out of character for him/her?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DisinhibitionQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient show any other signs of loss of control of his/her impulses?</rdfs:comment>
        <rdfs:label>NPI_Disinhibition_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DisinhibitionSeverityItem -->

