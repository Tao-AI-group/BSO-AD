        <untitled-ontology-107:MeSH_Unique_ID>D065823</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Parabrachial_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parahippocampal_gyrus -->

