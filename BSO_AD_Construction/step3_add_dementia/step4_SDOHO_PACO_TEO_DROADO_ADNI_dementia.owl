  <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000016"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">before</rdfs:label>
  <core:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"prior to"</core:altLabel>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interval relation. The source event ended before the start of the target event. It is the same as the point relation "endBeforeStart".</core:definition>
</owl:ObjectProperty>

