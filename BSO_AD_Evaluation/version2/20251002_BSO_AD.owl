    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_callosum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_callosum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalic_commissure"/>
        <untitled-ontology-107:Definition>Broad plate of dense myelinated fibers that reciprocally interconnect regions of the cortex in all lobes with corresponding regions of the opposite hemisphere. The corpus callosum is located deep in the longitudinal fissure.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D003337</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Corpus_Callosum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_striatum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_striatum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia"/>
        <untitled-ontology-107:Definition>Striped GRAY MATTER and WHITE MATTER consisting of the NEOSTRIATUM and paleostriatum (GLOBUS PALLIDUS). It is located in front of and lateral to the THALAMUS in each cerebral hemisphere. The gray substance is made up of the CAUDATE NUCLEUS and the lentiform nucleus (the latter consisting of the GLOBUS PALLIDUS and PUTAMEN). The WHITE MATTER is the INTERNAL CAPSULE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D003342</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Corpus_Striatum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corticomedial_nuclear_complex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corticomedial_nuclear_complex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala"/>
        <untitled-ontology-107:Definition>The rostral part of the amygdala with cortical-like layered structure. It receives major inputs from the OLFACTORY BULB and PIRIFORM CORTEX.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066276</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Corticomedial_Nuclear_Complex</rdfs:label>
    </owl:Class>
    


