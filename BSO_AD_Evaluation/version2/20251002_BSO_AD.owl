        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala"/>
        <untitled-ontology-107:Definition>A set of amygdalar nuclei bordered laterally by the EXTERNAL CAPSULE and medially by the CENTRAL AMYGDALOID NUCLEUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066272</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Basolateral_Nuclear_Complex</rdfs:label>
    </owl:Class>
    


