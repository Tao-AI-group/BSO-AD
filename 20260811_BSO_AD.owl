        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010492</IRI>
        <Literal>A delicate membrane enveloping the brain and spinal cord. It lies between the PIA MATER and the DURA MATER. It is separated from the pia mater by the subarachnoid cavity which is filled with CEREBROSPINAL FLUID.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010492</IRI>
        <Literal>Arachnoid</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#UMLS_CUI"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010492</IRI>
        <Literal>C0003707</Literal>
