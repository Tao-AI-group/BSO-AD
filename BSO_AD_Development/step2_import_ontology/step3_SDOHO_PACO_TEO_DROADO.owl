    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Physical_difficulty -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Physical_difficulty">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical_Difficulty</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pia_mater -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pia_mater">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge"/>
        <untitled-ontology-107:Definition>The innermost layer of the three meninges covering the brain and spinal cord. It is the fine vascular membrane that lies under the ARACHNOID and the DURA MATER.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D010841</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pia_Mater</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pigment_metabolic_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pigment_metabolic_process">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pigment_Metabolic_Process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pineal_gland -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pineal_gland">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Epithalamus"/>
        <untitled-ontology-107:Definition>A light-sensitive neuroendocrine organ attached to the roof of the THIRD VENTRICLE of the brain. The pineal gland secretes MELATONIN, other BIOGENIC AMINES and NEUROPEPTIDES.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D010870</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pineal_Gland</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Piperidine -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Piperidine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_chemical_structure"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Piperidine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Piriform_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Piriform_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex"/>
        <untitled-ontology-107:Definition>An area of the olfactory cortex comprising the rostral half of the uncus of the PARAHIPPOCAMPAL GYRUS and the anterior PARAHIPPOCAMPAL GYRUS. It receives major afferents directly from the OLFACTORY BULB.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066195</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Piriform_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamo-hypophyseal_system"/>
        <untitled-ontology-107:Definition>A small, unpaired gland situated in the SELLA TURCICA. It is connected to the HYPOTHALAMUS by a short stalk which is called the INFUNDIBULUM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D010902</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pituitary_Gland</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plasmolipin -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plasmolipin">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plasmolipin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Platelet_activating_factor_acetylhydrolase_1b_catalytic_subunit_3 -->

