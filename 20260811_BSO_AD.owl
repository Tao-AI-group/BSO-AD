        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010373</IRI>
        <Literal>D004302</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010373</IRI>
        <Literal>Dorsomedial_Hypothalamic_Nucleus</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010373</IRI>
        <Literal>An aggregation of cells in the middle hypothalamus dorsal to the ventromedial nucleus and bordering the THIRD VENTRICLE.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
