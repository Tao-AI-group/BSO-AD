  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Part of the DIENCEPHALON inferior to the caudal end of the dorsal THALAMUS. Includes the lateral geniculate body which relays visual impulses from the OPTIC TRACT to the calcarine cortex, and the medial geniculate body which relays auditory impulses from the lateral lemniscus to the AUDITORY CORTEX.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D005829</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geniculate_Body</rdfs:label>
</owl:Class>

