    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intralaminar_thalamic_nuclei -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intralaminar_thalamic_nuclei">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
        <untitled-ontology-107:Definition>Cell groups within the internal medullary lamina of the THALAMUS. They include a rostral division comprising the paracentral, central lateral, central dorsal, and central medial nuclei, and a caudal division composed of the centromedian and parafascicular nuclei.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020646</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intralaminar_Thalamic_Nuclei</rdfs:label>
    </owl:Class>
    


