<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_callosum">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalic_commissure"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Broad plate of dense myelinated fibers that reciprocally interconnect regions of the cortex in all lobes with corresponding regions of the opposite hemisphere. The corpus callosum is located deep in the longitudinal fissure.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D003337</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corpus_Callosum</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corpus_striatum">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Striped GRAY MATTER and WHITE MATTER consisting of the NEOSTRIATUM and paleostriatum (GLOBUS PALLIDUS). It is located in front of and lateral to the THALAMUS in each cerebral hemisphere. The gray substance is made up of the CAUDATE NUCLEUS and the lentiform nucleus (the latter consisting of the GLOBUS PALLIDUS and PUTAMEN). The WHITE MATTER is the INTERNAL CAPSULE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D003342</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corpus_Striatum</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corticomedial_nuclear_complex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Amygdala"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The rostral part of the amygdala with cortical-like layered structure. It receives major inputs from the OLFACTORY BULB and PIRIFORM CORTEX.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066276</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corticomedial_Nuclear_Complex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corticotroph">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior pituitary cells that produce ADRENOCORTICOTROPHIC HORMONE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D052680</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Corticotroph</rdfs:label>
</owl:Class>

