    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intermediate_pituitary_gland -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intermediate_pituitary_gland">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland"/>
        <untitled-ontology-107:Definition>The intermediate lobe of the pituitary gland. It shows considerable size variation among the species, small in humans, and large in amphibians and lower vertebrates. This lobe produces mainly MELANOCYTE-STIMULATING HORMONES and other peptides from post-translational processing of pro-opiomelanocortin (POMC).</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052716</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Pituitary gland, intermediate</untitled-ontology-107:Synonym>
        <rdfs:label>Intermediate_Pituitary_Gland</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Internal_capsule -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Internal_capsule">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
        <untitled-ontology-107:Definition>WHITE MATTER pathway, flanked by nuclear masses, consisting of both afferent and efferent fibers projecting between the WHITE MATTER and the BRAINSTEM. It consists of three distinct parts: an anterior limb, posterior limb, and genu.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020772</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Internal_Capsule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Intracranial_Hypertension -->

