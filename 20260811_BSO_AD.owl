        <Literal>Alzheimer_Disease_Familial_Type_3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#06010594</IRI>
        <Literal>Alzheimer&apos;s disease with an early onset (starts before the age of 65). It is caused by mutations in the PSEN1 gene.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
