<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Islands_of_calleja">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_tubercle"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aggregations of GRANULE CELLS in the dorsal aspect of the OLFACTORY TUBERCLE and within the Island of Calleja Magna that lies between the BRAIN SEPTUM and the NUCLEUS ACCUMBENS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020670</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Islands_of_Calleja</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_tubercle">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Ventral_striatum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Region in the ventral TELENCEPHALON located anterior to the OPTIC CHIASM, posterior to the OLFACTORY PEDUNCLE, rostral to the PIRIFORM AREA and ventral to the NUCLEUS ACCUMBENS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066208</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactory_Tubercle</rdfs:label>
</owl:Class>

