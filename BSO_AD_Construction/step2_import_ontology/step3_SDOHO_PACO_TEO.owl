    <!-- https://github.com/Tao-AI-group/BSO_AD#00027 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00027">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00000"/>
