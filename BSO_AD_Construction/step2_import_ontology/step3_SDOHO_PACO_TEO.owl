    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000021 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000021">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">New_Year&apos;s_Day</rdfs:label>
