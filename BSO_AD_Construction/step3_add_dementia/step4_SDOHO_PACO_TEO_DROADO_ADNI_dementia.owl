<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dementia_due_to_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Stage"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National Institute on Aging - Alzheimer Association (NIA-AA) criteria: the presence of dementia determined by intra-individual decline in cognition and function, insidious onset and progressive cognitive decline, impairment in two or more cognitive domains, and absence of prominent features associated with other dementing disorders

International Working Group (IWG) criteria: indicates that episodic memory loss and other cognitive symptoms are sufficient to interfere with the usual performance of IADL</unti:Definition>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Noticeable memory, thinking, and behavioral symptoms that impair person’s ability to function in daily life</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dementia_Due_to_AD</rdfs:label>
</owl:Class>

