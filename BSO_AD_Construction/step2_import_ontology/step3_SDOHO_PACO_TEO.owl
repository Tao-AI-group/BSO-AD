        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject or patient has been admitted as an outpatient to an emergency room. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C5447170</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C5447170</UMLS_CUI>
