    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memory_impairment -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Memory_impairment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
        <rdfs:label>Memory_Impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system"/>
        <untitled-ontology-107:Definition>The three membranes that cover the BRAIN and the SPINAL CORD. They are the dura mater, the arachnoid, and the pia mater.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008578</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Meninge</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meningitis -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meningitis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_Nervous_System_Diseases"/>
        <rdfs:label>Meningitis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mesencephalon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
        <untitled-ontology-107:Definition>The middle of the three primitive cerebral vesicles of the embryonic brain. Without further subdivision, midbrain develops into a short, constricted portion connecting the PONS and the DIENCEPHALON. Midbrain contains two major parts, the dorsal TECTUM MESENCEPHALI and the ventral TEGMENTUM MESENCEPHALI, housing components of auditory, visual, and other sensorimoter systems.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008636</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Mesencephalon</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_Brain_Diseases -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_Brain_Diseases">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:label>Metabolic_Brain_Diseases</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_drug -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_drug">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
        <rdfs:label>Metabolic_Drug</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Biological_process"/>
        <rdfs:label>Metabolic_Process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metencephalon">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Rhombencephalon"/>
        <untitled-ontology-107:Definition>The anterior portion of the developing hindbrain. It gives rise to the CEREBELLUM and the PONS.</untitled-ontology-107:Definition>
