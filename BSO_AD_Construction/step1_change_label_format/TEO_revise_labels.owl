        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Birthday_of_Martin_Luther_King,_Jr.</rdfs:label>
        <skos:definition>Honors Martin Luther King, Jr., Civil Rights leader, who was actually born on January 15, 1929; combined with other holidays in several states. First occured 1986.</skos:definition>
        <skos:definition>Third Monday in January</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000066 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000066">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000017"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inauguration_Day</rdfs:label>
        <skos:definition>First January 20th following a Presidential election</skos:definition>
        <skos:definition>Observed only by federal government employees in Washington, D.C., and the border counties of Maryland and Virginia, in order to relieve congestion that occurs with this major event. Swearing-in of President of the United States and Vice President of the United States. Celebrated every fourth year. Note: Takes place on January 21 if the 20th is a Sunday (although the President is still privately inaugurated on the 20th). If Inauguration Day falls on a Saturday, the preceding Friday is not a federal holiday.</skos:definition>
    </owl:Class>
    


