<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#High_vocal_center">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neostriatum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus in the NEOSTRIATUM of bird brains that sends signals for song production and receives auditory input. In some adult SONGBIRDS, research has shown that the size of this nucleus changes seasonally and that it exhibits neurogenesis.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D053400</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High_Vocal_Center</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA1_region">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of four subsections of the hippocampus described by Lorente de No, located furthest from the DENTATE GYRUS.</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D056547</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA1_region,_hippocampal</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA1_Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA2_region">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA1 FIELD and the HIPPOCAMPUS CA3 FIELD.</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D056651</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA2_region,_hippocampal</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA2_Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA3_region">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA2 FIELD and the DENTATE GYRUS.</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D056654</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CA3_region,_hippocampal</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA3_Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_mossy_fibers">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dentate_gyrus"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Axons of certain cells in the DENTATE GYRUS. They project to the polymorphic layer of the dentate gyrus and to the proximal dendrites of PYRAMIDAL CELLS of the HIPPOCAMPUS. These mossy fibers should not be confused with mossy fibers that are cerebellar afferents (see NERVE FIBERS).</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D019599</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mossy_Fibers,_Hippocampal</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_Mossy_Fibers</rdfs:label>
</owl:Class>

