        <untitled-ontology-107:Definition>Nucleus in the anterior part of the HYPOTHALAMUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D010286</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Paraventricular_Hypothalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parietal_lobe -->

