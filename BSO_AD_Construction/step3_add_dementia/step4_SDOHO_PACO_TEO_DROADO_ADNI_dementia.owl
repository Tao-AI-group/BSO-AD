<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Choroid_plexus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A villous structure of tangled masses of BLOOD VESSELS contained within the third, lateral, and fourth ventricles of the BRAIN. It regulates part of the production and composition of CEREBROSPINAL FLUID.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D002831</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Choroid_Plexus</rdfs:label>
</owl:Class>

