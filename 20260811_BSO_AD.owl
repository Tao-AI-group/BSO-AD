            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#07020980</IRI>
        <Literal>The aggregate of social and cultural institutions, forms, patterns, and processes that influence the life of an individual or community. (MSH)
 Involving a combination of social and environmental factors. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037414</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>#07020980</IRI>
        <Literal>Social Environment</Literal>
    </AnnotationAssertion>
