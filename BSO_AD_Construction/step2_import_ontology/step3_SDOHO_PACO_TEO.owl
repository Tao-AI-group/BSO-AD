    <!-- https://github.com/Tao-AI-group/BSO_AD#00008 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00008">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00000"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gender</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Socially-constructed identity of male or female. (MSH)
 The assemblage of properties that distinguish people on the basis of the societal roles expected for the two sexes. (NCI)
 Subject self-identification re: masculine/feminine. [IOM] See also sex. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C0079399</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0079399</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Attribute</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00009 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00009">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00008"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHENX</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biological_Sex</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The totality of characteristics of reproductive structure, functions, PHENOTYPE, and GENOTYPE, differentiating the MALE from the FEMALE organism. (MSH)
 The assemblage of physical properties or qualities by which male is distinguished from female; the physical difference between male and female; the distinguishing peculiarity of male or female. (NCI)
 Phenotypic expression of chromosomal makeup that defines a study subject as male, female, or other. Compare to gender. (NCI)
 The biologic character or quality that distinguishes male and female from one another as expressed by analysis of the person&apos;s gonadal, morphologic (internal and external), chromosomal, and hormonal characteristics. (NCI)
 Conceptually broad term referring to the structural, functional, or behavioral characteristics of males and females of a given species. Use a more specific term if possible. For comparisons of the sexes use HUMAN SEX DIFFERENCES or ANIMAL SEX DIFFERENCES. (PSY)
 Totality of characteristics of reproductive structure, functions, phenotype, and genotype, differentiating the male from the female organism; do not confuse with the act of sex, which is indexed with SEX BEHAVIOR. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C1522384</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1522384</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Attribute</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00010 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00010">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00009"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Female</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person who belongs to the sex that normally produces ova. The term is used to indicate biological sex distinctions, or cultural gender role distinctions, or both. (NCI) (NCI)
 A person who belongs to the sex that normally produces ova. The term is used to indicate biological sex distinctions, or cultural gender role distinctions, or both. (NCI)
 An individual who reports belonging to the cultural gender role distinction of female. (NCI)
 Female
 (HL7V3.0)
 Use in conjunction with a disease, disorder, dysfunction, body system, or function which is gender specific. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0086287</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0086287</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Attribute</UMLS_Semantic_Type>
    </owl:Class>
    


