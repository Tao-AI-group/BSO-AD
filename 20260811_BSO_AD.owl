    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#08021738</IRI>
        <Literal>Does the patient awaken you during the night, rise too early in the morning, or take excessive naps during the day?</Literal>
