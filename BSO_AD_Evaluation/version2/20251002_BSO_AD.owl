    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#eventDate -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#eventDate"/>
    


    <!-- http://www.modiag.it#gender -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#gender">
        <www:valuesMeaning xml:lang="en">1=Male; 2=Female</www:valuesMeaning>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#handedness -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#handedness">
        <www:valuesMeaning xml:lang="en">1=Right;2=Left</www:valuesMeaning>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#homeType -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#homeType">
        <www:valuesMeaning xml:lang="en">1=House;2=Condo/Co-op (owned);3=Apartment (rented);4=Mobile Home;5=Retirement Community;6=Assisted Living;7=Skilled Nursing Facility;8=Other (specify)</www:valuesMeaning>
        <rdfs:comment xml:lang="en">Type of Participant residence</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#itemAnswer -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#itemAnswer">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#itemScore -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#itemScore">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#maritalStatus -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#maritalStatus">
        <www:valuesMeaning xml:lang="en">1=Married; 2=Widowed; 3=Divorced; 4=Never married; 5=Unknown</www:valuesMeaning>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#mmse_attentionAndCalculation -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#mmse_attentionAndCalculation">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#summedScore"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#monthOfBirth -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#monthOfBirth"/>
    


    <!-- http://www.modiag.it#neurologicalFinding -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#neurologicalFinding"/>
    


    <!-- http://www.modiag.it#primaryOccupation -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#primaryOccupation">
        <rdfs:comment xml:lang="en">Primary occupation during most of adult life</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#recallItemList -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#recallItemList">
        <www:valuesMeaning xml:lang="en">&quot;1&quot; stands for the list (Ball; Flag; Tree);
&quot;2&quot; stands for the list (Apple; Penny; Table).</www:valuesMeaning>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#recentOccupation -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#recentOccupation">
        <rdfs:comment xml:lang="en">Most recent occupation</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#retired -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#retired">
        <www:valuesMeaning xml:lang="en">1=Yes;0=No;2=Not Applicable</www:valuesMeaning>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#retirementDate -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#retirementDate"/>
    


    <!-- http://www.modiag.it#significantAuditoryImpairment -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#significantAuditoryImpairment">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#neurologicalFinding"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#significantVisualImpairment -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#significantVisualImpairment">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#neurologicalFinding"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#summedScore -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#summedScore">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
        <rdfs:comment xml:lang="en">A score that is the sum of single items scores</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#totalScore -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#totalScore">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#summedScore"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#unableToCompleteWhy -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#unableToCompleteWhy">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#assessmentInfo"/>
        <rdfs:comment xml:lang="en">Why the participant is unable to complete the test based on the clinician&apos;s best judgement. </rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#verbatimAnswer -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#verbatimAnswer">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemAnswer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#yearOfBirth -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#yearOfBirth"/>
    


    <!-- http://www.modiag.it#yesNoAnswer -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#yesNoAnswer">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemAnswer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#0_05_1_2_3_CDR_score -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#0_05_1_2_3_CDR_score">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment xml:lang="en">0 = None; 0.5 = Questionable; 1 = Mild; 2 = Moderate; 3 = Severe</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#0_1_2_3_4_5_NPI_score -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_4_5_NPI_score">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment>0 :Not distressing at all;  1: Minimal; 2:Mild; 3 : Moderate; 4 : Severe 5 :Extreme or Very Severe</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#0_1_2_3_NPIQ_score -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_NPIQ_score">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment>0 = None (not present) 1 = Mild (noticeable, but not a significant change) 2 = Moderate (significant, but not a dramatic change) 3 = Severe (very marked or prominent, a dramatic change)</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#0_1_2_3_score -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_2_3_score">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#0_1_score -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#0_1_score">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment xml:lang="en">0 = Wrong; 1 = Right</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#1_2_3_4_NPI_score_3 -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#1_2_3_4_NPI_score_3">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment>1: Occasionally; 2: Often; 3: Frequently; 4: Very frequently</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.modiag.it#1_2_3_NPI_score_2 -->

    <owl:DatatypeProperty rdf:about="http://www.modiag.it#1_2_3_NPI_score_2">
        <rdfs:subPropertyOf rdf:resource="http://www.modiag.it#itemScore"/>
        <rdfs:comment>1: Mild; 2: Moderate; 3: Marked</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#hasTotalAmountMin -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#hasTotalAmountMin">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hyk038/ontologies/2018/7/untitled-ontology-17#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#D_00000 -->

    <owl:DatatypeProperty rdf:about="https://github.com/Tao-AI-group/BSO_AD#D_00000">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>hasNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]*+[:]+[0-9]*+[:]+[0-9]*</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label>hasNormalizedTime</rdfs:label>
        <skos:definition>use to represent the normalized view of the time expression of the given instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:label>hasOrigTime</rdfs:label>
        <skos:definition>use to represent the original  time expression of the instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:comment>describe the granularity of a temporal element</rdfs:comment>
        <rdfs:label>hasGranularity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:comment>describe the unit of a duration</rdfs:comment>
        <rdfs:label>hasDurationUnit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>hasDurationValue</rdfs:label>
        <skos:definition>capture the value of a duration, e.g., in &quot;2 hours&quot;, 2 is the duation value and hour is the duation unit</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>([0-9]*+(\.[0-9]*)?+[Y])?([0-9]*+(\.[0-9]*)?+[M])?([0-9]*+(\.[0-9]*)?+[W])?([0-9]*+(\.[0-9]*)?+[D])?([0-9]*+(\.[0-9]*)?+[H])?([0-9]*+(\.[0-9]*)?+[m])?([0-9]*+(\.[0-9]*)?+[s])?</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label>hasDurationPattern</rdfs:label>
        <skos:definition>In the form of &quot;4Y5M3W0D0H0m0s&quot;.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161">
        <rdfs:label>hasApproximation</rdfs:label>
        <skos:definition>covering expressions of how the world might be and should be. This includes expressions of necessity, permissibility and probability, and negations of these</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177">
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasDurationOriginForm</rdfs:label>
        <skos:definition>capture the orign form of the duration string</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178">
        <rdfs:label>hasRepeatTimes</rdfs:label>
        <skos:definition>Describe the number of units that re-occur in a TimePhase</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179">
        <rdfs:label>hasSeverity</rdfs:label>
        <skos:definition>to declare the severity of a lab test or symptom</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasDescription</rdfs:label>
        <skos:definition>add the detailed description to the event</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212">
        <rdfs:label>hasAgeValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ifomis.org/bfo/1.1/span#TimeInstant -->

    <owl:Class rdf:about="http://www.ifomis.org/bfo/1.1/span#TimeInstant">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#Time"/>
        <rdfs:label>Time_Instant</rdfs:label>
        <skos:altLabel>Time Instant</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.ifomis.org/bfo/1.1/span#TimeInterval -->

    <owl:Class rdf:about="http://www.ifomis.org/bfo/1.1/span#TimeInterval">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#Time"/>
        <rdfs:label>Time_Interval</rdfs:label>
        <skos:altLabel>Time Interval</skos:altLabel>
    </owl:Class>
    


    <!-- http://www.modiag.it#ADAS -->

    <owl:Class rdf:about="http://www.modiag.it#ADAS">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#CognitiveAssessment"/>
        <rdfs:label>Alzheimer’s_Disease_Assessment_Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#APOEGenotyping -->

    <owl:Class rdf:about="http://www.modiag.it#APOEGenotyping">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#Genotyping"/>
        <rdfs:label>Apolipoprotein_E_Genotyping</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#AttentionAndCalculationItem -->

    <owl:Class rdf:about="http://www.modiag.it#AttentionAndCalculationItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#SAItemByEvaluatedFeature"/>
        <rdfs:label>Attention_and_Calculation_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#BehaviouralAssessment -->

    <owl:Class rdf:about="http://www.modiag.it#BehaviouralAssessment">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#NeuropshychologicalAssessment"/>
        <rdfs:label>Behavioural_Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CCI -->

    <owl:Class rdf:about="http://www.modiag.it#CCI">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#CognitiveAssessment"/>
        <rdfs:label>Cognitive_Change_Index</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR -->

    <owl:Class rdf:about="http://www.modiag.it#CDR">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#CognitiveAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.modiag.it#hasAssessmentItem"/>
                <owl:allValuesFrom rdf:resource="http://www.modiag.it#CDRItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Clinical_Dementia_Rating_Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDRItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDRItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#SAItemByTest"/>
        <owl:disjointWith rdf:resource="http://www.modiag.it#MMSEItem"/>
        <rdfs:label>CDR_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_CommunityAffairsItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_CommunityAffairsItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Independent function at activities such as job, shopping, volunteer and social groups</rdfs:comment>
        <rdfs:label>CDR_Community_Affairs_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_HomeAndHobbiesItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_HomeAndHobbiesItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Maintainance of life at home, hobbies and intellectual interests </rdfs:comment>
        <rdfs:label>CDR_Home_and_Hobbies_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_JudgementAndProblemSolvingItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_JudgementAndProblemSolvingItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Impairment in solving problems and social judgment</rdfs:comment>
        <rdfs:label>CDR_Judgement_and_Problem_Solving_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_MemoryItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_MemoryItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#MemoryItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Memory loss</rdfs:comment>
        <rdfs:label>CDR_Memory_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_OrientationItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_OrientationItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#OrientationItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Difficulty with time relationship and space</rdfs:comment>
        <rdfs:label>CDR_Orientation_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CDR_PersonalCareItem -->

    <owl:Class rdf:about="http://www.modiag.it#CDR_PersonalCareItem">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#CDRItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#DailyFunctioningItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#ScoringItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Capacity of self-care</rdfs:comment>
        <rdfs:label>CDR_Personal_Care_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#CheckItem -->

    <owl:Class rdf:about="http://www.modiag.it#CheckItem">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#EvaluationItem"/>
        <rdfs:label>Check_Item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#ClinicalExam -->

    <owl:Class rdf:about="http://www.modiag.it#ClinicalExam">
        <rdfs:subClassOf rdf:resource="http://www.modiag.it#Examination"/>
        <rdfs:label>Clinical_Exam</rdfs:label>
    </owl:Class>
    


