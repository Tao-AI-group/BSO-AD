    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000042 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000042">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Monday</rdfs:label>
        <skos:definition>The first day of a calendar week starting from Monday. Monday is after Sunday and before Tuesday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000043 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000043">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tuesday</rdfs:label>
        <skos:definition>The second day of a calendar week starting from Monday. Tuesday is after Monday and before Wednesday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000045 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000045">
