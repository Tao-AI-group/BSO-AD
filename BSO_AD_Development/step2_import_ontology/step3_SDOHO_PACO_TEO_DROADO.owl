        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Early childhood, which spans the period up to 8 years of age, is critical for cognitive, social, emotional and physical development. 
 https://data.unicef.org/topic/early-childhood-development/overview/#:~:text=Early%20childhood%2C%20which%20spans%20the,social%2C%20emotional%20and%20physical%20development.</skos:definition>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00176 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00176">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00172"/>
