        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]*+[:]+[0-9]*+[:]+[0-9]*</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasNormalizedTime</rdfs:label>
        <skos:definition>use to represent the normalized view of the time expression of the given instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000015"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasOrigTime</rdfs:label>
        <skos:definition>use to represent the original  time expression of the instant</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:comment>describe the granularity of a temporal element</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000040">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:comment>describe the unit of a duration</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationUnit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000041">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationValue</rdfs:label>
        <skos:definition>capture the value of a duration, e.g., in &quot;2 hours&quot;, 2 is the duation value and hour is the duation unit</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000144">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>([0-9]*+(\.[0-9]*)?+[Y])?([0-9]*+(\.[0-9]*)?+[M])?([0-9]*+(\.[0-9]*)?+[W])?([0-9]*+(\.[0-9]*)?+[D])?([0-9]*+(\.[0-9]*)?+[H])?([0-9]*+(\.[0-9]*)?+[m])?([0-9]*+(\.[0-9]*)?+[s])?</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationPattern</rdfs:label>
        <skos:definition>In the form of &quot;4Y5M3W0D0H0m0s&quot;.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000161">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasApproximation</rdfs:label>
        <skos:definition>covering expressions of how the world might be and should be. This includes expressions of necessity, permissibility and probability, and negations of these</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000177">
        <rdfs:domain rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000032"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDurationOriginForm</rdfs:label>
        <skos:definition>capture the orign form of the duration string</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000178">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasRepeatTimes</rdfs:label>
        <skos:definition>Describe the number of units that re-occur in a TimePhase</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000179">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasSeverity</rdfs:label>
        <skos:definition>to declare the severity of a lab test or symptom</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000206">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasDescription</rdfs:label>
        <skos:definition>add the detailed description to the event</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212 -->

    <owl:DatatypeProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000212">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasAgeValue</rdfs:label>
    </owl:DatatypeProperty>
    


