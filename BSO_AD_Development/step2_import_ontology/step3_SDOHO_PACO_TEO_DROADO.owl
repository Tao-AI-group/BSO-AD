    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#High_vocal_center -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#High_vocal_center">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neostriatum"/>
        <untitled-ontology-107:Definition>Nucleus in the NEOSTRIATUM of bird brains that sends signals for song production and receives auditory input. In some adult SONGBIRDS, research has shown that the size of this nucleus changes seasonally and that it exhibits neurogenesis.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D053400</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High_Vocal_Center</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA1_region -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA1_region">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
        <untitled-ontology-107:Description>One of four subsections of the hippocampus described by Lorente de No, located furthest from the DENTATE GYRUS.</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D056547</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>CA1_region,_hippocampal</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA1_Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA2_region -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA2_region">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
        <untitled-ontology-107:Description>A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA1 FIELD and the HIPPOCAMPUS CA3 FIELD.</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D056651</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>CA2_region,_hippocampal</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA2_Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA3_region -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_CA3_region">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus"/>
        <untitled-ontology-107:Description>A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA2 FIELD and the DENTATE GYRUS.</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D056654</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>CA3_region,_hippocampal</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_CA3_Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_mossy_fibers -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_mossy_fibers">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dentate_gyrus"/>
        <untitled-ontology-107:Description>Axons of certain cells in the DENTATE GYRUS. They project to the polymorphic layer of the dentate gyrus and to the proximal dendrites of PYRAMIDAL CELLS of the HIPPOCAMPUS. These mossy fibers should not be confused with mossy fibers that are cerebellar afferents (see NERVE FIBERS).</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D019599</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Mossy_Fibers,_Hippocampal</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_Mossy_Fibers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_synaptic_function -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampal_synaptic_function">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathway"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampal_Synaptic_Function</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hippocampus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
        <untitled-ontology-107:Definition>A curved elevation of GRAY MATTER extending the entire length of the floor of the TEMPORAL HORN of the LATERAL VENTRICLE (see also TEMPORAL LOBE). The hippocampus proper, subiculum, and DENTATE GYRUS constitute the hippocampal formation. Sometimes authors include the ENTORHINAL CORTEX in the hippocampal formation.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D006624</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hippocampus</rdfs:label>
    </owl:Class>
    


