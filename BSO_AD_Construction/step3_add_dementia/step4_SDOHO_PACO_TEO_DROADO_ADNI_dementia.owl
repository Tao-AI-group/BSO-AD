  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clusterin</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cochlear_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The brain stem nucleus that receives the central input from the cochlear nerve. The cochlear nucleus is located lateral and dorsolateral to the inferior cerebellar peduncles and is functionally divided into dorsal and ventral parts. It is tonotopically organized, performs the first stage of central auditory processing, and projects (directly or indirectly) to higher auditory areas including the superior olivary nuclei, the medial geniculi, the inferior colliculi, and the auditory cortex.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D017626</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cochlear_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cognitive_dysfunction">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diminished or impaired mental and/or intellectual function.</unti:Definition>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cognitive decline</unti:Synonym>
  <unti2:Locus_MIM_number rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D060825</unti2:Locus_MIM_number>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cognitive_Dysfunction</rdfs:label>
</owl:Class>

