        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say or act as if he/she is sad or in low spirits?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_3 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_3">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient put him/herself down or say that he/she feels like a failure?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_4 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_4">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say that he/she is a bad person or deserves to be punished?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_5">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient seem very discouraged or say that he/she has no future?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_6 -->

