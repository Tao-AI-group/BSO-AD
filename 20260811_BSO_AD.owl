            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#07020989</IRI>
        <Literal>The unfair treatment of a person or group based on class or category bias. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C2987623</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
