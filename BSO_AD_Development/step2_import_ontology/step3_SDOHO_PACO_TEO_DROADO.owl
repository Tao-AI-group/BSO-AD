        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pleiotrophin</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plexin_A1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Plexin_A1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plexin_A1</rdfs:label>
    </owl:Class>
    


