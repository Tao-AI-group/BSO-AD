    <!-- https://sbmi.uth.edu/ontology/PeriodicTimeInterval -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/PeriodicTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.ifomis.org/bfo/1.1/span#TimeInterval"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Periodic_Time_Interval</rdfs:label>
        <skos:definition>A prototype of the repeating interval, specifying the duration of each occurrence and anchors the PeriodicTimeInterval sequence at a certain point in time.</skos:definition>
