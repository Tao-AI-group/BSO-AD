        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00380 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00380">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00297"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Deprivation</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Limited access to society&apos;s resources due to poverty. discrimination, or other disadvantage. Conditions based on seven demographic characteristics collected in the American Community Survey (ACS): often include percent living in poverty, percent with less than 12 years of education, percent of single parent households, percent living in rented housing unit, percent living in overcrowded housing unit, percent of households without a car, and percent of non-employed adults under the age of 65 years.(https://dictionary.apa.org/socialdeprivation). (MSH)
 Limited access to society&apos;s resources due to poverty, neglect, social discrimination, or other disadvantage. For a lack of social contact use SOCIAL ISOLATION. Consider also CULTURAL DEPRIVATION. (PSY)
 https://uts.nlm.nih.gov/uts/umls/concept/C0677638</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0677638</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human-caused Phenomenon or Process</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00381 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00381">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00297"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Environment</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The aggregate of social and cultural institutions, forms, patterns, and processes that influence the life of an individual or community. (MSH)
 Involving a combination of social and environmental factors. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037414</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0037414</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Idea or Concept</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00382 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00382">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00381"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social_Characteristic</rdfs:label>
        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Characteristics</skos:altLabel>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A trait or factor of an individual that is related to the way they socialize or present themselves to others. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037401</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0037401</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Individual Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00383 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00383">
