    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00403">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00402"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Food_Bank</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00404 -->

