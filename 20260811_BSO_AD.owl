        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010495</IRI>
        <Literal>The outermost of the three MENINGES, a fibrous membrane of connective tissue that covers the brain and the spinal cord.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010495</IRI>
        <Literal>Dura Mater</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
