        <untitled-ontology-107:Definition>Collections of small neurons centrally scattered among many fibers from the level of the TROCHLEAR NUCLEUS in the midbrain to the hypoglossal area in the MEDULLA OBLONGATA.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D011903</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Raphe_Nucleus</rdfs:label>
    </owl:Class>
    


