    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Primary_metabolic_process">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process"/>
        <rdfs:label>Primary_Metabolic_Process</rdfs:label>
    </owl:Class>
    


