    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatosensory_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatosensory_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parietal_lobe"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Wernicke_area"/>
        <untitled-ontology-107:Definition>Area of the parietal lobe concerned with receiving sensations such as movement, pain, pressure, position, temperature, touch, and vibration. It lies posterior to the central sulcus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013003</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Somatosensory_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatotroph -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatotroph">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland"/>
        <untitled-ontology-107:Definition>Anterior pituitary cells which produce GROWTH HORMONE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052683</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Somatotroph</rdfs:label>
    </owl:Class>
    


