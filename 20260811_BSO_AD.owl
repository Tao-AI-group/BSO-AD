        <Literal>Idea or Concept</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#07020981</IRI>
        <Literal>Social_Characteristic</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#07020981</IRI>
        <Literal>A trait or factor of an individual that is related to the way they socialize or present themselves to others. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037401</Literal>
    </AnnotationAssertion>
