        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endBeforeEnd</rdfs:label>
        <skos:definition>Point relation. The source event ended before the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000039"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterStart</rdfs:label>
        <skos:definition>Point relation. The source event ended after the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endAfterEnd</rdfs:label>
        <skos:definition>Point relation. The source event ends after the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000158">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000152"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000157"/>
        <owl:inverseOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startEqualEnd</rdfs:label>
        <skos:definition>Point relation. the source event started at (the same time as) the end of the target event. It is the same as the interval relation &quot;metBy&quot;.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000159">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000150"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000155"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualStart</rdfs:label>
        <skos:definition>Point relation. The source event ended at (the same time as) the start of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000160">
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000151"/>
        <rdfs:subPropertyOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000156"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">endEqualEnd</rdfs:label>
        <skos:definition>Point relation. The source event ended at (the same time as) the end of the target event.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171">
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000171"/>
                <owl:someValuesFrom rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000162"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000029"/>
