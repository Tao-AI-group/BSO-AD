        <skos:altLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Problems related to social environment</skos:altLabel>
        <ICD10CM_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Z60</ICD10CM_ID>
    </owl:Class>
    


