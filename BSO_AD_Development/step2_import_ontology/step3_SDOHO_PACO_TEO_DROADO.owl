    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system"/>
        <untitled-ontology-107:Definition>The three membranes that cover the BRAIN and the SPINAL CORD. They are the dura mater, the arachnoid, and the pia mater.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D008578</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meninge</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meningitis -->

