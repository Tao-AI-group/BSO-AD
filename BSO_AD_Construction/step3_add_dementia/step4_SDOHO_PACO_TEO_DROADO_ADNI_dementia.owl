  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">startBeforeStart</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Point relation. The source event started before the start of the target event.</core:definition>
</owl:ObjectProperty>

