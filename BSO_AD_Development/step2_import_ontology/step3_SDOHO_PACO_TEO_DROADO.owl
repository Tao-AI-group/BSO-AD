    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Leukoaraiosis -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Leukoaraiosis">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathology"/>
        <untitled-ontology-107:Description>Non-specific white matter changes in the BRAIN, often seen after age 65. Changes include loss of AXONS; MYELIN pallor, GLIOSIS, loss of ependymal cells, and enlarged perivascular spaces. Leukoaraiosis is a risk factor for DEMENTIA and CEREBROVASCULAR DISORDERS.

From MSH</untitled-ontology-107:Description>
        <untitled-ontology-107:MeSH_Unique_ID>D049292</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:UMLS_CUI>C0948163</untitled-ontology-107:UMLS_CUI>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leukoaraiosis</rdfs:label>
    </owl:Class>
    


