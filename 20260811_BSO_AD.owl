        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000005</IRI>
        <Literal>use to represent the normalized view of the time expression of the given instant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
