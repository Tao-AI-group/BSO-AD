    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021589</IRI>
        <Literal>GDS_Hope_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:question"/>
        <IRI>http://www.modiag.it#08021590</IRI>
        <Literal xml:lang="en">Do you feel you have more problems with memory than most?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021590</IRI>
        <Literal>GDS_Memory_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:question"/>
