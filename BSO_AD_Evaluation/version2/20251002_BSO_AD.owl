    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Motor_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Motor_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Frontal_lobe"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Prefrontal_cortex"/>
        <untitled-ontology-107:Definition>Area of the FRONTAL LOBE concerned with primary motor control located in the dorsal PRECENTRAL GYRUS immediately anterior to the central sulcus. It is comprised of three areas: the primary motor cortex located on the anterior paracentral lobule on the medial surface of the brain; the premotor cortex located anterior to the primary motor cortex; and the supplementary motor area located on the midline surface of the hemisphere anterior to the primary motor cortex.</untitled-ontology-107:Definition>
        <untitled-ontology-107:OMIM_Gene_Title>D009044</untitled-ontology-107:OMIM_Gene_Title>
        <rdfs:label>Motor_Cortex</rdfs:label>
    </owl:Class>
    


