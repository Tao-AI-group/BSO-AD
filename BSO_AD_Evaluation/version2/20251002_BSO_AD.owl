                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has he/she had a change in eating behavior such as putting too much food in his/her mouth at once?</rdfs:comment>
        <rdfs:label>NPI_Eating_Disorders_Question_Item_5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_EatingDisordersQuestionItem_6 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_6">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has he/she had a change in the kind of food he/she likes such as eating too many sweets or other specific types of food?</rdfs:comment>
        <rdfs:label>NPI_Eating_Disorders_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_EatingDisordersQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_7">
