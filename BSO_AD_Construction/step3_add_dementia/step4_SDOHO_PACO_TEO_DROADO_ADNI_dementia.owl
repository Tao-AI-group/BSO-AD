  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ankyrin_Repeat_and_Sterile_Alpha_Motif_Domain_Containing_1B</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Annexin_A5">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annexin_A5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anoctamin_6">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anoctamin_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_cerebellar_commissure">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalic_commissure"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bundle of MYELINATED NERVE FIBERS that connects the two CEREBRAL HEMISPHERES in the LAMINA TERMINALIS. It is located ventral to the SEPTAL NUCLEI, and caudal to the median PREOPTIC NUCLEUS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066240</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Cerebellar_Commissure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalic_commissure">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Set of nerve fibers that cross the midline of the TELENCEPHALON. They include the ANTERIOR COMMISSURE; the CORPUS CALLOSUM; and the HIPPOCAMPAL COMMISSURE of the fornix.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066245</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Telencephalic_Commissure</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_horn_cell">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_ventral_horn"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MOTOR NEURONS in the anterior (ventral) horn of the SPINAL CORD which project to SKELETAL MUSCLES.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D000870</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Horn_Cell</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_ventral_horn">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of three central columns of the spinal cord. It is composed of GRAY MATTER spinal laminae VIII and IX.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066151</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Cord_Ventral_Horn</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamic_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Loose heterogeneous collection of cells in the anterior hypothalamus, continuous rostrally with the medial and lateral PREOPTIC AREAS and caudally with the TUBER CINEREUM.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007025</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Hypothalamic_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The front portion of the HYPOTHALAMUS separated into the preoptic region and the supraoptic region. The preoptic region is made up of the periventricular GRAY MATTER of the rostral portion of the THIRD VENTRICLE and contains the preoptic ventricular nucleus and the medial preoptic nucleus. The supraoptic region contains the PARAVENTRICULAR HYPOTHALAMIC NUCLEUS, the SUPRAOPTIC NUCLEUS, the ANTERIOR HYPOTHALAMIC NUCLEUS, and the SUPRACHIASMATIC NUCLEUS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007032</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothalamus, anterior</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Hypothalamus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">general or unspecified; prefer specific structures &amp; areas in the hypothalamus; HYPOTHALAMO-HYPOPHYSEAL SYSTEM is available for the hypothalamus-pituitary relationship</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007031</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothalamus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The anterior glandular lobe of the pituitary gland, also known as the adenohypophysis. It secretes the ADENOHYPOPHYSEAL HORMONES that regulate vital functions such as GROWTH; METABOLISM; and REPRODUCTION.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010903</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pituitary gland, anterior</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Pituitary_Gland</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamo-hypophyseal_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small, unpaired gland situated in the SELLA TURCICA. It is connected to the HYPOTHALAMUS by a short stalk which is called the INFUNDIBULUM.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010902</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pituitary_Gland</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_thalamic_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Three nuclei located beneath the dorsal surface of the most rostral part of the thalamus. The group includes the anterodorsal nucleus, anteromedial nucleus, and anteroventral nucleus. All receive connections from the MAMILLARY BODY and BRAIN FORNIX, and project fibers to the CINGULATE BODY.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020643</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Thalamic_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Several groups of nuclei in the thalamus that serve as the major relay centers for sensory impulses in the brain.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013787</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thalamic_Nuclei</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-Anxiety_Agent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agents that alleviate ANXIETY, tension, and ANXIETY DISORDERS, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions. ADRENERGIC BETA-ANTAGONISTS are commonly used in the symptomatic treatment of anxiety but are not included here.

From MeSH</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D014151</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-anxiety_Agent</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A loosely defined grouping of drugs that have effects on psychological function. Here the psychotropic agents include the antidepressive agents, hallucinogens, and tranquilizing agents (including the antipsychotics and anti-anxiety agents).

From MeSH</unti:Definition>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No treatments approved for management of behavioral symptoms in dementia.</unti:Description>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D011619</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Psychotropic_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-aggregation_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-aggregation_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drug_Classified_by_Mechanism</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-amyloid_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-amyloid_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-inflammatory_agent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substances that reduce or suppress INFLAMMATION.

From MeSH</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D000893</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-inflammatory_Agent</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-tau_drug">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-tau_Drug</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anticonvulsant">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drugs used to prevent SEIZURES or reduce their severity.

From MeSH</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D000927</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anticonvulsant</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antidepressive_agent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mood-stimulating drugs used primarily in the treatment of affective disorders and related conditions. Several MONOAMINE OXIDASE INHIBITORS are useful as antidepressants apparently as a long-term consequence of their modulation of catecholamine levels. The tricyclic compounds useful as antidepressive agents (ANTIDEPRESSIVE AGENTS, TRICYCLIC) also appear to act through brain catecholamine systems. A third group (ANTIDEPRESSIVE AGENTS, SECOND-GENERATION) is a diverse group of drugs including some that act specifically on serotonergic systems.

From MeSH</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D000928</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antidepressive_Agent</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antioxidant_activity">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Molecular_function"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antioxidant_Activity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Molecular_function">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular_Function</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antipsychotic_agent">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agents that control agitated psychotic behavior, alleviate acute psychotic states, reduce psychotic symptoms, and exert a quieting effect. They are used in SCHIZOPHRENIA; senile dementia; transient psychosis following surgery; or MYOCARDIAL INFARCTION; etc. These drugs are often referred to as neuroleptics alluding to the tendency to produce neurological side effects, but not all antipsychotics are likely to produce such effects. Many of these drugs may also be effective against nausea, emesis, and pruritus.

From MeSH</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D014150</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antipsychotic_Agent</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anxiety">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anxiety</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mood_Symptom</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apathy">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apathy</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_C1">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_C1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_D">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_D</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_E">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_E</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apoptosis_inducing_factor_mitochondria_associated_1">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apoptosis_Inducing_Factor_Mitochondria_Associated_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arachnoid">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A delicate membrane enveloping the brain and spinal cord. It lies between the PIA MATER and the DURA MATER. It is separated from the pia mater by the subarachnoid cavity which is filled with CEREBROSPINAL FLUID.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D001099</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arachnoid</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The three membranes that cover the BRAIN and the SPINAL CORD. They are the dura mater, the arachnoid, and the pia mater.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D008578</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meninge</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arcuate_nucleus_of_hypothalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nucleus located in the middle hypothalamus in the most ventral part of the THIRD VENTRICLE near the entrance of the infundibular recess. Its small cells are in close contact with the EPENDYMA.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D001111</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arcuate_Nucleus_of_Hypothalamus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle portion of the hypothalamus containing the arcuate, dorsomedial, ventromedial nuclei, the TUBER CINEREUM and the PITUITARY GLAND.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D007033</unti:MeSH_Unique_ID>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypothalamus, middle</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle_Hypothalamus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Area_postrema">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small, rounded eminence on each side of the FOURTH VENTRICLE, which receives nerve fibers from the SOLITARY NUCLEUS; SPINAL CORD; and adjacent areas of the MEDULLA OBLONGATA. The area postrema lies outside the BLOOD-BRAIN BARRIER and its functions include acting as an emetic chemoreceptor.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D031608</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area_Postrema</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Myelencephalon"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lower portion of the BRAIN STEM. It is inferior to the PONS and anterior to the CEREBELLUM. Medulla oblongata serves as a relay station between the brain and the spinal cord, and contains centers for regulating respiratory, vasomotor, cardiac, and reflex activities.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D008526</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medulla_Oblongata</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aripiprazole">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antipsychotic_agent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aripiprazole</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Asymptomatic_at_risk">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Preclinical_AD"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Presymptomatic_AD"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Working Group (IWG) criteria: individuals with autosomal dominant gene mutations which almost certainly will develop the disease</unti:Definition>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asymptomatic_at_Risk</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Preclinical_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Stage"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National Institute on Aging - Alzheimer Association (NIA-AA) criteria: requires in vivo molecular biomarkers of AD are present, but clinical symptoms are absent

International Working Group (IWG) criteria: Refers to the stage of AD that is not clinically expressed; that is, although the molecular pathology of AD is present in the brain, symptoms are absent. The use of the preclinical AD definition signifies that this stage can only be detected by AD biomarkers, and not by currently available clinical methods.</unti:Definition>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cognitive decline greater than expected for their age and education level but does not significantly interfere with everyday activities; Alzheimer’s disease pathology already present in the brain; amyloid positivity associated with increased risk of clinical progression; individual cognitively intact; key for early intervention, treatment, and prognosis</unti:Description>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Presymptomatic phase</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preclinical_AD</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Presymptomatic_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Preclinical_AD"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">International Working Group (IWG) criteria: cognitively normal individual with evidence of AD molecular pathology; unknown whether progression to symptomatic AD will occur</unti:Definition>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Presymptomatic_AD</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Auditory_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The region of the cerebral cortex that receives the auditory radiation from the MEDIAL GENICULATE BODY.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D001303</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auditory_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A composite area of the cerebral cortex concerned with motor control and sensory perception comprising the motor cortex areas, the somatosensory areas, the gustatory cortex, the olfactory areas, the auditory cortex, and the visual cortex.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066191</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sensorimotor_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lower lateral part of the cerebral hemisphere responsible for auditory, olfactory, and semantic processing. It is located inferior to the lateral fissure and anterior to the OCCIPITAL LOBE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013702</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal_Lobe</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autoimmune_Diseases_of_the_Nervous_System">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autoimmune_Diseases_of_the_Nervous_System</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Disease"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nervous_System_Diseases</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autonomic_Nervous_System_Diseases">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autonomic_Nervous_System_Diseases</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autosomal_dominant_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Caused by amyloid-related mutations (PSEN1, PSEN2, APP) ; less than 1% AD cases</unti:Description>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autosomal_Dominant_AD</rdfs:label>
</owl:Class>

