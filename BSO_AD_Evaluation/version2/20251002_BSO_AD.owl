                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has he/she developed eating behaviors such as eating exactly the same types of food each day or eating the food in exactly the same order?</rdfs:comment>
        <rdfs:label>NPI_Eating_Disorders_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_EatingDisordersQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_8">
