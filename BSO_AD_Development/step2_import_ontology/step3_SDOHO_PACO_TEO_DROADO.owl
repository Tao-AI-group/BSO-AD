    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Fourth_ventricle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Fourth_ventricle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
        <untitled-ontology-107:Definition>An irregularly shaped cavity in the RHOMBENCEPHALON, located between the MEDULLA OBLONGATA; the PONS; and the isthmus in front, and the CEREBELLUM behind. It is continuous with the central canal of the cord below and with the CEREBRAL AQUEDUCT above, and through its lateral and median apertures it communicates with the SUBARACHNOID SPACE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020546</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fourth_Ventricle</rdfs:label>
    </owl:Class>
    


