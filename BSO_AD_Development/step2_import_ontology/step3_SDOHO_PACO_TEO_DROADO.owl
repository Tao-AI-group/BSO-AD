        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sexual attraction or relationship between males. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0242658</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0242658</UMLS_CUI>
