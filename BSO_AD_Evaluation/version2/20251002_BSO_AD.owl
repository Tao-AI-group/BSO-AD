                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Has he/she gained weight?</rdfs:comment>
        <rdfs:label>NPI_Eating_Disorders_Question_Item_4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_EatingDisordersQuestionItem_5 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_5">
