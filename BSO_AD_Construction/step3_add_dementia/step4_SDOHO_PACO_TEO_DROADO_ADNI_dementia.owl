<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Septum_pellucidum">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_ventricle"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Septum_of_brain"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A triangular double membrane separating the anterior horns of the LATERAL VENTRICLES of the brain. It is situated in the median plane and bounded by the CORPUS CALLOSUM and the body and columns of the FORNIX (BRAIN).</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D012688</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Septum_Pellucidum</rdfs:label>
</owl:Class>

