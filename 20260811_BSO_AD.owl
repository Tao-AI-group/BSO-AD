        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010418</IRI>
        <Literal>Tissue in the BASAL FOREBRAIN inferior to the anterior perforated substance, and anterior to the GLOBUS PALLIDUS and ansa lenticularis. It contains the BASAL NUCLEUS OF MEYNERT.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
