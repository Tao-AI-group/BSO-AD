    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00025</IRI>
        <Literal>An entity is associated with another entity through a functional, biological, clinical, or statistical relationship, encompassing effects, influences, or predictive associations.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#R_00026</IRI>
        <Literal>associatedWithShorterTimeToEvent</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00026</IRI>
        <Literal>An entity is associated with a reduced time interval to the occurrence of a specified disease-related event or outcome, such as earlier onset, faster progression, or shorter survival time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#R_00027</IRI>
        <Literal>associatedWithLongerTimeToEvent</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00027</IRI>
        <Literal>An entity is associated with an increased time interval to the occurrence of a specified disease-related event or outcome, such as delayed onset, slower progression, or prolonged survival time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#R_00028</IRI>
        <Literal>affects</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:altLabel"/>
        <IRI>#R_00028</IRI>
        <Literal>impacts</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:altLabel"/>
        <IRI>#R_00028</IRI>
        <Literal>influences</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00028</IRI>
        <Literal>A general relationship indicating that an entity influences another entity or process in any measurable or observable way, without specifying direction, magnitude, or mechanism.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#R_00029</IRI>
        <Literal>predicts</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00029</IRI>
        <Literal>The presence or value of an entity can be used to estimate the likelihood or future occurrence of a disease or outcome, without implying causality.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#R_00030</IRI>
        <Literal>affectsDiseaseCourse</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#R_00030</IRI>
        <Literal>An entity modifies the progression, severity, or temporal trajectory of a disease after its onset.</Literal>
    </AnnotationAssertion>
