  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neighborhood_Concentrated_Disadvantage_Protocol</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LOINC	Name	R/O/C	Cardinality	Example UCUM Units 
 63036-8	PhenX - neighborhood concentrated disadvantage protocol 211301	
		  Indent67784-9	Percent Of Individuals Below The Poverty Line			%
  Indent67785-6	Percent Of individuals On Public Assistance			%
  Indent67786-4	Percent Female-Headed Households			%
  Indent67787-2	Percent Unemployed			%
  Indent67788-0	Percent Less Than Age 18			%
  Indent67789-8	Percent Black			%
</core:definition>
</owl:Class>

