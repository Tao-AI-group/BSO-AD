        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subarachnoid_space"/>
        <untitled-ontology-107:Definition>One of three principal openings in the SUBARACHNOID SPACE. They are also known as cerebellomedullary cistern, and collectively as cisterns.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D002946</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Cisterna_Magna</rdfs:label>
