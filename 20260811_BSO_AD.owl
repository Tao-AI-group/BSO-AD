        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010493</IRI>
        <Literal>The space between the arachnoid membrane and PIA MATER, filled with CEREBROSPINAL FLUID. It contains large blood vessels that supply the BRAIN and SPINAL CORD.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010493</IRI>
        <Literal>Subarachnoid Space</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
