  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenx_Measure–family_Conflict</rdfs:label>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C3166011</UMLS_CUI>
