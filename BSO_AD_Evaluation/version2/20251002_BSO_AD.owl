    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gonadotroph -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gonadotroph">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland"/>
        <untitled-ontology-107:Definition>Anterior pituitary cells that can produce both FOLLICLE STIMULATING HORMONE and LUTEINIZING HORMONE.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D052681</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Gonadotroph</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Granulovacuolar_degeneration -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Granulovacuolar_degeneration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Microscopic_lesion"/>
        <untitled-ontology-107:Description>Describes an abnormality in which the neuronal cytoplasm of hippocampal pyramidal cells is replaced by vacuoles containing small basophilic granules; these may represent an abnormality of neuronal autophagy. Hippocampi showing prominent GVD also often show eosinophilic hyaline rodlike structures—rodlike bodies of Hirano—in the neuropil.

https://doi.org/10.1146/annurev-pathol-020712-163927</untitled-ontology-107:Description>
        <untitled-ontology-107:Synonym>GVD, of Simchowicz</untitled-ontology-107:Synonym>
        <untitled-ontology-107:UMLS_CUI>C0333454; C0333455</untitled-ontology-107:UMLS_CUI>
        <rdfs:label>Granulovacuolar_Degeneration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gray_matter -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gray_matter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>Region of CENTRAL NERVOUS SYSTEM that appears darker in color than the other type, WHITE MATTER. It is composed of neuronal CELL BODIES; NEUROPIL; GLIAL CELLS and CAPILLARIES but few MYELINATED NERVE FIBERS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066128</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Gray_Matter</rdfs:label>
    </owl:Class>
    


