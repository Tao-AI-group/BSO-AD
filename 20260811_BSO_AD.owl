        <IRI>http://www.modiag.it#08021592</IRI>
        <Literal>GDS_Satisfaction_Item</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:question"/>
        <IRI>http://www.modiag.it#08021593</IRI>
        <Literal xml:lang="en">Do you feel pretty worthless the way you are now?</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08021593</IRI>
        <Literal>GDS_Worthless_Item</Literal>
