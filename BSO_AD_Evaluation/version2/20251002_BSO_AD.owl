        <untitled-ontology-107:Definition>The output neurons of the cerebellar cortex.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D011689</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Purkinje_Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Putamen -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Putamen">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Neostriatum"/>
        <untitled-ontology-107:Definition>The largest and most lateral of the BASAL GANGLIA lying between the lateral medullary lamina of the GLOBUS PALLIDUS and the EXTERNAL CAPSULE. It is part of the neostriatum and forms part of the LENTIFORM NUCLEUS along with the GLOBUS PALLIDUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D011699</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Putamen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pyramidal_tract -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pyramidal_tract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>Fibers that arise from cells within the cerebral cortex, pass through the medullary pyramid, and descend in the spinal cord. Many authorities say the pyramidal tracts include both the corticospinal and corticobulbar tracts.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D011712</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Pyramidal_Tract</rdfs:label>
    </owl:Class>
    


