    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_dorsal_horn -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_dorsal_horn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER spinal laminae I-VI.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066148</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Cord_Dorsal_Horn</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_lateral_horn -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_lateral_horn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER and is located laterally in lamina VII.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066152</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Cord_Lateral_Horn</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_ventral_horn -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_ventral_horn">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER spinal laminae VIII and IX.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066151</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Cord_Ventral_Horn</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_trigeminal_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_trigeminal_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pontine_tegmentum"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Trigeminal_nuclei"/>
        <untitled-ontology-107:Definition>Nucleus of the spinal tract of the trigeminal nerve. It is divided cytoarchitectonically into three parts: oralis, caudalis (TRIGEMINAL CAUDAL NUCLEUS), and interpolaris.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D014279</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinal_Trigeminal_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinothalamic_tract -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinothalamic_tract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord"/>
        <untitled-ontology-107:Definition>A bundle of NERVE FIBERS connecting each posterior horn of the spinal cord to the opposite side of the THALAMUS, carrying information about pain, temperature, and touch. It is one of two major routes by which afferent spinal NERVE FIBERS carrying sensations of somaesthesis are transmitted to the THALAMUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013133</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spinothalamic_Tract</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spleen_associated_tyrosine_kinase -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spleen_associated_tyrosine_kinase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spleen_Associated_Tyrosine_Kinase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sporadic_AD -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sporadic_AD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
        <untitled-ontology-107:Description>Multifactorial disease with high complexity; about 99% AD cases; characterized by amyloid beta deposits and tau tangles in neocortical brain regions</untitled-ontology-107:Description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sporadic_AD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Star_related_lipid_transfer_domain_containing_10 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Star_related_lipid_transfer_domain_containing_10">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Star_Related_Lipid_Transfer_Domain_Containing_10</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Staufen_double-stranded_RNA_binding_protein_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Staufen_double-stranded_RNA_binding_protein_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Staufen_Double-stranded_RNA_Binding_Protein_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sterol_regulatory_element_binding_transcription_factor_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sterol_regulatory_element_binding_transcription_factor_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sterol_Regulatory_Element_Binding_Transcription_Factor_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sterol_regulatory_element_binding_transcription_factor_2 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sterol_regulatory_element_binding_transcription_factor_2">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sterol_Regulatory_Element_Binding_Transcription_Factor_2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Structural_molecule_activity -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Structural_molecule_activity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Molecular_function"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Structural_Molecule_Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subarachnoid_space -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subarachnoid_space">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arachnoid"/>
        <untitled-ontology-107:Definition>The space between the arachnoid membrane and PIA MATER, filled with CEREBROSPINAL FLUID. It contains large blood vessels that supply the BRAIN and SPINAL CORD.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013346</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subarachnoid_Space</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcommissural_organ -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcommissural_organ">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tectum_mesencephali"/>
        <untitled-ontology-107:Definition>Ependymal derivative located at the junction of the THIRD VENTRICLE and the CEREBRAL AQUEDUCT; and the SOMATOSTATIN SECRETING CELLS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013351</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcommissural_Organ</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_atrophy -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_atrophy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Leukoaraiosis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcortical_White_Matter_Atrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_pallor -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_pallor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Leukoaraiosis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcortical_White_Matter_Pallor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_shrinkage -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subcortical_white_matter_shrinkage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Leukoaraiosis"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcortical_White_Matter_Shrinkage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subdural_Effusion -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subdural_Effusion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_Diseases"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subdural_Effusion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subdural_space -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subdural_space">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dura_mater"/>
        <untitled-ontology-107:Definition>Potential cavity which separates the ARACHNOID MATER from the DURA MATER.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013355</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subdural_Space</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subjective_cognitive_decline -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subjective_cognitive_decline">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cognitive_dysfunction"/>
        <untitled-ontology-107:Description>Personal sensation of cognitive decline despite results within healthy limits on cognitive tests; associated with increased risk of progression to dementia, especially when patient worried about decline; more brain abnormalities: hippocampal volume loss, hypometabolism; cerebrospinal amyloid β strongly predictive of subsequent clinical progression</untitled-ontology-107:Description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subjective_Cognitive_Decline</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_gelatinosa -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_gelatinosa">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Posterior_horn_cell"/>
        <untitled-ontology-107:Definition>Gelatinous-appearing material in the dorsal horn of the spinal cord, consisting chiefly of Golgi type II neurons and some larger nerve cells.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013376</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substantia_Gelatinosa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_innominata -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_innominata">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_Ganglia"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
        <untitled-ontology-107:Definition>Tissue in the BASAL FOREBRAIN inferior to the anterior perforated substance, and anterior to the GLOBUS PALLIDUS and ansa lenticularis. It contains the BASAL NUCLEUS OF MEYNERT.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013377</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substantia_Innominata</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_nigra -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_nigra">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle"/>
        <untitled-ontology-107:Definition>The black substance in the ventral midbrain or the nucleus of cells containing the black substance. These cells produce DOPAMINE, an important neurotransmitter in regulation of the sensorimotor system and mood. The dark colored MELANIN is a by-product of dopamine synthesis.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013378</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substantia_Nigra</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamus"/>
        <untitled-ontology-107:Definition>Lens-shaped structure on the inner aspect of the INTERNAL CAPSULE. The SUBTHALAMIC NUCLEUS and pathways traversing this region are concerned with the integration of somatic motor function.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020531</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subthalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Subthalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
        <untitled-ontology-107:Definition>A transition zone in the anterior part of the diencephalon interposed between the thalamus, hypothalamus, and tegmentum of the mesencephalon. Components of the subthalamus include the SUBTHALAMIC NUCLEUS, zona incerta, nucleus of field H, and the nucleus of ansa lenticularis. The latter contains the ENTOPEDUNCULAR NUCLEUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020530</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subthalamus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Succinate_dehydrogenase_complex_flavoprotein_subunit_A -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Succinate_dehydrogenase_complex_flavoprotein_subunit_A">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Succinate_Dehydrogenase_Complex_Flavoprotein_Subunit_A</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfotransferase_family_2A_member_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfotransferase_family_2A_member_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sulfotransferase_Family_2A_Member_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfotransferase_family_4A_member_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfotransferase_family_4A_member_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sulfotransferase_Family_4A_Member_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfur_utilization -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sulfur_utilization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Signaling"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sulfur_Utilization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Superior_colliculi -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Superior_colliculi">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tectum_mesencephali"/>
        <untitled-ontology-107:Definition>The anterior pair of the quadrigeminal bodies which coordinate the general behavioral orienting responses to visual stimuli, such as whole-body turning, and reaching.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D013477</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Superior_Colliculi</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Superior_olivary_complex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Superior_olivary_complex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pontine_tegmentum"/>
        <untitled-ontology-107:Definition>An auditory brainstem structure in the pontine tegmentum that contains several nuclei associated with auditory localization and is component of ascending and descending auditory pathways.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065832</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Superior_Olivary_Complex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Suprachiasmatic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Suprachiasmatic_nucleus">
