        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010423</IRI>
        <Literal>D053400</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010423</IRI>
        <Literal>High_Vocal_Center</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
