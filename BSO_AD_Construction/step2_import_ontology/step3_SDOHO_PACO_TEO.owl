            </owl:Restriction>
        </rdfs:range>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasGranularity</rdfs:label>
        <skos:definition>Describes the granularity of a temporal element</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000180 -->

    <owl:ObjectProperty rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000180">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hasPeriod</rdfs:label>
