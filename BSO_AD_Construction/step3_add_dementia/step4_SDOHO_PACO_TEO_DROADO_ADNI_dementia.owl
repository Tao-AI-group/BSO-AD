<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatosensory_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parietal_lobe"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Wernicke_area"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area of the parietal lobe concerned with receiving sensations such as movement, pain, pressure, position, temperature, touch, and vibration. It lies posterior to the central sulcus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013003</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Somatosensory_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Wernicke_area">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parietal_lobe"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional region comprising posterior part of the SUPERIOR TEMPORAL GYRUS in the dominant cerebral hemisphere (see CEREBRAL DOMINANCE) and often portions of the PARIETAL LOBE. Along with BROCA AREA it is important in SPEECH and LANGUAGE processes. A lesion in the area is associated with WERNICKE APHASIA and CONDUCTION APHASIA.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065813</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wernicke_Area</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Somatotroph">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior pituitary cells which produce GROWTH HORMONE.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D052683</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Somatotroph</rdfs:label>
</owl:Class>

