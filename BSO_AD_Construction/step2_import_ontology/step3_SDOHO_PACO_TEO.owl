        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Week</rdfs:label>
        <skos:definition>Defines a particular week, where the sequence of the weekdays can be defined using TimeSequence. For example, one can define a week from Monday to Sunday, from Sunday to Sat, or from Tue to Mon.</skos:definition>
    </owl:Class>
    


