        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient say he/she is a burden to the family or that the family would be better off without him/her?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_7 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_7">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient express a wish for death or talk about killing him/herself?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_8 -->

    <owl:Class rdf:about="http://www.modiag.it#NPI_DepressionDysphoriaQuestionItem_8">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
                    <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Does the patient show any other signs of depression or sadness?</rdfs:comment>
        <rdfs:label>NPI_Depression_Dysphoria_Question_Item_8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.modiag.it#NPI_DepressionDysphoriaSeverityItem -->

