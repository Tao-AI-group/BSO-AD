    <!-- https://github.com/Tao-AI-group/BSO_AD#00045 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00045">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00035"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://arxiv.org/pdf/2102.04216.pdf</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cdn.loinc.org/wp-content/uploads/2017/11/Screen-Shot-2017-11-06-at-10.42.00-AM.png?iv=608</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://health.gov/healthypeople/objectives-and-data/social-determinants-health</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Element_Relevant_to_Physical_Activity</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Body movements of a human or an animal as a behavioral phenomenon. (MSH)
 Any form of exercise or movement. Physical activity may include planned activity such as walking, running, basketball, or other sports. Physical activity may also include other daily activities such as household chores, yard work, walking the dog, etc. (NCI)
 State or quality of body movements during daily living. (OMS)
 https://uts.nlm.nih.gov/uts/umls/concept/C0026606</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0026606</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Daily or Recreational Activity</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00046 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00046">
