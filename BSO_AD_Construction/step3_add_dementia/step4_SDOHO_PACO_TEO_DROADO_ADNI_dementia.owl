  <rdfs:subClassOf rdf:resource="#00426"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Epa_Air_Quality_Index</rdfs:label>
  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nationally uniform color-coded index developed by EPA for reporting and forecasting daily air quality. The AQI reports the most common ambient air pollutants that are regulated under the Clean Air Act, including ozone and particle pollution. The AQI informs the public about air quality in the area, tells who may be affected, and provides steps to take to reduce exposure when pollution levels are unhealthy. (NCI)</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C5419195</UMLS_CUI>
  <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intellectual Product</UMLS_Semantic_Type>
</owl:Class>

