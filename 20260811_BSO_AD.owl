        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010423</IRI>
        <Literal>Nucleus in the NEOSTRIATUM of bird brains that sends signals for song production and receives auditory input. In some adult SONGBIRDS, research has shown that the size of this nucleus changes seasonally and that it exhibits neurogenesis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
