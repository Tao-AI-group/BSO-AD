        <Literal>Alzheimer_Disease_9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#06010593</IRI>
        <Literal>An autosomal dominant subtype of Alzheimer disease caused by mutation(s) in the ABCA7 gene, encoding phospholipid-transporting ATPase ABCA7. The onset is after the age of 65.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
