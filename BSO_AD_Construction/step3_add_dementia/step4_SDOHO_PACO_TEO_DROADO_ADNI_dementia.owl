  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ALZHEIMER DISEASE; AD; PRESENILE AND SENILE DEMENTIA</unti:OMIM_Gene_Title>
  <unti2:Locus_MIM_number rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">103950</unti2:Locus_MIM_number>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A2M</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#ABI_family_member_3">
