  <core:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person who manages a home as their main daily activity. (NCI)

 https://uts.nlm.nih.gov/uts/umls/concept/C0555052</core:definition>
  <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0555052</UMLS_CUI>
