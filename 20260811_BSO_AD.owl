    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:assessmentSource</AbbreviatedIRI>
        <Literal xml:lang="en">V = Participant visit; C = Telephone call</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:education</AbbreviatedIRI>
        <Literal>It is not clear what information the field carries</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:gender</AbbreviatedIRI>
        <Literal xml:lang="en">1=Male; 2=Female</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:handedness</AbbreviatedIRI>
        <Literal xml:lang="en">1=Right;2=Left</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:homeType</AbbreviatedIRI>
        <Literal xml:lang="en">1=House;2=Condo/Co-op (owned);3=Apartment (rented);4=Mobile Home;5=Retirement Community;6=Assisted Living;7=Skilled Nursing Facility;8=Other (specify)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:homeType</AbbreviatedIRI>
        <Literal xml:lang="en">Type of Participant residence</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:maritalStatus</AbbreviatedIRI>
        <Literal xml:lang="en">1=Married; 2=Widowed; 3=Divorced; 4=Never married; 5=Unknown</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:primaryOccupation</AbbreviatedIRI>
        <Literal xml:lang="en">Primary occupation during most of adult life</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:recallItemList</AbbreviatedIRI>
        <Literal xml:lang="en">&quot;1&quot; stands for the list (Ball; Flag; Tree);
&quot;2&quot; stands for the list (Apple; Penny; Table).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:recentOccupation</AbbreviatedIRI>
        <Literal xml:lang="en">Most recent occupation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="www.:valuesMeaning"/>
        <AbbreviatedIRI>www.:retired</AbbreviatedIRI>
        <Literal xml:lang="en">1=Yes;0=No;2=Not Applicable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:summedScore</AbbreviatedIRI>
        <Literal xml:lang="en">A score that is the sum of single items scores</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>www.:unableToCompleteWhy</AbbreviatedIRI>
        <Literal xml:lang="en">Why the participant is unable to complete the test based on the clinician&apos;s best judgement. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#0_05_1_2_3_CDR_score</IRI>
        <Literal xml:lang="en">0 = None; 0.5 = Questionable; 1 = Mild; 2 = Moderate; 3 = Severe</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#0_1_2_3_4_5_NPI_score</IRI>
        <Literal>0 :Not distressing at all;  1: Minimal; 2:Mild; 3 : Moderate; 4 : Severe 5 :Extreme or Very Severe</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#0_1_2_3_NPIQ_score</IRI>
        <Literal>0 = None (not present) 1 = Mild (noticeable, but not a significant change) 2 = Moderate (significant, but not a dramatic change) 3 = Severe (very marked or prominent, a dramatic change)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://www.modiag.it#0_1_score</IRI>
        <Literal xml:lang="en">0 = Wrong; 1 = Right</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08000000</IRI>
        <Literal>Element_Relevant_to_Examination</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://www.modiag.it#08010000</IRI>
        <Literal>Standardized_Assessment</Literal>
