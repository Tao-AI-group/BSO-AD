    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Blood-brain_barrier -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Blood-brain_barrier">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain"/>
        <untitled-ontology-107:Definition>Specialized non-fenestrated tightly-joined ENDOTHELIAL CELLS with TIGHT JUNCTIONS that form a transport barrier for certain substances between the cerebral capillaries and the BRAIN tissue.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001812</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Blood-brain_Barrier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Central_nervous_system"/>
        <untitled-ontology-107:Definition>The part of CENTRAL NERVOUS SYSTEM that is contained within the skull (CRANIUM). Arising from the NEURAL TUBE, the embryonic brain is comprised of three major parts including PROSENCEPHALON (the forebrain); MESENCEPHALON (the midbrain); and RHOMBENCEPHALON (the hindbrain). The developed brain consists of CEREBRUM; CEREBELLUM; and other structures in the BRAIN STEM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001921</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Brain</rdfs:label>
    </owl:Class>
    


