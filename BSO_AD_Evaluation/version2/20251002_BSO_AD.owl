    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Habenula -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Habenula">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Epithalamus"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pineal_gland"/>
        <untitled-ontology-107:Definition>A small protuberance at the dorsal, posterior corner of the wall of the THIRD VENTRICLE, adjacent to the dorsal THALAMUS and PINEAL BODY. It contains the habenular nuclei and is a major part of the epithalamus.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D019262</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Habenula</rdfs:label>
    </owl:Class>
    


