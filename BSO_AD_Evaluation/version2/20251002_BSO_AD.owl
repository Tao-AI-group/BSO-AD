        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Symptom"/>
        <untitled-ontology-107:Definition>Diminished or impaired mental and/or intellectual function.</untitled-ontology-107:Definition>
        <untitled-ontology-107:Synonym>Cognitive decline</untitled-ontology-107:Synonym>
        <Gene:Locus_MIM_number>D060825</Gene:Locus_MIM_number>
        <rdfs:label>Cognitive_Dysfunction</rdfs:label>
    </owl:Class>
    


