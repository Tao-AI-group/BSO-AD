<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Motor_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Frontal_lobe"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Prefrontal_cortex"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area of the FRONTAL LOBE concerned with primary motor control located in the dorsal PRECENTRAL GYRUS immediately anterior to the central sulcus. It is comprised of three areas: the primary motor cortex located on the anterior paracentral lobule on the medial surface of the brain; the premotor cortex located anterior to the primary motor cortex; and the supplementary motor area located on the midline surface of the hemisphere anterior to the primary motor cortex.</unti:Definition>
  <unti:OMIM_Gene_Title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D009044</unti:OMIM_Gene_Title>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Motor_Cortex</rdfs:label>
</owl:Class>

