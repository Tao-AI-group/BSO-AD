<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Paired_box_6">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paired_Box_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parabrachial_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pontine_tegmentum"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cell group in the pontine tegmentum surrounding the surfaces of the superior CEREBRAL PEDUNCLE of the PONS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065823</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Parabrachial_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Paraventricular_hypothalamic_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus in the anterior part of the HYPOTHALAMUS.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010286</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paraventricular_Hypothalamic_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parietal_lobe">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upper central part of the cerebral hemisphere. It is located posterior to central sulcus, anterior to the OCCIPITAL LOBE, and superior to the TEMPORAL LOBES.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010296</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Parietal_Lobe</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Paroxetine">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Selective_serotonin_reuptake_inhibitor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paroxetine</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pars_compacta">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_nigra"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pars_reticulata"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region in the substantia nigra located dorsal to the PARS RETICULATA.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065842</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pars_Compacta</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_nigra">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_peduncle"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The black substance in the ventral midbrain or the nucleus of cells containing the black substance. These cells produce DOPAMINE, an important neurotransmitter in regulation of the sensorimotor system and mood. The dark colored MELANIN is a by-product of dopamine synthesis.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D013378</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substantia_Nigra</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pars_reticulata">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Substantia_nigra"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region in the substantia nigra located ventral and lateral to the PARS COMPACTA.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065841</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pars_Reticulata</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pedunculopontine_tegmental_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midbrain_reticular_formation"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dense collection of cells in the caudal pontomesencephalic tegmentum known to play a role in the functional organization of the BASAL GANGLIA and in the modulation of the thalamocortical neuronal system.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D045042</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedunculopontine_Tegmental_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Peptidyl_arginine_deiminase_2">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peptidyl_Arginine_Deiminase_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Perforant_pathway">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pathway of fibers that originates in the lateral part of the ENTORHINAL CORTEX, perforates the SUBICULUM of the HIPPOCAMPUS, and runs into the stratum moleculare of the hippocampus, where these fibers synapse with others that go to the DENTATE GYRUS where the pathway terminates. It is also known as the perforating fasciculus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D019580</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perforant_Pathway</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Periamygdaloid_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Corticomedial_nuclear_complex"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Parahippocampal_gyrus"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The surface of the parahippocampal gyrus overlying the cortical amygdaloid nucleus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066277</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Periamygdaloid_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Periaqueductal_gray">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Central gray matter surrounding the CEREBRAL AQUEDUCT in the MESENCEPHALON. Physiologically it is probably involved in RAGE reactions, the LORDOSIS REFLEX; FEEDING responses, bladder tonus, and pain.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D010487</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Periaqueductal_Gray</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Perilipin_4">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perilipin_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Perirhinal_cortex">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An area in the temporal lobe that is important for memory encoding and retrieval. It is bordered caudally by the parahippocampal cortex (see HIPPOCAMPUS) and ventrally and medially by the ENTORHINAL CORTEX.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D000071039</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Perirhinal_Cortex</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Peroxiredoxin_1">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peroxiredoxin_1</rdfs:label>
