  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has he/she had a change in eating behavior such as putting too much food in his/her mouth at once?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Eating_Disorders_Question_Item_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_6">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has he/she had a change in the kind of food he/she likes such as eating too many sweets or other specific types of food?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Eating_Disorders_Question_Item_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_7">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has he/she developed eating behaviors such as eating exactly the same types of food each day or eating the food in exactly the same order?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Eating_Disorders_Question_Item_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersQuestionItem_8">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Have there been any other changes in appetite or eating that I haven’t asked about?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Eating_Disorders_Question_Item_8</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_EatingDisordersSeverityItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severity of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Eating_Disorders_Severity_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaDistressItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distress experienced by Caregiver due to the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Distress_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_1">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient appear to feel too good or to be too happy, different from his/her usual self?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_2">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient find humor and laugh at things that others do not find funny?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_3">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient seem to have a childish sense of humor with a tendency to giggle or laugh inappropriately (such as when something unfortunate happens to others)?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_4">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient tell jokes or make remarks that have little humor for others but seem funny to him/her?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_5">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does he/she play childish pranks such as pinching or playing “keep away” for the fun of it?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_6">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient “talk big” or claim to have more abilities or wealth than is true?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_ElationEuphoriaQuestionItem_7">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient show any other signs of feeling too good or being too happy?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Elation_Euphoria_Question_Item_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsCaregiverDistressItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
