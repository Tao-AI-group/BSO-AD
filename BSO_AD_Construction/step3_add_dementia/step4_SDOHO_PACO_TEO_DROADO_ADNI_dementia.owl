  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microtubule_Associated_Protein_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midbrain_reticular_formation">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Reticular_formation"/>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Tegmentum_mesencephali"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The midbrain portion of the reticular formation located in the MIDBRAIN TEGMENTUM.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D066265</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midbrain_Reticular_Formation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Reticular_formation">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Brain_stem"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region extending from the PONS &amp; MEDULLA OBLONGATA through the MESENCEPHALON, characterized by a diversity of neurons of various sizes and shapes, arranged in different aggregations and enmeshed in a complicated fiber network.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D012154</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reticular_Formation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_cerebellar_peduncle">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pons"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WHITE MATTER consisting of a large bundle of paired fibers originating in the pontine nuclei in the pre pontis and the nucleus reticularis tegmenti pontis projecting to the contralateral cerebral cortex.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D065837</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Middle_Cerebellar_Peduncle</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midkine">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midkine</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Midline_thalamic_nucleus">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small, nonspecific nerve cells scattered in the periventricular GRAY MATTER, separating the medial part of the thalamus from the EPENDYMA of the THIRD VENTRICLE. The group includes the paraventricular nucleus, paratenial nucleus, reuniens nucleus, rhomboidal nucleus, and subfascular nucleus.</unti:Definition>
  <unti:MeSH_Unique_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D020644</unti:MeSH_Unique_ID>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Midline_Thalamic_Nucleus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_cognitive_impairment_due_to_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Stage"/>
  <unti:Definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">National Institute on Aging - Alzheimer Association (NIA-AA) criteria: requires evidence of intra-individual decline, manifested by  a change in cognition from previously attained levels, impaired cognition in at least one domain (but not necessarily episodic memory), preserved independence in functional abilities, and no dementia</unti:Definition>
  <unti:Description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Characterized by mild cognitive impairment; patients have objective cognitive decline in one or more domains; capable of independent living</unti:Description>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Predementia phase; Prodromal AD 

International Working Group (IWG) criteria: Predementia AD is represented by prodromal AD, with episodic memory impairment that is insufficient to disrupt the performance of accustomed instrumental activities of daily living (IADL).</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild_Cognitive_Impairment_Due_to_AD</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mild_stage_of_dementia_due_to_AD">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Dementia_due_to_AD"/>
  <unti:Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild Alzheimer's disease; early stage of Alzheimer's disease</unti:Synonym>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mild_Stage_of_Dementia_Due_to_AD</rdfs:label>
</owl:Class>

