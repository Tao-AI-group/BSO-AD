      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient describe feeling things on his/her skin or otherwise appear to be feeling things crawling or touching him/her?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_6">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient describe tastes that are without any known cause?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsQuestionItem_7">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient describe any other unusual sensory experiences?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Question_Item_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_HallucinationsSeverityItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severity of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Hallucinations_Severity_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityDistress">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distress experienced by Caregiver due to the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Distress</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityFrequency">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Frequency</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_1">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have a bad temper, flying “off the handle” easily over little things?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_2">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient rapidly change moods from one to another, being fine one minute and angry the next?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_3">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have sudden flashes of anger?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_4">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the patient impatient, having trouble coping with delays or waiting for planned activities?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_5">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the patient cranky and irritable?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_6">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the patient argumentative and difficult to get along with?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilityQuestionItem_7">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient show any other signs of irritability?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Question_Item_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_IrritabilityLabilitySeverity">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severity of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Irritability_Lability_Severity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfAberrantMotorBehaviourItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have difficulty sleeping (do not count as present if the patient simply gets up once or twice per night only to go to the bathroom and falls back asleep immediately)? Is he/she up at night? Does he/she wander at night, get dressed, or disturb your sleep?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Aberrant_Motor_Behaviour_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfAgitationAggression">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have periods when he/she refuses to cooperate or won’t let people help him/her? Is he/she hard to handle?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Agitation_Aggression</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfAnxietyItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Is the patient very nervous, worried, or frightened for no apparent reason? Does he/she seem very tense or fidgety? Is the patient afraid to be apart from you?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Anxiety_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfDelusionsItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have beliefs that you know are not true (for example, insisting that people are trying to harm him/her or steal from him/her)? Has he/she said that family members are not who they say they are or that the house is not their home? I’m not asking about mere suspiciousness; I am interested if the patient is convinced that these things are happening to him/her.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Delusions_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfDepressionOrDysphoriaItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient seem sad or depressed? Does he/she say that he/she feels sad or depressed?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Depression_or_Dysphoria_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfDisinhibitionItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient seem to act impulsively without thinking? Does he/she do or say things that are not usually done or said in public? Does he/she do things that are embarrassing to you or others?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Disinhibition_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfEatingDisordersItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#EatingItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Has he/she had any change in appetite, weight, or eating habits (count as NA if the patient is incapacitated and has to be fed)? Has there been any change in type of food he/she prefers?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Eating_Disorders_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfElationEuphoriaItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient seem too cheerful or too happy for no reason? I don’t mean the normal happiness that comes from seeing friends, receiving presents, or spending time with family members. I am asking if the patient has a persistent and abnormally good mood or finds humor where others do not.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Elation_Euphoria_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfHallucinationsItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have hallucinations such as seeing false visions or hearing imaginary voices? Does he/she seem to see, hear or experience things that are not present? By this question we do not mean just mistaken beliefs such as stating that someone who has died is still alive; rather we are asking if the patient actually has abnormal experiences of sounds or visions.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Hallucinations_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_PresenceOfIrritabilityLabilityItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#NPIItem"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient get irritated and easily disturbed? Are his/her moods very changeable? Is he/she abnormally impatient? We do not mean frustration over memory loss or inability to perform usual tasks; we are interested to know if the patient has abnormal irritability, impatience, or rapid emotional changes different from his/her usual self.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Presence_of_Irritability_Lability_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepDistressItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distress experienced by Caregiver due to the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Distress_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#SleepItem">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#SAItemByEvaluatedFeature"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sleep_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_1">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have difficulty falling asleep?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_1</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_2">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient get up during the night (do not count if the patient gets up once or twice per night only to go to the bathroom and falls back asleep immediately)?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_2</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_3">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient wander, pace, or get involved in inappropriate activities at night?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_3</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_4">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient awaken you during the night?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_4</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_5">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient awaken at night, dress, and plan to go out thinking that it is morning and time to start the day?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_5</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_6">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient awaken too early in the morning (earlier that was his/her habit)?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_6</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_7">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient sleep excessively during the day?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_7</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepQuestionItem_8">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#QuestionItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Does the patient have any other nighttime behaviors that bother you that we haven't talked about?</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Question_Item_8</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepSeverityItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severity of the symptom</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Severity_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NPI_SleepTotalItem">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.modiag.it#NPIItem"/>
        <rdf:Description rdf:about="http://www.modiag.it#SleepItem"/>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequency x Severity</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NPI_Sleep_Total_Item</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NeurologicalExam">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#ClinicalExam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neurological_Exam</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#StandardizedAssessment">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#Examination"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Standardized_Assessment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#NeuropsychologicalBattery">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#CognitiveAssessment"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.modiag.it#hasAssessmentItem"/>
      <owl:allValuesFrom rdf:resource="http://www.modiag.it#NeuropsychologicalBatteryItem"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Neuropsychological_Battery</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#PhysicalExam">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#ClinicalExam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical_Exam</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#TOMM40PolyTVariantGenotyping">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#Genotyping"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Translocase_of_Outer_Mitochondrial_Membrane_40_Poly-T_Variant_Genotyping</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#VitalSign">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#ClinicalExam"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vital_Sign</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#WGSSNP">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#Sequencing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wide_Genome_Sequencing_Single-Nucleotide_Polymorphism</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.modiag.it#WGS_Assembly">
  <rdfs:subClassOf rdf:resource="http://www.modiag.it#Sequencing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WGS_Assembly</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#A2M">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
