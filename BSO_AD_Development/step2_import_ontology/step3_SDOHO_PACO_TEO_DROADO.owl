        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sexual behavior that prevents or reduces the spread of SEXUALLY TRANSMITTED DISEASES or PREGNANCY. (MSH)
 Sexual Behavior or practices which reduce one&apos;s risk of pregnancy or transmission of HIV and other sexually transmitted diseases. (PSY)
 https://uts.nlm.nih.gov/uts/umls/concept/C0597728</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0597728</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00053 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00053">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00046"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHENX</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sexual_Orientation</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pattern of a person&apos;s emotional, romantic, and/or sexual attractions. (NCI)
 Direction of one&apos;s sexual interest toward members of the same, opposite, or both sexes; involves feelings, and sense of identity. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0205949</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0205949</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Attribute</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00054 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00054">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00053"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bisexuality</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sexual attraction or relationship between members of both the same and the opposite SEX. (MSH)
 A sexual attraction to members of both sexes. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C0005639</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0005639</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00055 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00055">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00053"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heterosexuality</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sexual attraction or relationship between members of the opposite SEX. (MSH)
 A sexual attraction to members of the opposite sex. (NCI)
 https://uts.nlm.nih.gov/uts/umls/concept/C0019421</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0019421</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00056 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00056">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00053"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Homosexuality</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sexual attraction or relationship between members of the same SEX. (MSH)
 A sexual attraction to members of the same sex. (NCI)
 Sexual attraction or relationship between members of the same sex. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0019900</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0019900</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Behavior</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00057 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00057">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00053"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transsexualism</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expression of a GENDER IDENTITY inconsistent with, or not culturally-associated with the gender assigned to an individual at birth, combined with the desire to permanently transition to the gender with which they identify. (MSH)
 The urge to belong to the opposite sex that may include surgical procedures to modify the sex organs in order to appear as the opposite sex. (PSY)
 https://uts.nlm.nih.gov/uts/umls/concept/C0040765</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0040765</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Attribute</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00058 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00058">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00035"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://arxiv.org/pdf/2102.04216.pdf</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sleep</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A readily reversible suspension of sensorimotor interaction with the environment, usually associated with recumbency and immobility. (MSH)
 A natural and periodic state of rest during which consciousness of the world is suspended. (NCI)
 General mental functions of periodic, reversible and selective physical and mental disengagement from one&apos;s immediate environment accompanied by characteristic physiological changes. (ICF)
 General mental functions of periodic, reversible and selective physical and mental disengagement from one&apos;s immediate environment accompanied by characteristic physiological changes. (ICF-CY)
 Any process in which an organism enters and maintains a periodic, readily reversible state of reduced awareness and metabolic activity. Usually accompanied by physical relaxation, the onset of sleep in humans and other mammals is marked by a change in the electrical activity of the brain. [ISBN:0192800981] (GO)
 Natural periodic suspension of consciousness during which the body is restored (NOC)
 Period of rest for the body and mind during which volition and consciousness are in partial or complete abeyance and bodily functions are partially suspended; a behavioral state marked by a characteristic immobile posture and diminished but readily reversible sensitivity to external stimuli. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037313</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0037313</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organism Function</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00059 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00059">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00035"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PHENX</rdfs:comment>
