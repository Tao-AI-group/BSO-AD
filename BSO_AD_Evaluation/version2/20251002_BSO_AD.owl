        <rdfs:label>Basal_Ganglia_Diseases</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_forebrain -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_forebrain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex"/>
        <untitled-ontology-107:Definition>The region of the telencephalon located rostral and ventral to the STRIATUM comprising AMYGDALA; SEPTAL NUCLEI; SUBSTANTIA INNOMINATA and ventral pallidum.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066187</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label>Basal_Forebrain</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basolateral_nuclear_complex -->

