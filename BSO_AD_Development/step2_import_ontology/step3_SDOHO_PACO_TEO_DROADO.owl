    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_cerebellar_commissure -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_cerebellar_commissure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalic_commissure"/>
        <untitled-ontology-107:Definition>Bundle of MYELINATED NERVE FIBERS that connects the two CEREBRAL HEMISPHERES in the LAMINA TERMINALIS. It is located ventral to the SEPTAL NUCLEI, and caudal to the median PREOPTIC NUCLEUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066240</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Cerebellar_Commissure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_horn_cell -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_horn_cell">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Spinal_cord_ventral_horn"/>
        <untitled-ontology-107:Definition>MOTOR NEURONS in the anterior (ventral) horn of the SPINAL CORD which project to SKELETAL MUSCLES.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000870</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Horn_Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus"/>
        <untitled-ontology-107:Definition>Loose heterogeneous collection of cells in the anterior hypothalamus, continuous rostrally with the medial and lateral PREOPTIC AREAS and caudally with the TUBER CINEREUM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D007025</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Hypothalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Hypothalamus"/>
        <untitled-ontology-107:Definition>The front portion of the HYPOTHALAMUS separated into the preoptic region and the supraoptic region. The preoptic region is made up of the periventricular GRAY MATTER of the rostral portion of the THIRD VENTRICLE and contains the preoptic ventricular nucleus and the medial preoptic nucleus. The supraoptic region contains the PARAVENTRICULAR HYPOTHALAMIC NUCLEUS, the SUPRAOPTIC NUCLEUS, the ANTERIOR HYPOTHALAMIC NUCLEUS, and the SUPRACHIASMATIC NUCLEUS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D007032</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Hypothalamus, anterior</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Hypothalamus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_pituitary_gland">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pituitary_gland"/>
        <untitled-ontology-107:Definition>The anterior glandular lobe of the pituitary gland, also known as the adenohypophysis. It secretes the ADENOHYPOPHYSEAL HORMONES that regulate vital functions such as GROWTH; METABOLISM; and REPRODUCTION.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D010903</untitled-ontology-107:MeSH_Unique_ID>
        <untitled-ontology-107:Synonym>Pituitary gland, anterior</untitled-ontology-107:Synonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Pituitary_Gland</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_thalamic_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_thalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Thalamic_nuclei"/>
        <untitled-ontology-107:Definition>Three nuclei located beneath the dorsal surface of the most rostral part of the thalamus. The group includes the anterodorsal nucleus, anteromedial nucleus, and anteroventral nucleus. All receive connections from the MAMILLARY BODY and BRAIN FORNIX, and project fibers to the CINGULATE BODY.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D020643</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anterior_Thalamic_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-Anxiety_Agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-Anxiety_Agent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
        <untitled-ontology-107:Definition>Agents that alleviate ANXIETY, tension, and ANXIETY DISORDERS, promote sedation, and have a calming effect without affecting clarity of consciousness or neurologic conditions. ADRENERGIC BETA-ANTAGONISTS are commonly used in the symptomatic treatment of anxiety but are not included here.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D014151</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-anxiety_Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-aggregation_drug -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-aggregation_drug">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-aggregation_Drug</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-amyloid_drug -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-amyloid_drug">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-amyloid_Drug</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-inflammatory_agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-inflammatory_agent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
        <untitled-ontology-107:Definition>Substances that reduce or suppress INFLAMMATION.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000893</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-inflammatory_Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-tau_drug -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-tau_drug">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_classified_by_mechanism"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-tau_Drug</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anticonvulsant -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anticonvulsant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
        <untitled-ontology-107:Definition>Drugs used to prevent SEIZURES or reduce their severity.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000927</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anticonvulsant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antidepressive_agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antidepressive_agent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
        <untitled-ontology-107:Definition>Mood-stimulating drugs used primarily in the treatment of affective disorders and related conditions. Several MONOAMINE OXIDASE INHIBITORS are useful as antidepressants apparently as a long-term consequence of their modulation of catecholamine levels. The tricyclic compounds useful as antidepressive agents (ANTIDEPRESSIVE AGENTS, TRICYCLIC) also appear to act through brain catecholamine systems. A third group (ANTIDEPRESSIVE AGENTS, SECOND-GENERATION) is a diverse group of drugs including some that act specifically on serotonergic systems.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D000928</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antidepressive_Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antioxidant_activity -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antioxidant_activity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Molecular_function"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antioxidant_Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antipsychotic_agent -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antipsychotic_agent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Psychotropic_drug"/>
        <untitled-ontology-107:Definition>Agents that control agitated psychotic behavior, alleviate acute psychotic states, reduce psychotic symptoms, and exert a quieting effect. They are used in SCHIZOPHRENIA; senile dementia; transient psychosis following surgery; or MYOCARDIAL INFARCTION; etc. These drugs are often referred to as neuroleptics alluding to the tendency to produce neurological side effects, but not all antipsychotics are likely to produce such effects. Many of these drugs may also be effective against nausea, emesis, and pruritus.

From MeSH</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D014150</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antipsychotic_Agent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anxiety -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anxiety">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anxiety</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apathy -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apathy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Mood_symptom"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apathy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_C1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_C1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_C1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_D -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_D">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_D</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_E -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apolipoprotein_E">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apolipoprotein_E</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apoptosis_inducing_factor_mitochondria_associated_1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Apoptosis_inducing_factor_mitochondria_associated_1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apoptosis_Inducing_Factor_Mitochondria_Associated_1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arachnoid -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arachnoid">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Meninge"/>
        <untitled-ontology-107:Definition>A delicate membrane enveloping the brain and spinal cord. It lies between the PIA MATER and the DURA MATER. It is separated from the pia mater by the subarachnoid cavity which is filled with CEREBROSPINAL FLUID.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001099</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arachnoid</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arcuate_nucleus_of_hypothalamus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Arcuate_nucleus_of_hypothalamus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Middle_hypothalamus"/>
        <untitled-ontology-107:Definition>A nucleus located in the middle hypothalamus in the most ventral part of the THIRD VENTRICLE near the entrance of the infundibular recess. Its small cells are in close contact with the EPENDYMA.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001111</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arcuate_Nucleus_of_Hypothalamus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Area_postrema -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Area_postrema">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata"/>
        <untitled-ontology-107:Definition>A small, rounded eminence on each side of the FOURTH VENTRICLE, which receives nerve fibers from the SOLITARY NUCLEUS; SPINAL CORD; and adjacent areas of the MEDULLA OBLONGATA. The area postrema lies outside the BLOOD-BRAIN BARRIER and its functions include acting as an emetic chemoreceptor.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D031608</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Area_Postrema</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aripiprazole -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aripiprazole">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Antipsychotic_agent"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aripiprazole</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Asymptomatic_at_risk -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Asymptomatic_at_risk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Preclinical_AD"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Presymptomatic_AD"/>
        <untitled-ontology-107:Definition>International Working Group (IWG) criteria: individuals with autosomal dominant gene mutations which almost certainly will develop the disease</untitled-ontology-107:Definition>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Asymptomatic_at_Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Auditory_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Auditory_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Temporal_lobe"/>
        <untitled-ontology-107:Definition>The region of the cerebral cortex that receives the auditory radiation from the MEDIAL GENICULATE BODY.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D001303</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Auditory_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autoimmune_Diseases_of_the_Nervous_System -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autoimmune_Diseases_of_the_Nervous_System">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autoimmune_Diseases_of_the_Nervous_System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autonomic_Nervous_System_Diseases -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autonomic_Nervous_System_Diseases">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Nervous_System_Diseases"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autonomic_Nervous_System_Diseases</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autosomal_dominant_AD -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Autosomal_dominant_AD">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#AD_Subtype"/>
        <untitled-ontology-107:Description>Caused by amyloid-related mutations (PSEN1, PSEN2, APP) ; less than 1% AD cases</untitled-ontology-107:Description>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autosomal_Dominant_AD</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_clearance -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_clearance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_metabolism"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aβ_Clearance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_cleavage -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_cleavage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_metabolism"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aβ_Cleavage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_metabolism -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Aβ_metabolism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Pathway"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aβ_Metabolism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#BACE1 -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#BACE1">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Gene"/>
