        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wednesday</rdfs:label>
        <skos:definition>The thrid day of a calendar week starting from Monday.  Wednesday is after Tuesday and before Thursday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000046 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000046">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thursday</rdfs:label>
        <skos:definition>The fourth day of a calendar week starting from Monday. Thursday is after Wednesday and before Friday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000047 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000047">
        <rdfs:subClassOf rdf:resource="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000084"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Friday</rdfs:label>
        <skos:definition>The fifth day of a calendar week starting from Monday. Friday is after Thursday and before Saturday.</skos:definition>
    </owl:Class>
    


    <!-- https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000048 -->

    <owl:Class rdf:about="https://sbmi.uth.edu/ontology/TEO.owl#TEO_0000048">
