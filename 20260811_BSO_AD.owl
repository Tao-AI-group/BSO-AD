        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010416</IRI>
        <Literal>The rostral part of the amygdala with cortical-like layered structure. It receives major inputs from the OLFACTORY BULB and PIRIFORM CORTEX.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010416</IRI>
