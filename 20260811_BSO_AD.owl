        <Literal>Social Behavior</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#07020985</IRI>
        <Literal>Social_Justice</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="x_1.1:source"/>
            <Literal>UMLS</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="core:definition"/>
        <IRI>#07020985</IRI>
        <Literal>An interactive process whereby members of a community are concerned for the equality and rights of all. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0037422</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
