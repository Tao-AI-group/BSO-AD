        <AnnotationProperty abbreviatedIRI="core:exactMatch"/>
        <IRI>http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#04010286</IRI>
        <Literal>Cerebral aqueduct</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
