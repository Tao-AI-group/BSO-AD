    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactomedin_3">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactomedin_3</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_bulb -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_bulb">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Telencephalon"/>
        <untitled-ontology-107:Definition>Ovoid body resting on the CRIBRIFORM PLATE of the ethmoid bone where the OLFACTORY NERVE terminates. The olfactory bulb contains several types of nerve cells including the mitral cells, on whose DENDRITES the olfactory nerve synapses, forming the olfactory glomeruli. The accessory olfactory bulb, which receives the projection from the VOMERONASAL ORGAN via the vomeronasal nerve, is also included here.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D009830</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactory_Bulb</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebral_Cortex"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Cerebrum"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Sensorimotor_cortex"/>
        <untitled-ontology-107:Definition>Basal forebrain and medial part of temporal lobe areas that receive synaptic inputs from the OLFACTORY BULB.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066194</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactory_Cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_pathway -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_pathway">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Limbic_system"/>
        <untitled-ontology-107:Definition>Set of nerve fibers conducting impulses from olfactory receptors to the cerebral cortex. It includes the OLFACTORY NERVE; OLFACTORY BULB; OLFACTORY TRACT; OLFACTORY TUBERCLE; ANTERIOR PERFORATED SUBSTANCE; and OLFACTORY CORTEX.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D009833</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactory_Pathway</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_tubercle -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_tubercle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olfactory_cortex"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Ventral_striatum"/>
        <untitled-ontology-107:Definition>Region in the ventral TELENCEPHALON located anterior to the OPTIC CHIASM, posterior to the OLFACTORY PEDUNCLE, rostral to the PIRIFORM AREA and ventral to the NUCLEUS ACCUMBENS.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066208</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olfactory_Tubercle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Oligodendrocytic_myelin_paranodal_and_inner_loop_protein -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Oligodendrocytic_myelin_paranodal_and_inner_loop_protein">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Drug_target"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oligodendrocytic_Myelin_Paranodal_and_Inner_Loop_Protein</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olivary_nucleus -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Olivary_nucleus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Medulla_oblongata"/>
        <untitled-ontology-107:Definition>A part of the MEDULLA OBLONGATA situated in the olivary body. It is involved with motor control and is a major source of sensory input to the CEREBELLUM.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D009847</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Olivary_Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Optic_chiasm -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Optic_chiasm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
        <untitled-ontology-107:Definition>The X-shaped structure formed by the meeting of the two optic nerves. At the optic chiasm the fibers from the medial part of each retina cross to project to the other side of the brain while the lateral retinal fibers continue on the same side. As a result each half of the brain receives information about the contralateral visual field from both eyes.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D009897</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optic_Chiasm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Optic_tract -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Optic_tract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Diencephalon"/>
        <untitled-ontology-107:Definition>Nerve fiber originating from the OPTIC CHIASM that connects predominantly to the LATERAL GENICULATE BODIES. It is the continuation of the VISUAL PATHWAY that conveys the visual information originally from the RETINA to the optic chiasm via the OPTIC NERVES.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D065866</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Optic_Tract</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Organic_substance_metabolic_process -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Organic_substance_metabolic_process">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Metabolic_process"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organic_Substance_Metabolic_Process</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Organum_vasculosum -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Organum_vasculosum">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anterior_hypothalamus"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Basal_forebrain"/>
        <untitled-ontology-107:Definition>Circumventricular cellular structure in the anterior hypothalamic region. It is located in the optic recess at the anteroventral end of the THIRD VENTRICLE and forms the ventral part of the midline anterior wall.</untitled-ontology-107:Definition>
        <untitled-ontology-107:MeSH_Unique_ID>D066278</untitled-ontology-107:MeSH_Unique_ID>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organum_Vasculosum</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Oxazepam -->

    <owl:Class rdf:about="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Oxazepam">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/fangli/ontologies/2019/2/untitled-ontology-107#Anti-Anxiety_Agent"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oxazepam</rdfs:label>
    </owl:Class>
    


