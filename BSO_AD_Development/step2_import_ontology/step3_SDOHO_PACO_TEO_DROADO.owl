        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struggle or disagreement between parents, parent and child or other members of a family. (MSH)
 https://uts.nlm.nih.gov/uts/umls/concept/C0233542</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0233542</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finding</UMLS_Semantic_Type>
    </owl:Class>
    


    <!-- https://github.com/Tao-AI-group/BSO_AD#00378 -->

    <owl:Class rdf:about="https://github.com/Tao-AI-group/BSO_AD#00378">
        <rdfs:subClassOf rdf:resource="https://github.com/Tao-AI-group/BSO_AD#00376"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Violence</rdfs:label>
        <skos:definition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An act of aggression between individuals. (NCI)
 The exertion of excessive force or power to cause injury or abuse (NANDA-I)
 Rough or injurious physical force, action, or treatment. (CSP)
 https://uts.nlm.nih.gov/uts/umls/concept/C0042693</skos:definition>
        <UMLS_CUI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0042693</UMLS_CUI>
        <UMLS_Semantic_Type rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mental or Behavioral Dysfunction</UMLS_Semantic_Type>
    </owl:Class>
    


